---
import RootLayout from '../../layouts/RootLayout.astro';
import Navbar from '../global/Navbar.astro';
import Footer from '../global/Footer.astro';
import { getBranch } from '../../data/navigation';
import type { BranchConfig } from '../../types/navigation';

/**
 * L'informativa privacy, scritta UNA volta sola.
 *
 * Dal 01/09/2026 (FIL-294) ogni divisione ha la sua legale, perché chi legge
 * non deve uscire dalla divisione in cui si trova. La società però è una sola,
 * quindi il testo è lo stesso: sta qui, e le sei rotte che lo servono
 * (/privacy-policy/ più le cinque per divisione) sono involucri di 7 e 25
 * righe. Il giorno che l'avvocato cambia una frase, si cambia in un punto.
 *
 * Queste pagine montano RootLayout a mano invece di BranchLayout — come già
 * facevano le due legali di gruppo — per due motivi: servono `noindex` (vedi
 * sotto) e non vogliono la barra di sezione, che su un testo legale lungo
 * aggiungerebbe navigazione dove serve solo lettura.
 */
/*
 * Perché il testo NON si differenzia per divisione, benché nomini WTC Team.
 *
 * Ai punti 2 e 3 l'informativa nomina il modulo eventi di WTC Team, e servita
 * sotto /pitter-italy/ o /wtc-food/ sembra parlare d'altro. Resta identica lo
 * stesso: l'informativa è del TITOLARE, non della pagina che la linka. Il
 * titolare è uno solo (WTC SERVICES S.r.l.s., punto 1) e l'art. 13 GDPR gli
 * chiede di dichiarare TUTTE le categorie di dati e TUTTE le finalità che
 * tratta, modulo eventi compreso. Condizionare i paragrafi per divisione
 * produrrebbe cinque testi legali da tenere allineati e quattro informative
 * INCOMPLETE: un rischio, non una pulizia.
 *
 * Il giorno della separazione societaria ognuna avrà titolare e testo propri,
 * e allora questo componente si sdoppia — insieme al noindex qui sotto.
 */
export interface Props {
  /** Divisione sotto cui la pagina è servita. Assente = la legale di gruppo. */
  branchId?: BranchConfig['id'];
}

const { branchId } = Astro.props;
const branch = branchId ? getBranch(branchId) : undefined;

// I rimandi interni restano dentro la divisione: da /team/privacy-policy/ si va
// alla cookie policy di Team, non a quella di gruppo.
const base = branch ? branch.rootHref : '/';

// Decisione SEO. Le cinque copie per divisione sono lo stesso identico testo
// della versione di gruppo: esistono per coerenza di navigazione, non per
// essere trovate su Google. Offrirle all'indice significherebbe dare al motore
// sei URL con lo stesso contenuto e lasciargli scegliere quale mostrare.
// Quindi: le cinque dichiarano noindex (e RootLayout, di conseguenza, non
// emette il canonical — un canonical su una pagina noindex è muto) e restano
// fuori dalla sitemap; la versione di gruppo /privacy-policy/ resta l'unica
// indicizzabile e canonica. L'alternativa era un canonical dalle cinque verso
// la versione di gruppo: dice la stessa cosa ma è un suggerimento invece di
// un'istruzione, e avrebbe richiesto una proprietà nuova su RootLayout.
// Quando le divisioni si separeranno in società diverse, ognuna avrà il proprio
// titolare e il proprio testo: quel giorno si toglie questo flag.
const noindex = !!branch;

// Set di favicon della divisione (public/favicons/<id>/); WTC Services è la
// divisione di gruppo e usa quello alla radice. Ricavato dalla regola e non
// copiato dalla mappa di BranchLayout, che queste pagine non possono usare.
const faviconDir = branch && branch.id !== 'services' ? `/favicons/${branch.id}/` : '';

const lastUpdated = '15 marzo 2026';
---

<RootLayout
  motion={false}
  title={branch ? `Privacy Policy — ${branch.name}` : 'Privacy Policy — WTC'}
  description="Informativa sul trattamento dei dati personali ai sensi del Regolamento (UE) 2016/679 (GDPR)."
  {noindex}
  {faviconDir}
>
  <Navbar activeBranch={branchId} />

  <main id="main-content" class="pt-navbar">
    <div class="section-py section-px max-w-[800px] mx-auto">

      <!-- Header -->
      <div class="mb-12">
        <p class="font-inter text-xs text-wtc-orange tracking-widest uppercase mb-4">Legale</p>
        <h1 class="font-clash font-semibold text-display-md text-white mb-4">Privacy Policy</h1>
        <p class="font-inter text-sm text-text-muted">
          Informativa ai sensi dell'art. 13 del Regolamento (UE) 2016/679 (GDPR).<br />
          Ultimo aggiornamento: {lastUpdated}
        </p>
      </div>

      <!-- Content -->
      <div class="prose-legal">

        <h2>1. Titolare del trattamento</h2>
        <p>
          Il titolare del trattamento dei dati personali è:<br />
          <strong>WTC SERVICES S.r.l.s.</strong><br />
          Via Leone XIII, 464 — 00165 Roma (RM)<br />
          P.IVA 14561821001<br />
          Email: <a href="mailto:wtc@wtcservices.it">wtc@wtcservices.it</a>
        </p>

        <h2>2. Tipologie di dati raccolti</h2>
        <p>Il sito può raccogliere le seguenti categorie di dati personali:</p>
        <ul>
          <li><strong>Dati di contatto</strong>: nome, cognome, indirizzo email, numero di telefono, nome dell'azienda, forniti volontariamente attraverso i moduli presenti sul sito (es. modulo di partecipazione WTC Team).</li>
          <li><strong>Dati aggiuntivi nel modulo WTC Team</strong>: città e provincia di nascita, data di nascita, preferenze sportive, consensi espliciti.</li>
          <li><strong>Dati di navigazione</strong>: informazioni tecniche raccolte automaticamente dai server durante la navigazione (indirizzo IP, tipo di browser, sistema operativo, pagine visitate, orario di accesso). Questi dati non sono associati a identità specifiche e vengono utilizzati esclusivamente per scopi tecnici e statistici aggregati.</li>
        </ul>

        <h2>3. Finalità e base giuridica del trattamento</h2>
        <p>I dati personali sono trattati per le seguenti finalità:</p>
        <ul>
          <li><strong>Gestione delle richieste di contatto</strong> (base giuridica: esecuzione di misure precontrattuali su richiesta dell'interessato, art. 6 par. 1 lett. b GDPR).</li>
          <li><strong>Gestione delle iscrizioni agli eventi WTC Team</strong> (base giuridica: consenso dell'interessato, art. 6 par. 1 lett. a GDPR).</li>
          <li><strong>Invio di comunicazioni commerciali e promozionali</strong> relative alle attività del Gruppo WTC (base giuridica: consenso dell'interessato, art. 6 par. 1 lett. a GDPR). Il consenso può essere revocato in qualsiasi momento.</li>
          <li><strong>Adempimento di obblighi legali</strong> (base giuridica: art. 6 par. 1 lett. c GDPR).</li>
          <li><strong>Legittimo interesse</strong> del Titolare per la sicurezza del sistema informatico e per la prevenzione di abusi (art. 6 par. 1 lett. f GDPR).</li>
        </ul>

        <h2>4. Modalità del trattamento</h2>
        <p>
          Il trattamento avviene mediante strumenti informatici e telematici, con logiche strettamente correlate alle finalità indicate. I dati sono conservati su server protetti e trattati esclusivamente da personale autorizzato o da eventuali responsabili del trattamento nominati ai sensi dell'art. 28 GDPR. Non viene effettuato alcun trattamento automatizzato che produca effetti significativi sugli interessati.
        </p>

        <h2>5. Periodo di conservazione</h2>
        <ul>
          <li><strong>Dati forniti tramite moduli di contatto o iscrizione</strong>: conservati per un massimo di 24 mesi dalla raccolta, salvo necessità di conservazione più lunga per obblighi legali.</li>
          <li><strong>Dati di navigazione tecnici</strong>: conservati per la durata della sessione e, ove aggregati per scopi statistici, per un periodo non superiore a 12 mesi.</li>
        </ul>

        <h2>6. Comunicazione e diffusione dei dati</h2>
        <p>
          I dati personali non sono diffusi a terzi per finalità di marketing. Possono essere comunicati a:
        </p>
        <ul>
          <li>Fornitori di servizi tecnici (hosting, piattaforme di invio email) nominati responsabili del trattamento, che trattano i dati esclusivamente per conto del Titolare.</li>
          <li>Autorità competenti, qualora richiesto da obblighi di legge.</li>
        </ul>

        <h2>7. Trasferimento dei dati extra-UE</h2>
        <p>
          I dati personali sono trattati all'interno dell'Unione Europea. Nel caso in cui eventuali fornitori tecnici operino al di fuori dello Spazio Economico Europeo, il trasferimento avviene nel rispetto delle garanzie previste dagli artt. 44–49 GDPR (es. clausole contrattuali standard approvate dalla Commissione europea).
        </p>

        <h2>8. Diritti dell'interessato</h2>
        <p>Ai sensi degli artt. 15–22 GDPR, l'interessato ha il diritto di:</p>
        <ul>
          <li><strong>Accesso</strong>: ottenere conferma che sia o meno in corso un trattamento di dati personali che lo riguardano e, in tal caso, ottenere copia dei dati.</li>
          <li><strong>Rettifica</strong>: ottenere la correzione di dati inesatti o l'integrazione di dati incompleti.</li>
          <li><strong>Cancellazione</strong> ("diritto all'oblio"): ottenere la cancellazione dei dati personali nei casi previsti dall'art. 17 GDPR.</li>
          <li><strong>Limitazione del trattamento</strong>: ottenere la limitazione del trattamento nei casi previsti dall'art. 18 GDPR.</li>
          <li><strong>Portabilità</strong>: ricevere i dati forniti in un formato strutturato, di uso comune e leggibile da dispositivo automatico.</li>
          <li><strong>Opposizione</strong>: opporsi al trattamento per motivi legati alla situazione particolare dell'interessato, o al trattamento per finalità di marketing diretto.</li>
          <li><strong>Revoca del consenso</strong>: revocare in qualsiasi momento il consenso prestato, senza pregiudicare la liceità del trattamento basato sul consenso prima della revoca.</li>
        </ul>
        <p>
          Per esercitare i propri diritti, l'interessato può contattare il Titolare all'indirizzo: <a href="mailto:wtc@wtcservices.it">wtc@wtcservices.it</a>. Il Titolare risponderà entro 30 giorni dalla ricezione della richiesta. L'interessato ha inoltre il diritto di proporre reclamo all'autorità di controllo competente (in Italia: <strong>Garante per la protezione dei dati personali</strong>, <a href="https://www.garanteprivacy.it" target="_blank" rel="noopener noreferrer">www.garanteprivacy.it</a>).
        </p>

        <h2>9. Cookie</h2>
        <p>
          Per informazioni sull'utilizzo dei cookie e delle tecnologie di tracciamento sul presente sito, si rinvia alla <a href={`${base}cookie-policy/`}>Cookie Policy</a>.
        </p>

        <h2>10. Modifiche alla presente informativa</h2>
        <p>
          Il Titolare si riserva il diritto di apportare modifiche alla presente informativa in qualsiasi momento. Le modifiche saranno pubblicate su questa pagina con aggiornamento della data di revisione. Si invita a consultare periodicamente questa pagina.
        </p>

      </div>
    </div>
  </main>

  <Footer activeBranch={branchId} />
</RootLayout>

<style>
  .prose-legal {
    @apply font-inter text-base text-ice-grey/80 leading-relaxed;
  }
  .prose-legal h2 {
    @apply font-clash font-semibold text-xl text-white mt-10 mb-4;
  }
  .prose-legal p {
    @apply mb-4 leading-relaxed;
  }
  .prose-legal ul {
    @apply list-disc list-outside pl-5 mb-4 flex flex-col gap-2;
  }
  .prose-legal li {
    @apply leading-relaxed;
  }
  .prose-legal strong {
    @apply text-white font-medium;
  }
  .prose-legal a {
    @apply text-wtc-orange hover:text-wtc-neon underline underline-offset-2 transition-colors duration-200;
  }
</style>
