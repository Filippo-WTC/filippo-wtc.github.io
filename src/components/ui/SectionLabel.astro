---
export interface Props {
  number?: string;
  label: string;
  class?: string;
}

const { number, label, class: className } = Astro.props;
---

<div class:list={['flex items-center gap-3', className]}>
  {number && (
    <span class="font-clash text-xs font-semibold text-wtc-orange/70 tracking-widest">{number}</span>
  )}
  {number && <span class="w-6 h-[1px] bg-wtc-orange/40"></span>}
  <span class="font-inter text-xs font-medium tracking-[0.2em] uppercase text-text-muted">
    {label}
  </span>
</div>
