---
export interface Props {
  number?: string;
  label: string;
  class?: string;
}

const { number, label, class: className } = Astro.props;
---

<!-- Orange budget: exactly ONE orange mark (the number). The connector
     rule is neutral so the label reads as structure, not as accent. -->
<div class:list={['flex items-center gap-3', className]}>
  {number && (
    <span class="font-clash text-xs font-semibold text-wtc-orange tracking-widest tabular-nums">{number}</span>
  )}
  {number && <span class="w-6 h-[1px] bg-hairline-strong"></span>}
  <span class="font-inter text-xs font-medium tracking-[0.2em] uppercase text-text-muted">
    {label}
  </span>
</div>
