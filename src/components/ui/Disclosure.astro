---
// Disclosure — Apple-style inline progressive disclosure: a confident
// one-liner stays visible, the depth expands in place on demand.
// No modals (brand anti-reference), no JS height math: the reveal is a
// CSS grid-template-rows 0fr→1fr transition; JS only flips aria-expanded.
// Transparent by design so it composes inside existing cards.
export interface Props {
  /** The always-visible summary line (plain text; use slot "summary" for rich content) */
  summary?: string;
  class?: string;
  /**
   * How far the clickable area reaches past the button. The visible row is
   * short, but the block a user aims at is the whole card header — so the
   * hit area is stretched over the parent's padding instead of leaving it
   * dead. No layout shift: the stretch is a positioned pseudo-element.
   *  - "card": the Disclosure is the card's only content (p-8 cards)
   *  - "row":  it sits under a rule inside a taller card
   *  - "none": exactly the button box
   */
  hit?: "card" | "row" | "none";
}

const { summary, class: className, hit = "row" } = Astro.props;
const id = `disc-${Math.random().toString(36).slice(2, 9)}`;
const btnId = `${id}-btn`;

// Matches the p-8 (2rem) cards both call sites use. The bottom reach stays
// small — and collapses to 0 while open — so it never swallows clicks or
// text selection in the revealed panel.
const HIT = {
  card: "--disc-hit-x:2rem; --disc-hit-top:2rem; --disc-hit-bottom:0.75rem;",
  row: "--disc-hit-x:2rem; --disc-hit-top:1rem; --disc-hit-bottom:0.5rem;",
  none: "",
} as const;
---

<div class:list={["disclosure", className]} data-disclosure style={HIT[hit]}>
  <button
    id={btnId}
    type="button"
    class="disclosure-toggle relative w-full flex items-center justify-between gap-4 text-left min-h-[44px] py-2 group/disc"
    aria-expanded="false"
    aria-controls={id}
  >
    <span class="relative z-[1] font-inter text-sm text-wtc-orange group-hover/disc:text-wtc-neon transition-colors duration-200">
      {summary ?? <slot name="summary" />}
    </span>
    <span class="disclosure-icon relative z-[1] w-4 h-4 shrink-0" aria-hidden="true">
      <span class="absolute left-0 top-1/2 w-4 h-[1.5px] -translate-y-1/2 bg-hairline-strong transition-colors duration-300"></span>
      <span class="disclosure-bar-v absolute left-1/2 top-0 w-[1.5px] h-4 -translate-x-1/2 bg-hairline-strong transition-[transform,background-color] duration-300"></span>
    </span>
  </button>

  <div id={id} class="disclosure-panel" role="region" aria-labelledby={btnId} inert>
    <div class="disclosure-inner">
      <slot />
    </div>
  </div>
</div>

<style>
  .disclosure-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .disclosure-inner {
    overflow: hidden;
    min-height: 0;
  }

  .disclosure[data-open] .disclosure-panel {
    grid-template-rows: 1fr;
  }

  /* Stretched hit area — the whole header block, not just the icon. Purely
     a pointer target: no layout impact, and it sits UNDER the label and the
     icon (z-index 1 on those) so nothing visual changes. */
  .disclosure-toggle::before {
    content: "";
    position: absolute;
    top: calc(-1 * var(--disc-hit-top, 0px));
    right: calc(-1 * var(--disc-hit-x, 0px));
    bottom: calc(-1 * var(--disc-hit-bottom, 0px));
    left: calc(-1 * var(--disc-hit-x, 0px));
    border-radius: 12px;
    background-color: transparent;
    transition: background-color 0.25s ease;
  }

  /* The affordance now matches the target: hovering anywhere in the block
     lights the block, not just the "+". Near-threshold, like every other
     surface on the site. */
  .disclosure-toggle:hover::before {
    background-color: rgb(255 255 255 / 0.022);
  }

  /* Open: stop at the button's own edge so the revealed panel keeps its
     clicks and its text selection. */
  .disclosure[data-open] .disclosure-toggle::before {
    bottom: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .disclosure-panel,
    .disclosure-toggle::before {
      transition: none;
    }
  }
</style>

<script>
  // One delegated listener for every Disclosure on the site. The guard is on
  // `window`, not a module local: a module-scoped `let` is re-initialised on
  // every module evaluation, so it could never prevent a second listener.
  declare global {
    interface Window { __wtcDisclosureBound?: boolean }
  }

  if (!window.__wtcDisclosureBound) {
    window.__wtcDisclosureBound = true;
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>(".disclosure-toggle");
      if (!btn) return;
      const root = btn.closest<HTMLElement>("[data-disclosure]");
      if (!root) return;
      const open = root.hasAttribute("data-open");
      root.toggleAttribute("data-open", !open);
      btn.setAttribute("aria-expanded", String(!open));
      // Keep the panel out of the screen-reader tree while collapsed: the
      // grid-rows:0fr collapse hides it visually but not from AT.
      const panel = root.querySelector<HTMLElement>(".disclosure-panel");
      if (panel) panel.toggleAttribute("inert", open);
    });
  }
</script>
