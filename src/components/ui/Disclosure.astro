---
// Disclosure — Apple-style inline progressive disclosure: a confident
// one-liner stays visible, the depth expands in place on demand.
// No modals (brand anti-reference), no JS height math: the reveal is a
// CSS grid-template-rows 0fr→1fr transition; JS only flips aria-expanded.
// Transparent by design so it composes inside existing cards.
export interface Props {
  /** The always-visible summary line (plain text; use slot "summary" for rich content) */
  summary?: string;
  class?: string;
}

const { summary, class: className } = Astro.props;
const id = `disc-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={["disclosure", className]} data-disclosure>
  <button
    type="button"
    class="disclosure-toggle w-full flex items-center justify-between gap-4 text-left py-1 group/disc"
    aria-expanded="false"
    aria-controls={id}
  >
    <span class="font-inter text-sm text-wtc-orange group-hover/disc:text-wtc-neon transition-colors duration-200">
      {summary ?? <slot name="summary" />}
    </span>
    <span class="disclosure-icon relative w-4 h-4 shrink-0" aria-hidden="true">
      <span class="absolute left-0 top-1/2 w-4 h-[1.5px] -translate-y-1/2 bg-hairline-strong transition-colors duration-300"></span>
      <span class="disclosure-bar-v absolute left-1/2 top-0 w-[1.5px] h-4 -translate-x-1/2 bg-hairline-strong transition-[transform,background-color] duration-300"></span>
    </span>
  </button>

  <div id={id} class="disclosure-panel" role="region">
    <div class="disclosure-inner">
      <slot />
    </div>
  </div>
</div>

<style>
  .disclosure-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.4s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  .disclosure-inner {
    overflow: hidden;
    min-height: 0;
  }

  .disclosure[data-open] .disclosure-panel {
    grid-template-rows: 1fr;
  }

  /* + → × : the vertical bar rotates onto the horizontal one; both warm
     to orange while open (the one accent of the unit). */
  .disclosure[data-open] .disclosure-bar-v {
    transform: translateX(-50%) rotate(90deg);
  }

  .disclosure[data-open] .disclosure-icon span {
    background-color: rgb(242 101 34 / 0.8);
  }
</style>

<script>
  // One delegated listener for every Disclosure on the site, registered
  // once at module scope (document survives view transitions — same
  // pattern as Navbar's Escape handler).
  let bound = false;

  if (!bound) {
    bound = true;
    document.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>(".disclosure-toggle");
      if (!btn) return;
      const root = btn.closest<HTMLElement>("[data-disclosure]");
      if (!root) return;
      const open = root.hasAttribute("data-open");
      root.toggleAttribute("data-open", !open);
      btn.setAttribute("aria-expanded", String(!open));
    });
  }
</script>
