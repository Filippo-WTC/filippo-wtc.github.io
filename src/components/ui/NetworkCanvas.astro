---
// NetworkCanvas — floating nodes connected by proximity lines
// Re-initializes on every Astro page-load (View Transitions safe)
// Skipped entirely if prefers-reduced-motion
---

<canvas
  id="network-canvas"
  class="absolute inset-0 w-full h-full pointer-events-none z-0"
  aria-hidden="true"
></canvas>

<script>
  document.addEventListener("astro:page-load", () => {
    const canvas = document.getElementById("network-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;

    // Skip animation for users who prefer reduced motion
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    // ── Colours ───────────────────────────────────────────────────
    const NODE_PRIMARY = "rgba(242,101,34,0.50)";
    const NODE_SECONDARY = "rgba(255,255,255,0.18)";
    const LINE = "rgba(255,255,255,0.05)";

    // ── Resize (DPR-aware backing store, drawing math in CSS px) ──
    let w = 0;
    let h = 0;

    function resize() {
      const parent = canvas!.parentElement;
      if (!parent) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = parent.offsetWidth;
      h = parent.offsetHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      canvas!.style.width = `${w}px`;
      canvas!.style.height = `${h}px`;
      // setTransform (not cumulative scale) so repeated resizes never compound
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    resize();

    // ── Ambient pointer (desktop only) ────────────────────────────
    // The canvas keeps pointer-events:none — we listen on window with
    // a passive pointermove and map into canvas space via a cached
    // page-relative origin. Page-relative coords survive scrolling, so
    // the cache only needs refreshing when layout changes (handled by
    // the existing ResizeObserver / IntersectionObserver callbacks).
    // The handler only writes numbers: it can never wake a paused loop.
    const POINTER_RADIUS = 140; // px influence radius
    const POINTER_PUSH = 10;    // max node displacement, px
    const usePointer = !window.matchMedia("(pointer: coarse)").matches;
    let pageLeft = 0;
    let pageTop = 0;
    let ptx = 0, pty = 0;       // raw pointer target (CSS px, canvas-local)
    let px = -1e4, py = -1e4;   // lerped pointer (starts far offscreen)
    let pStrengthT = 0;         // 1 while the pointer is over the canvas
    let pStrength = 0;          // lerped influence, fades in/out

    function refreshRect() {
      if (!usePointer) return;
      const r = canvas!.getBoundingClientRect();
      pageLeft = r.left + window.scrollX;
      pageTop = r.top + window.scrollY;
    }
    refreshRect();

    const onPointerMove = (e: PointerEvent) => {
      const x = e.clientX + window.scrollX - pageLeft;
      const y = e.clientY + window.scrollY - pageTop;
      const inside = x >= 0 && x <= w && y >= 0 && y <= h;
      pStrengthT = inside ? 1 : 0;
      if (inside) { ptx = x; pty = y; }
    };
    if (usePointer) window.addEventListener("pointermove", onPointerMove, { passive: true });

    // ── Nodes ─────────────────────────────────────────────────────
    const NODE_COUNT = 55;
    const MAX_DIST = 120;

    interface Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      primary: boolean;
      ox: number; // pointer-repulsion offset, springs back to 0
      oy: number;
    }

    function makeNodes(): Node[] {
      const nodes: Node[] = [];
      for (let i = 0; i < NODE_COUNT; i++) {
        nodes.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          r: 1.5 + Math.random() * 1.5,
          primary: Math.random() > 0.65,
          ox: 0,
          oy: 0,
        });
      }
      return nodes;
    }

    let nodes = makeNodes();

    // Single ResizeObserver: resize + node rebuild so nodes stay in
    // bounds, debounced to at most once per frame.
    let resizeRaf = 0;
    const ro = new ResizeObserver(() => {
      if (resizeRaf) return;
      resizeRaf = requestAnimationFrame(() => {
        resizeRaf = 0;
        resize();
        refreshRect();
        nodes = makeNodes();
      });
    });
    ro.observe(canvas.parentElement as Element);

    // ── Animation loop — paused offscreen or when the tab is hidden
    let raf = 0;
    let running = false;
    let inView = true;
    let pageVisible = document.visibilityState === "visible";

    function tick() {
      ctx!.clearRect(0, 0, w, h);

      // Lerped pointer — slow and floaty. Piggybacks on this tick, so a
      // paused canvas never advances it.
      if (usePointer) {
        if (px < -9e3) { px = ptx; py = pty; } // first sample: snap, no fly-in
        px += (ptx - px) * 0.06;
        py += (pty - py) * 0.06;
        pStrength += (pStrengthT - pStrength) * 0.06;
      }

      // Move + bounce (+ soft pointer repulsion, springing back to 0)
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;

        let tox = 0, toy = 0;
        if (pStrength > 0.01) {
          const dx = n.x - px;
          const dy = n.y - py;
          const d = Math.hypot(dx, dy);
          if (d < POINTER_RADIUS && d > 0.001) {
            const f = (1 - d / POINTER_RADIUS) * POINTER_PUSH * pStrength;
            tox = (dx / d) * f;
            toy = (dy / d) * f;
          }
        }
        n.ox += (tox - n.ox) * 0.08;
        n.oy += (toy - n.oy) * 0.08;
      }

      // Connections
      for (let i = 0; i < nodes.length; i++) {
        const ax = nodes[i].x + nodes[i].ox;
        const ay = nodes[i].y + nodes[i].oy;
        for (let j = i + 1; j < nodes.length; j++) {
          const bx = nodes[j].x + nodes[j].ox;
          const by = nodes[j].y + nodes[j].oy;
          const dx = ax - bx;
          const dy = ay - by;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MAX_DIST) {
            const alpha = (1 - dist / MAX_DIST);
            // Lines whose midpoint sits near the pointer lift up to +40%
            let boost = 0;
            if (pStrength > 0.01) {
              const md = Math.hypot((ax + bx) / 2 - px, (ay + by) / 2 - py);
              if (md < POINTER_RADIUS) boost = (1 - md / POINTER_RADIUS) * 0.4 * pStrength;
            }
            ctx!.save();
            ctx!.globalAlpha = Math.min(1, alpha * 0.6 * (1 + boost));
            ctx!.strokeStyle = LINE;
            ctx!.lineWidth = 0.8;
            ctx!.beginPath();
            ctx!.moveTo(ax, ay);
            ctx!.lineTo(bx, by);
            ctx!.stroke();
            ctx!.restore();
          }
        }
      }

      // Nodes
      for (const n of nodes) {
        ctx!.beginPath();
        ctx!.arc(n.x + n.ox, n.y + n.oy, n.r, 0, Math.PI * 2);
        ctx!.fillStyle = n.primary ? NODE_PRIMARY : NODE_SECONDARY;
        ctx!.fill();
      }

      raf = requestAnimationFrame(tick);
    }

    function start() {
      if (running) return;
      running = true;
      raf = requestAnimationFrame(tick);
    }
    function stop() {
      if (!running) return;
      running = false;
      cancelAnimationFrame(raf);
    }
    function syncRunning() {
      if (inView && pageVisible) start();
      else stop();
    }

    const io = new IntersectionObserver((entries) => {
      inView = entries[0]?.isIntersecting ?? true;
      refreshRect();
      syncRunning();
    });
    io.observe(canvas.parentElement as Element);

    const onVisibility = () => {
      pageVisible = document.visibilityState === "visible";
      syncRunning();
    };
    document.addEventListener("visibilitychange", onVisibility);

    syncRunning();

    // Cleanup on Astro view transitions
    document.addEventListener("astro:before-swap", () => {
      stop();
      cancelAnimationFrame(resizeRaf);
      ro.disconnect();
      io.disconnect();
      window.removeEventListener("pointermove", onPointerMove);
      document.removeEventListener("visibilitychange", onVisibility);
    }, { once: true });
  });
</script>
