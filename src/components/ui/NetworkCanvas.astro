---
// NetworkCanvas — floating nodes connected by proximity lines
// Re-initializes on every Astro page-load (View Transitions safe)
// Skipped entirely if prefers-reduced-motion
---

<canvas
  id="network-canvas"
  class="absolute inset-0 w-full h-full pointer-events-none z-0"
  aria-hidden="true"
></canvas>

<script>
  document.addEventListener("astro:page-load", () => {
    const canvas = document.getElementById("network-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;

    // Skip animation for users who prefer reduced motion
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    // ── Colours ───────────────────────────────────────────────────
    const NODE_PRIMARY = "rgba(242,101,34,0.50)";
    const NODE_SECONDARY = "rgba(255,255,255,0.18)";
    const LINE = "rgba(255,255,255,0.05)";

    // ── Resize (DPR-aware backing store, drawing math in CSS px) ──
    let w = 0;
    let h = 0;

    function resize() {
      const parent = canvas!.parentElement;
      if (!parent) return;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = parent.offsetWidth;
      h = parent.offsetHeight;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      canvas!.style.width = `${w}px`;
      canvas!.style.height = `${h}px`;
      // setTransform (not cumulative scale) so repeated resizes never compound
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    resize();

    // ── Nodes ─────────────────────────────────────────────────────
    const NODE_COUNT = 55;
    const MAX_DIST = 120;

    interface Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      primary: boolean;
    }

    function makeNodes(): Node[] {
      const nodes: Node[] = [];
      for (let i = 0; i < NODE_COUNT; i++) {
        nodes.push({
          x: Math.random() * w,
          y: Math.random() * h,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          r: 1.5 + Math.random() * 1.5,
          primary: Math.random() > 0.65,
        });
      }
      return nodes;
    }

    let nodes = makeNodes();

    // Single ResizeObserver: resize + node rebuild so nodes stay in
    // bounds, debounced to at most once per frame.
    let resizeRaf = 0;
    const ro = new ResizeObserver(() => {
      if (resizeRaf) return;
      resizeRaf = requestAnimationFrame(() => {
        resizeRaf = 0;
        resize();
        nodes = makeNodes();
      });
    });
    ro.observe(canvas.parentElement as Element);

    // ── Animation loop — paused offscreen or when the tab is hidden
    let raf = 0;
    let running = false;
    let inView = true;
    let pageVisible = document.visibilityState === "visible";

    function tick() {
      ctx!.clearRect(0, 0, w, h);

      // Move + bounce
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;
      }

      // Connections
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MAX_DIST) {
            const alpha = (1 - dist / MAX_DIST);
            ctx!.save();
            ctx!.globalAlpha = alpha * 0.6;
            ctx!.strokeStyle = LINE;
            ctx!.lineWidth = 0.8;
            ctx!.beginPath();
            ctx!.moveTo(nodes[i].x, nodes[i].y);
            ctx!.lineTo(nodes[j].x, nodes[j].y);
            ctx!.stroke();
            ctx!.restore();
          }
        }
      }

      // Nodes
      for (const n of nodes) {
        ctx!.beginPath();
        ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx!.fillStyle = n.primary ? NODE_PRIMARY : NODE_SECONDARY;
        ctx!.fill();
      }

      raf = requestAnimationFrame(tick);
    }

    function start() {
      if (running) return;
      running = true;
      raf = requestAnimationFrame(tick);
    }
    function stop() {
      if (!running) return;
      running = false;
      cancelAnimationFrame(raf);
    }
    function syncRunning() {
      if (inView && pageVisible) start();
      else stop();
    }

    const io = new IntersectionObserver((entries) => {
      inView = entries[0]?.isIntersecting ?? true;
      syncRunning();
    });
    io.observe(canvas.parentElement as Element);

    const onVisibility = () => {
      pageVisible = document.visibilityState === "visible";
      syncRunning();
    };
    document.addEventListener("visibilitychange", onVisibility);

    syncRunning();

    // Cleanup on Astro view transitions
    document.addEventListener("astro:before-swap", () => {
      stop();
      cancelAnimationFrame(resizeRaf);
      ro.disconnect();
      io.disconnect();
      document.removeEventListener("visibilitychange", onVisibility);
    }, { once: true });
  });
</script>
