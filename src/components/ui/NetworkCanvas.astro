---
// NetworkCanvas — floating nodes connected by proximity lines
// Adapts to dark/light mode via matchMedia
// Skipped entirely if prefers-reduced-motion
---

<canvas
  id="network-canvas"
  class="absolute inset-0 w-full h-full pointer-events-none z-0"
  aria-hidden="true"
></canvas>

<script>
  (function () {
    const canvas = document.getElementById("network-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;

    // Skip animation for users who prefer reduced motion
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    // ── Theme colours ─────────────────────────────────────────────
    function getTheme() {
      const attr = document.documentElement.getAttribute("data-theme");
      const isLight = attr === "light" || (!attr && window.matchMedia("(prefers-color-scheme: light)").matches);
      return {
        nodePrimary: isLight ? "rgba(242,101,34,0.55)" : "rgba(242,101,34,0.50)",
        nodeSecondary: isLight ? "rgba(20,20,30,0.12)" : "rgba(255,255,255,0.18)",
        line: isLight ? "rgba(0,0,0,0.05)" : "rgba(255,255,255,0.05)",
      };
    }

    // ── Resize ────────────────────────────────────────────────────
    function resize() {
      const parent = canvas!.parentElement;
      if (!parent) return;
      canvas!.width = parent.offsetWidth;
      canvas!.height = parent.offsetHeight;
    }

    const ro = new ResizeObserver(resize);
    ro.observe(canvas.parentElement as Element);
    resize();

    // ── Nodes ─────────────────────────────────────────────────────
    const NODE_COUNT = 55;
    const MAX_DIST = 120;

    interface Node {
      x: number;
      y: number;
      vx: number;
      vy: number;
      r: number;
      primary: boolean;
    }

    function makeNodes(): Node[] {
      const nodes: Node[] = [];
      for (let i = 0; i < NODE_COUNT; i++) {
        nodes.push({
          x: Math.random() * canvas!.width,
          y: Math.random() * canvas!.height,
          vx: (Math.random() - 0.5) * 0.5,
          vy: (Math.random() - 0.5) * 0.5,
          r: 1.5 + Math.random() * 1.5,
          primary: Math.random() > 0.65,
        });
      }
      return nodes;
    }

    let nodes = makeNodes();
    let theme = getTheme();

    // Re-create nodes when canvas is resized so they stay in bounds
    const roNodes = new ResizeObserver(() => {
      nodes = makeNodes();
    });
    roNodes.observe(canvas.parentElement as Element);

    // ── Animation loop ────────────────────────────────────────────
    let raf: number;

    function tick() {
      const w = canvas!.width;
      const h = canvas!.height;

      ctx!.clearRect(0, 0, w, h);

      // Move + bounce
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < 0 || n.x > w) n.vx *= -1;
        if (n.y < 0 || n.y > h) n.vy *= -1;
      }

      // Connections
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MAX_DIST) {
            const alpha = (1 - dist / MAX_DIST);
            ctx!.save();
            ctx!.globalAlpha = alpha * 0.6;
            ctx!.strokeStyle = theme.line;
            ctx!.lineWidth = 0.8;
            ctx!.beginPath();
            ctx!.moveTo(nodes[i].x, nodes[i].y);
            ctx!.lineTo(nodes[j].x, nodes[j].y);
            ctx!.stroke();
            ctx!.restore();
          }
        }
      }

      // Nodes
      for (const n of nodes) {
        ctx!.beginPath();
        ctx!.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx!.fillStyle = n.primary ? theme.nodePrimary : theme.nodeSecondary;
        ctx!.fill();
      }

      raf = requestAnimationFrame(tick);
    }

    tick();

    // Update theme on OS preference change or data-theme toggle
    window.matchMedia("(prefers-color-scheme: light)").addEventListener("change", () => {
      theme = getTheme();
    });
    const themeObserver = new MutationObserver(() => { theme = getTheme(); });
    themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    // Cleanup on Astro view transitions
    document.addEventListener("astro:before-swap", () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      roNodes.disconnect();
      themeObserver.disconnect();
    });
  })();
</script>
