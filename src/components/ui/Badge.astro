---
export interface Props {
  variant?: 'orange' | 'green' | 'red' | 'neutral' | 'outline';
  dot?: boolean;
  class?: string;
}

const { variant = 'neutral', dot = false, class: className } = Astro.props;

const variants: Record<string, string> = {
  orange:  'bg-wtc-orange/15 text-wtc-orange border border-wtc-orange/30',
  green:   'bg-green-500/10 text-green-400 border border-green-500/20',
  red:     'bg-red-500/10 text-red-400 border border-red-500/20',
  neutral: 'bg-veil-strong text-ice-grey border border-hairline',
  outline: 'border border-white/20 text-text-muted',
};

const dotColors: Record<string, string> = {
  orange: 'bg-wtc-orange',
  green:  'bg-green-400',
  red:    'bg-red-400',
  neutral:'bg-ice-grey',
  outline:'bg-text-muted',
};
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 px-2.5 py-1 rounded prose-caption font-medium tracking-widest uppercase',
    variants[variant],
    className,
  ]}
>
  {dot && <span class:list={['w-1.5 h-1.5 rounded-full', dotColors[variant]]}></span>}
  <slot />
</span>
