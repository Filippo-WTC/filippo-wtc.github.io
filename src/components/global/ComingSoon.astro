---
import BranchLayout from "../../layouts/BranchLayout.astro";
import { getBranch } from "../../data/navigation";
import type { BranchConfig } from "../../types/navigation";
import Button from "../ui/Button.astro";

export interface Props {
  branchId: BranchConfig["id"];
  title: string;
  subtitle: string;
}

const { branchId, title, subtitle } = Astro.props;
const branch = getBranch(branchId);
---

<BranchLayout {branch} localNav={false} title={`${title} — WTC`}>
  <div
    class="min-h-screen flex flex-col items-center justify-center pt-navbar section-px text-center"
  >
    <!-- Background grid -->
    <div
      class="absolute inset-0 bg-telemetry opacity-30 pointer-events-none"
      aria-hidden="true"
    >
    </div>

    <div class="relative z-10 flex flex-col items-center gap-8 max-w-2xl">
      <!-- Branch label (neutral — the one orange mark here is the badge dot) -->
      <div class="flex items-center gap-3">
        <span class="w-8 h-[1px] bg-hairline-strong"></span>
        <span
          class="font-inter text-xs text-text-muted tracking-widest uppercase"
          >{branch.name}</span
        >
        <span class="w-8 h-[1px] bg-hairline-strong"></span>
      </div>

      <!-- Status badge — the single orange accent of this screen -->
      <div
        class="inline-flex items-center gap-2 px-4 py-2 rounded border border-hairline bg-veil"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-wtc-orange animate-pulse-glow"
        ></span>
        <span
          class="font-inter text-xs text-ice-grey tracking-widest uppercase"
          >In Sviluppo</span
        >
      </div>

      <!-- Title -->
      <h1
        class="font-clash font-semibold text-display-lg text-white text-balance"
      >
        {title}
      </h1>

      <!-- Subtitle -->
      <p class="prose-lead text-ice-grey/60">
        {subtitle}
      </p>

      <!-- Divider -->
      <div
        class="w-full h-[1px] bg-gradient-to-r from-transparent via-hairline-strong to-transparent"
      >
      </div>

      <!-- CTA back to services -->
      <div class="flex flex-wrap justify-center gap-4">
        <Button href="/services" variant="primary">
          Torna a WTC Services
        </Button>
        <Button href="/team/vip-accreditation" variant="outline">
          Richiedi Aggiornamenti
        </Button>
      </div>
    </div>
  </div>
</BranchLayout>
