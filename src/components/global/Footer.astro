---
import { BRANCHES } from "../../data/navigation";
import type { BranchConfig } from "../../types/navigation";

export interface Props {
  activeBranch?: BranchConfig["id"];
}

const { activeBranch } = Astro.props;

// All five marks below are pre-colored (white + orange) for the dark footer —
// none of them need the brightness/invert filter.
const branchLogos: Record<string, string> = {
  services: "/images/logos/wtc-logo-white.png",
  team: "/images/logos/wtc-team-mark.png",
  "global-portal": "/images/logos/wtc-global-portal-mark.png",
  pitter: "/images/logos/wtc-pitter-italy-mark.png",
  "wtc-food": "/images/logos/wtc-food-mark.png",
};

// Il footer è UNICO per le cinque divisioni, quindi la casella cambia col ramo
// attivo. Services ne ha due, una per funzione (FIL-293): il nome stesso della
// casella dice a chi si scrive, e nel footer basta quello — l'etichetta di
// funzione sta nella pagina Contatti, dove c'è lo spazio per spiegarla.
// Le altre divisioni, e le pagine che montano il footer senza ramo (404,
// privacy, cookie, /contatti, home), tengono la casella unica del gruppo.
// Gli indirizzi sono scritti a mano perché il sito non ha un file unico dei
// recapiti: ogni pagina se li ripete già così. È una copia, e può divergere
// dalle altre finché quel file non esiste.
const emailContatti: string[] =
  activeBranch === "services"
    ? ["supporto@wtcservices.it", "commerciale@wtcservices.it"]
    : ["wtc@wtcservices.it"];

const linkedinUrls: Record<string, string> = {
  services: "https://www.linkedin.com/company/wtcservices/",
  "global-portal": "https://www.linkedin.com/showcase/world-trade-contacts/",
  pitter: "https://www.linkedin.com/showcase/pitter-italy/",
  "wtc-food": "https://www.linkedin.com/showcase/wtc-food/",
  team: "https://www.linkedin.com/showcase/wtc-team/",
};
---

<footer class="relative border-t border-hairline bg-surface-01">
  <div class="relative section-px max-w-container mx-auto">

    <!-- Top: logo + tagline -->
    <div class="py-12 border-b border-hairline">
      <a href="/" aria-label="WTC">
        <img
          src="/images/logos/wtc-logo-white.png"
          alt="WTC"
          width="800"
          height="212"
          class="h-9 w-auto object-contain"
          loading="lazy"
        />
      </a>
      <p class="font-inter text-sm text-text-muted mt-3 max-w-xs leading-relaxed">
        Infrastrutture, sport, import e agroalimentare.<br />Un gruppo, cinque divisioni.
      </p>
    </div>

    <!-- Middle: 3-column grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10 py-12 border-b border-hairline">

      <!-- Col 1: Divisioni -->
      <div>
        <p class="prose-caption text-wtc-orange tracking-widest uppercase mb-5">Divisioni</p>
        <ul class="flex flex-col gap-3">
          {BRANCHES.map((branch) => (
            <li class="flex items-center gap-2.5">
              <a
                href={branch.rootHref}
                class="font-inter text-sm text-text-muted hover:text-ice-grey active:text-ice-grey transition-colors duration-200"
              >
                {branch.name}
              </a>
              {linkedinUrls[branch.id] && (
                <a
                  href={linkedinUrls[branch.id]}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${branch.name} su LinkedIn`}
                  class="inline-flex items-center justify-center w-6 h-6 shrink-0 -my-0.5 text-text-muted hover:text-white active:text-white transition-colors duration-200"
                >
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                  </svg>
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Contatti -->
      <div>
        <p class="prose-caption text-wtc-orange tracking-widest uppercase mb-5">Contatti</p>
        <ul class="flex flex-col gap-3">
          {emailContatti.map((email) => (
            <li>
              <a
                href={`mailto:${email}`}
                class="font-inter text-sm text-text-muted hover:text-wtc-orange active:text-wtc-orange transition-colors duration-200 break-all"
              >
                {email}
              </a>
            </li>
          ))}
          {/* Le caselle cambiano col ramo, il numero no: il telefono della
              società è uno solo per tutte e cinque le divisioni. Scritto per
              esteso come gli altri recapiti, con l'href in forma
              internazionale perché è quella che i telefoni compongono senza
              sbagliare da qualsiasi paese. whitespace-nowrap perché un numero
              spezzato a metà riga si legge come un dato corrotto, esattamente
              come il REA qui sotto. */}
          <li>
            <a
              href="tel:+390637352710"
              class="font-inter text-sm text-text-muted hover:text-wtc-orange active:text-wtc-orange transition-colors duration-200 whitespace-nowrap"
            >
              06 3735 2710
            </a>
          </li>
          <li class="font-inter text-sm text-text-muted leading-relaxed">
            Via Leone XIII, 464<br />
            00165 Roma (RM)
          </li>
          <li>
            <a
              href="/contatti/"
              class="font-inter text-sm text-text-muted hover:text-ice-grey active:text-ice-grey transition-colors duration-200"
            >
              Parla con noi →
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3: Legale -->
      <div>
        <p class="prose-caption text-wtc-orange tracking-widest uppercase mb-5">Legale</p>
        <ul class="flex flex-col gap-3">
          {/* Dati che l'art. 2250 c.c. impone di riportare negli atti e nella
              corrispondenza — sito incluso: registro delle imprese di iscrizione
              con il relativo numero, e capitale sociale. La sede legale non è
              ripetuta qui perché sta già nella colonna Contatti. Per una S.r.l.s.
              il capitale è interamente versato per legge (art. 2463-bis c.c.). */}
          <li class="font-inter text-sm text-text-muted leading-relaxed">
            WTC SERVICES S.r.l.s.<br />
            P.IVA e C.F. 14561821001<br />
            {/* Il numero REA non deve spezzarsi: sotto i ~360px la riga andava
                a capo dentro l'identificativo ("REA RM-" / "1530158"), che si
                legge come un dato corrotto. Così va a capo al trattino lungo. */}
            Registro Imprese di Roma — <span class="whitespace-nowrap">REA RM-1530158</span><br />
            Capitale sociale € 2.500,00 i.v.
          </li>
          <li>
            <a
              href="mailto:wtcservices@pec.net"
              class="font-inter text-sm text-text-muted hover:text-ice-grey active:text-ice-grey transition-colors duration-200 break-all"
            >
              PEC: wtcservices@pec.net
            </a>
          </li>
          <li>
            <a
              href="/privacy-policy/"
              class="font-inter text-sm text-text-muted hover:text-ice-grey active:text-ice-grey transition-colors duration-200"
            >
              Privacy Policy
            </a>
          </li>
          <li>
            <a
              href="/cookie-policy/"
              class="font-inter text-sm text-text-muted hover:text-ice-grey active:text-ice-grey transition-colors duration-200"
            >
              Cookie Policy
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- BU logos row. gap ridotto (gap-6→gap-x-4) e py sui link per compensare
         l'area tattile aggiunta: i loghi sono h-4 (16px) e da soli davano un
         bersaglio da 16px, sotto il minimo WCAG 2.5.8 (24px). Il link ora è
         flex/items-center con py-3, area tattile ~40px, logo visivamente uguale. -->
    <div class="flex items-center gap-x-4 gap-y-1 flex-wrap py-4 border-b border-hairline">
      {
        BRANCHES.map((branch) =>
          branchLogos[branch.id] ? (
            <a
              href={branch.rootHref}
              class:list={[
                "block shrink-0 py-3 px-1 transition-all duration-300",
                activeBranch === branch.id
                  ? "opacity-80 hover:opacity-100 active:opacity-100"
                  : activeBranch
                    ? "opacity-[0.12] hover:opacity-35 active:opacity-35 grayscale"
                    : "opacity-25 hover:opacity-55 active:opacity-55",
              ]}
              aria-label={branch.name}
              title={branch.name}
            >
              <img
                src={branchLogos[branch.id]}
                alt={branch.name}
                class="h-4 w-auto object-contain"
                loading="lazy"
              />
            </a>
          ) : null,
        )
      }
    </div>

    <!-- Copyright -->
    <div class="py-5 flex flex-col sm:flex-row items-center justify-between gap-2">
      {/* L'anno si risolve al build: il sito è statico, quindi si aggiorna a
          ogni deploy. Scritto a mano invecchiava in silenzio al 1° gennaio. */}
      <p class="font-inter text-xs text-text-muted">
        &copy; {new Date().getFullYear()} WTC SERVICES S.r.l.s. &mdash; Tutti i diritti riservati
      </p>
      <p class="font-inter text-xs text-text-muted">
        Fatto con cura in Italia
      </p>
    </div>

  </div>
</footer>
