---
import {
  BRANCHES,
  GLOBAL_NAV_ITEMS,
  BRANCH_MARKS,
  markWidthAt,
  contactHrefFor,
} from "../../data/navigation";
import type { BranchConfig } from "../../types/navigation";

export interface Props {
  activeBranch?: BranchConfig["id"];
}

const { activeBranch } = Astro.props;

// I marchi sono già bianco/arancio per fondo scuro: niente filtro brightness/invert.
const markId = activeBranch ?? "services";
const navLogo = BRANCH_MARKS[markId] ?? BRANCH_MARKS.services;

// Altezza resa del marchio (h-8). La larghezza si calcola dalle proporzioni
// reali del file: serve a riservare la scatola prima che il PNG arrivi, così
// il logo non passa da 0 alla sua larghezza sotto gli occhi di chi guarda.
const NAV_LOGO_H = 32;
const navLogoW = markWidthAt(markId, NAV_LOGO_H);

const current = activeBranch
  ? BRANCHES.find((b) => b.id === activeBranch)
  : undefined;

const navLogoHref = current?.rootHref ?? "/";
const contactHref = contactHrefFor(activeBranch);

// Menu mobile a due livelli. Dentro una divisione il primo livello sono le SUE
// pagine: chi arriva da una proposta o da una ricerca è già nel contesto giusto,
// e cambiare divisione è l'azione rara. Sulle pagine di gruppo (home, contatti,
// legali) non c'è divisione corrente e le cinque divisioni sono il contenuto
// giusto, quindi lì il menu resta com'era.
const sectionItems = current?.localNav ?? [];
const otherBranches = BRANCHES.filter((b) => b.id !== activeBranch);

// Stagger d'entrata calcolato, non scritto a mano. Prima erano cinque regole
// `nth-child(2..6)` fisse, nate quando il menu conteneva esattamente cinque
// divisioni: con il menu a due livelli le voci sono fino a 13, quindi dalla
// sesta in poi nessuna aveva un delay e partivano tutte insieme all'istante
// zero — sembravano immobili perché arrivavano PRIMA di quelle scaglionate.
// I due <p> di etichetta falsavano anche il conteggio di nth-child.
// Passo 0.06s: più lento è più morbido, ed è il passo storico del menu. Regge
// perché a scaglionarsi sono solo le voci di sezione (8-9), non tutte e 13:
// le altre divisioni entrano insieme, come blocco (vedi `.mnav-secondary`).
const STEP = 0.06;
const delayOf = (i: number) => `transition-delay: ${(i * STEP).toFixed(3)}s`;

// Le altre divisioni non sono il focus: non ripetono la coreografia delle voci
// di sezione (scivolata da destra, una per una) ma arrivano tutte insieme in
// dissolvenza, dopo. Il movimento racconta la gerarchia invece di appiattirla.
// Un unico delay condiviso, subito dopo l'ultima voce di sezione.
const secondaryDelay = current
  ? `transition-delay: ${((sectionItems.length + 1) * STEP).toFixed(3)}s`
  : "transition-delay: 0.06s";
---

<header
  id="global-navbar"
  class="fixed top-0 left-0 right-0 z-50 h-[72px] transition-transform duration-500 ease-in-out"
>
  <!-- Backdrop -->
  <div
    class="navbar-glass absolute inset-0 border-b border-hairline"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative h-full section-px flex items-center justify-between gap-8 max-w-container mx-auto"
  >
    <!-- Logo — the wrapper reserves the width of the WIDEST branch logo
         (Global Portal, 169px at h-8) so the centered nav links never
         shift position when navigating between business units. -->
    <a
      href={navLogoHref}
      class="flex items-center gap-3 flex-shrink-0 md:w-[172px]"
      aria-label="WTC — Home"
    >
      <!-- Niente transition:name qui. La View Transition nativa animava la
           LARGHEZZA della scatola incrociando le due istantanee, e i marchi
           hanno proporzioni molto diverse (169px Global Portal → 88px Team,
           −48%): le immagini si schiacciavano come elastici. In più girava
           mentre l'overlay stava annerendo, quindi metà si vedeva e metà no.
           Senza, il marchio cambia sotto il nero: non lo vedi cambiare. -->
      <img
        src={navLogo}
        alt="WTC"
        width={navLogoW}
        height={NAV_LOGO_H}
        class="h-8 w-auto object-contain"
        loading="eager"
      />
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Navigazione WTC">
      {
        GLOBAL_NAV_ITEMS.map((item) => {
          const branch = BRANCHES.find((b) => b.rootHref === item.href);
          const isActive = branch?.id === activeBranch;
          return (
            <a
              href={item.href}
              class:list={[
                "relative px-4 py-2 text-xs font-inter font-medium tracking-widest uppercase transition-colors duration-200 rounded-lg",
                isActive
                  ? "text-wtc-orange"
                  : "text-ice-grey/60 hover:text-ice-grey/90 active:text-ice-grey/90",
              ]}
            >
              {item.label}
              {isActive && (
                <span
                  transition:name="nav-bu-underline"
                  class="nav-underline absolute bottom-1 left-4 right-4 h-[1.5px] bg-wtc-orange origin-left"
                  aria-hidden="true"
                />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Right: contact + hamburger. Mirrors the logo wrapper's fixed width
         so the nav links sit at the exact centre of the bar. -->
    <div class="flex items-center justify-end gap-3 md:w-[172px]">
      <!-- Quiet contact link (desktop) -->
      <a
        href={contactHref}
        class="hidden lg:block font-inter text-xs text-ice-grey/60 hover:text-ice-grey/90 active:text-ice-grey/90 tracking-wide transition-colors duration-200"
      >
        Parla con noi
      </a>

      <!-- Mobile hamburger — two clean equal lines (44px touch target)
           that morph into an X. -->
      <button
        id="mobile-menu-btn"
        class="md:hidden w-11 h-11 flex flex-col items-center justify-center gap-[7px] group"
        aria-label="Apri menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span
          class="hamburger-line w-[22px] h-[1.5px] rounded-full bg-ice-grey group-hover:bg-white group-active:bg-white transition-[transform,background-color] duration-300 origin-center"
        ></span>
        <span
          class="hamburger-line w-[22px] h-[1.5px] rounded-full bg-ice-grey group-hover:bg-white group-active:bg-white transition-[transform,background-color] duration-300 origin-center"
        ></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu overlay.
     h-[100dvh] invece di inset-0: su mobile `position:fixed; inset:0` si
     dimensiona sul viewport GRANDE (address bar nascosta), così il fondo del
     menu — con la CTA — finiva dietro la barra degli indirizzi e non era
     raggiungibile (il body è bloccato, non si scrolla la pagina). Il viewport
     dinamico segue l'area realmente visibile e la copre senza lasciare vuoti. -->
<div
  id="mobile-menu"
  class="mobile-menu-glass fixed top-0 left-0 right-0 h-[100dvh] z-[45] flex flex-col pt-navbar translate-x-full transition-transform duration-300 ease-in-out md:hidden"
  aria-hidden="true"
  inert
>
  <!-- flex-1 + min-h-0 + overflow-y-auto: sotto ~775px di viewport il contenuto
       supera l'altezza e prima la CTA "Parla con noi" restava irraggiungibile.
       data-lenis-prevent: senza, Lenis intercetta wheel/touch e lo scroll interno
       resta morto. pb con safe-area per i notch iOS. -->
  <nav
    class="flex-1 min-h-0 overflow-y-auto overscroll-contain flex flex-col px-8 py-8 pb-[calc(2rem+env(safe-area-inset-bottom))] gap-1"
    aria-label="Menu mobile"
    data-lenis-prevent
    data-two-level={current ? "" : undefined}
  >
    {/* ── Livello 1: la divisione corrente ───────────────────────────
         Niente etichetta con il nome della divisione: stava a 40px sotto il
         logo che dice esattamente la stessa cosa, nello stesso pannello.
         L'occhiello non ripete mai la divisione — quella la dice il logo. */}
    {current && (
      <>
        {sectionItems.map((item, i) => (
          <a
            href={item.href}
            style={delayOf(i)}
            aria-current={item.href === Astro.url.pathname ? "page" : undefined}
            class:list={[
              "mobile-nav-item flex items-baseline gap-3 py-3.5 border-b border-hairline transition-colors duration-200",
              item.child && "pl-5",
              item.href === Astro.url.pathname
                ? "text-wtc-orange"
                : "text-ice-grey/80 hover:text-white active:text-white",
            ]}
          >
            {/* Il trattino segna le voci figlie: su Global Portal tre servizi
                sono dettagli di "Servizi partner", non sue sorelle. */}
            {item.child && (
              <span class="text-ice-grey/25 flex-shrink-0" aria-hidden="true">—</span>
            )}
            {/* Niente descrizione nelle voci di sezione. Misurato: costano ~29px
                a riga e su 8 righe fanno 230px, e non entrano su NESSUN telefono
                (sweep 667→932px: overflow sempre presente). Legarle a una soglia
                d'altezza peggiorava le cose — a 760px il menu era più scomodo che
                a 740px, perché sopra la soglia tornavano tutte insieme. Le
                etichette bastano da sole; le descrizioni restano nel menu di
                GRUPPO, dove sono 5 e spiegano divisioni che il lettore non conosce. */}
            <span class="mnav-title font-clash font-semibold text-xl leading-tight">
              {item.label}
            </span>
          </a>
        ))}
        <a
          href={contactHref}
          style={delayOf(sectionItems.length)}
          aria-current={contactHref === Astro.url.pathname ? "page" : undefined}
          class:list={[
            "mobile-nav-item flex items-center py-3.5 border-b border-hairline transition-colors duration-200",
            contactHref === Astro.url.pathname
              ? "text-wtc-orange"
              : "text-ice-grey/80 hover:text-white active:text-white",
          ]}
        >
          <span class="mnav-title font-clash font-semibold text-xl leading-tight">
            Contatti
          </span>
        </a>
      </>
    )}

    {/* ── Livello 2: le altre divisioni, con i marchi ───────────────
         Il marchio contiene già logomark + nome, quindi SOSTITUISCE
         l'etichetta invece di affiancarla: altrimenti il nome è scritto
         due volte. Sulle pagine di gruppo non c'è divisione corrente e
         questo diventa il primo livello, con le descrizioni. */}
    {/* /60 e non /40: a /40 il rapporto di contrasto è 3.22:1, sotto il minimo
        AA di 4.5:1 per testo da 13px. A /60 sale a 4.86:1. */}
    <p
      class:list={[
        "prose-caption text-ice-grey/60 tracking-widest uppercase",
        current ? "mt-7 mb-1" : "mb-1",
      ]}
    >
      {current ? "Altre divisioni" : "Le divisioni"}
    </p>
    {otherBranches.map((b) => (
      <a
        href={b.rootHref}
        style={secondaryDelay}
        class:list={[
          // Niente opacity-70 qui: la regola dello stagger
          // (#mobile-menu[aria-hidden="false"] .mobile-nav-item) ha specificità
          // maggiore e imponeva comunque opacity:1, quindi era codice morto. Ed
          // è meglio così: attenuando le righe, le tagline della home sarebbero
          // scese a 3.14:1, sotto AA.
          "mobile-nav-item mnav-secondary flex items-center gap-4 border-b border-hairline",
          current ? "py-3" : "py-4",
        ]}
      >
        <img
          src={BRANCH_MARKS[b.id]}
          alt={b.name}
          class="h-5 w-auto object-contain flex-shrink-0"
          loading="lazy"
        />
        {!current && (
          <span class="mnav-desc font-inter text-sm text-text-muted">
            {b.tagline}
          </span>
        )}
      </a>
    ))}

    {/* La CTA in fondo dipende dal contesto e c'è SEMPRE. Dentro una divisione
        i contatti sono già in elenco, quindi qui serve la via verso il gruppo.
        Sulle pagine di gruppo (home, legali) non esiste elenco di sezione: senza
        questa riga il menu resterebbe cinque marchi e nessun modo di contattare
        nessuno — e "Parla con noi" in navbar è hidden sotto 1024px, quindi da
        telefono l'unico contatto sarebbe il footer in fondo alla pagina. */}
    {/* mobile-nav-item anche qui: prima questo blocco non aveva né stato
        iniziale né transizione, quindi era l'unico davvero immobile. */}
    <div
      class="mnav-cta mobile-nav-item mnav-secondary mt-7 flex items-center gap-3"
      style={secondaryDelay}
    >
      <a
        href={current ? "/" : "/contatti/"}
        class="flex-1 flex items-center justify-center py-3.5 border border-hairline-strong text-white/70 font-inter text-sm tracking-wide rounded-xl hover:border-white/25 active:border-white/25 hover:text-white active:text-white transition-colors duration-200"
      >
        {current ? "Il gruppo WTC" : "Parla con noi"}
      </a>
    </div>
  </nav>
</div>

<style>
  :global(html.nav-hidden) #global-navbar {
    transform: translateY(-100%);
  }

  /* The underline draws itself in ONLY on a cold load. On navigation it is
     instead morphed from its old position to the new one by the view
     transition (transition:name="nav-bu-underline"), which means: moving
     between business units slides the line across, and moving *within* one
     leaves it perfectly still — the old behaviour replayed the draw-in on
     every page, which read as a glitch when nothing had actually changed.
     `data-navigated` is stamped on <html> after the first swap. */
  :global(html:not([data-navigated])) .nav-underline {
    animation: nav-underline-in 0.4s cubic-bezier(0.215, 0.61, 0.355, 1) both;
  }

  @keyframes nav-underline-in {
    from {
      transform: scaleX(0);
    }

    to {
      transform: scaleX(1);
    }
  }

  /* Mobile menu items stagger in via CSS transitions keyed on the menu's
     aria-hidden state — no JS animation needed. Closed: items sit right
     and transparent (no transition, so reopening always restarts). */
  #mobile-menu[aria-hidden="true"] .mobile-nav-item {
    opacity: 0;
    transform: translateX(24px);
    transition: none;
  }

  #mobile-menu[aria-hidden="false"] .mobile-nav-item {
    opacity: 1;
    transform: translateX(0);
    transition:
      opacity 0.4s cubic-bezier(0.215, 0.61, 0.355, 1),
      transform 0.4s cubic-bezier(0.215, 0.61, 0.355, 1);
  }

  /* Le altre divisioni non sono il focus: entrano in DISSOLVENZA e tutte
     insieme, senza la scivolata da destra e senza scaglionamento. La differenza
     di movimento comunica la gerarchia — le voci di sezione sono scelte da
     leggere una per una, queste sono contesto che si posa dietro. Durata più
     lunga (0.55s) perché una dissolvenza lenta legge come calma, mentre alla
     stessa velocità della scivolata sembrerebbe solo un'animazione a metà.
     Va DOPO le regole generali: stessa specificità, vince l'ordine. */
  #mobile-menu[aria-hidden="true"] .mnav-secondary {
    transform: none;
  }

  #mobile-menu[aria-hidden="false"] .mnav-secondary {
    transform: none;
    transition:
      opacity 0.55s cubic-bezier(0.215, 0.61, 0.355, 1),
      transform 0s;
  }

  /* I delay non stanno più qui: sono calcolati nel markup (vedi `delayOf`).
     Le vecchie cinque regole nth-child(2..6) coprivano solo i primi cinque
     figli e contavano anche i <p> di etichetta. A menu chiuso il delay va
     azzerato, altrimenti la chiusura sarebbe scaglionata al contrario. */
  #mobile-menu[aria-hidden="true"] .mobile-nav-item {
    transition-delay: 0s !important;
  }

  /* Dispositivi bassi. Soglie ritarate col menu a due livelli: dentro una
     divisione le voci non sono più 5 ma fino a 13 (pagine della sezione +
     contatti + le altre quattro divisioni), quindi la compattazione deve
     scattare prima e togliere le descrizioni, che raddoppiano l'altezza di
     ogni riga. Le etichette di sezione bastano da sole; le descrizioni delle
     DIVISIONI restano, perché lì spiegano attività che il lettore non conosce. */
  /* 950px e non 745: il menu è md:hidden, quindi esiste solo su telefoni, che
     stanno tutti sotto questa soglia. Con 745 c'era un dirupo — a 760px, cioè
     con 15px di schermo IN PIÙ, la compattazione si spegneva e il menu diventava
     di colpo 280px più lungo: ogni telefono moderno stava peggio di un iPhone SE.
     Coprendo l'intera fascia, la resa peggiora in modo continuo al ridursi
     dell'altezza, senza scalini. */
  @media (max-height: 950px) {
    #mobile-menu nav { padding-top: 1rem; padding-bottom: 1rem; }
    /* min-height oltre al padding: le righe delle altre divisioni contengono un
       marchio da 20px e con il solo padding compattato scendevano a 40px —
       sopra il minimo WCAG (24px) ma sotto la soglia comoda di 44. */
    #mobile-menu .mobile-nav-item {
      padding-top: 0.6rem;
      padding-bottom: 0.6rem;
      min-height: 44px;
    }
    #mobile-menu .mnav-title { font-size: 1.35rem; }
    #mobile-menu .mnav-cta { margin-top: 1rem; }
  }

  @media (max-height: 650px) {
    /* Ancora più stretto: via le descrizioni, i titoli bastano a identificare
       la divisione, e la CTA rientra anche sugli schermi più piccoli. */
    #mobile-menu .mnav-desc { display: none; }
    #mobile-menu .mobile-nav-item { padding-top: 0.45rem; padding-bottom: 0.45rem; }
    #mobile-menu .mnav-title { font-size: 1.25rem; }
  }

  /* Hamburger → X: the two lines meet in the middle and cross.
     (gap 7px + line 1.5px → each line travels half of 8.5px) */
  #mobile-menu-btn.is-open .hamburger-line:nth-child(1) {
    transform: translateY(4.25px) rotate(45deg);
  }
  #mobile-menu-btn.is-open .hamburger-line:nth-child(2) {
    transform: translateY(-4.25px) rotate(-45deg);
  }
</style>

<script>
  // Module-level: the Escape handler is registered on `document` exactly once
  // (document survives view transitions); it delegates to the current page's
  // closeMenu through this ref.
  let escListenerBound = false;
  let closeMenuRef: (() => void) | null = null;

  // Hide-on-scroll. One passive listener for the whole session — `window`
  // survives view transitions (same rationale as the Escape handler above),
  // and elements are looked up lazily so it always targets the current DOM.
  // Lenis drives *native* scroll, so plain window scroll events fire; this
  // avoids coupling to the Lenis singleton's init timing. Hide/show is
  // functional (it returns screen space), so it also runs under
  // prefers-reduced-motion — the CSS transition is the only motion involved.
  let lastScrollY = 0;
  let scrollRafPending = false;

  // The hidden state lives on <html> (class `nav-hidden`) so every fixed
  // bar can react in CSS: the navbar slides fully out and the LocalNav
  // (when present) rises to fill the vacated 72px — no orphan gap.
  function setNavHidden(hidden: boolean) {
    document.documentElement.classList.toggle("nav-hidden", hidden);
  }

  function updateNavbarVisibility() {
    scrollRafPending = false;
    const y = window.scrollY;
    const menuOpen = document
      .getElementById("mobile-menu-btn")
      ?.classList.contains("is-open");

    if (menuOpen || y < 80) {
      setNavHidden(false);
    } else if (y > lastScrollY && y > 120) {
      setNavHidden(true);
    } else if (y < lastScrollY) {
      setNavHidden(false);
    }
    lastScrollY = y;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (scrollRafPending) return;
      scrollRafPending = true;
      requestAnimationFrame(updateNavbarVisibility);
    },
    { passive: true },
  );

  function initNavbar() {
    const btnMaybe = document.getElementById("mobile-menu-btn");
    const menuMaybe = document.getElementById("mobile-menu");
    if (!btnMaybe || !menuMaybe) return;
    // Non-null aliases: keeps TS narrowing inside the closures below even
    // though closeMenu escapes to module scope via closeMenuRef.
    const btn = btnMaybe;
    const menu = menuMaybe;

    const focusableSelectors = 'a[href], button:not([disabled])';

    // New page: scroll is reset by RootLayout before paint — start visible
    // and re-baseline the scroll delta so the first event isn't a stale jump.
    lastScrollY = window.scrollY;
    setNavHidden(false);

    // Underline draw-in and mobile-item stagger are pure CSS (see <style>):
    // this component needs no GSAP, so legal pages stay animation-bundle-free.

    function openMenu() {
      // Menu is anchored to the navbar — force it visible while open.
      setNavHidden(false);
      btn.classList.add("is-open");
      btn.setAttribute("aria-expanded", "true");
      btn.setAttribute("aria-label", "Chiudi menu (Esc)");
      menu.classList.remove("translate-x-full");
      menu.setAttribute("aria-hidden", "false");
      // The closed menu is only pushed off-screen (still in the layout), so
      // its links stayed keyboard-focusable while aria-hidden — a real AT
      // trap. `inert` removes them from focus and the a11y tree entirely.
      menu.removeAttribute("inert");
      document.body.style.overflow = "hidden";

      // Move focus to first focusable element
      const firstFocusable = menu.querySelector<HTMLElement>(focusableSelectors);
      firstFocusable?.focus();
    }

    function closeMenu() {
      btn.classList.remove("is-open");
      btn.setAttribute("aria-expanded", "false");
      btn.setAttribute("aria-label", "Apri menu");
      menu.classList.add("translate-x-full");
      menu.setAttribute("aria-hidden", "true");
      menu.setAttribute("inert", "");
      document.body.style.overflow = "";
      btn.focus();
    }

    btn.addEventListener("click", () => {
      btn.classList.contains("is-open") ? closeMenu() : openMenu();
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    // Escape key closes menu. The listener lives on `document`, which
    // survives view transitions — register it once, not per navigation,
    // and look the button up lazily so it targets the current DOM.
    if (!escListenerBound) {
      escListenerBound = true;
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const openBtn = document.getElementById("mobile-menu-btn");
        if (openBtn?.classList.contains("is-open")) closeMenuRef?.();
      });
    }
    closeMenuRef = closeMenu;

    // Focus trap. Il bottone X vive nell'header, FUORI da #mobile-menu: se il
    // trap guarda solo dentro il menu, da tastiera la X non è mai raggiungibile
    // e l'unica uscita è Esc (non annunciata). Qui btn è il primo anello del
    // ciclo, e l'handler è agganciato sia a btn sia a menu perché un keydown
    // sul bottone non bolla dentro il menu.
    const trapTab = (e: KeyboardEvent) => {
      if (e.key !== "Tab") return;
      const focusable = [
        btn,
        ...Array.from(menu.querySelectorAll<HTMLElement>(focusableSelectors)),
      ];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    };
    btn.addEventListener("keydown", trapTab);
    menu.addEventListener("keydown", trapTab);
  }

  document.addEventListener("astro:page-load", initNavbar);
</script>
