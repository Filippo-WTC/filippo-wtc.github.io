---
import { BRANCHES, GLOBAL_NAV_ITEMS } from "../../data/navigation";
import type { BranchConfig } from "../../types/navigation";

export interface Props {
  activeBranch?: BranchConfig["id"];
}

const { activeBranch } = Astro.props;

// All five marks below are pre-colored (white + orange) for the dark navbar —
// none of them need the brightness/invert filter.
const branchNavLogos: Record<string, string> = {
  services: "/images/logos/wtc-logo-white.png",
  team: "/images/logos/wtc-team-mark.png",
  "global-portal": "/images/logos/wtc-global-portal-mark.png",
  pitter: "/images/logos/wtc-pitter-italy-mark.png",
  "wtc-food": "/images/logos/wtc-food-mark.png",
};

const navLogo = activeBranch
  ? (branchNavLogos[activeBranch] ?? "/images/logos/wtc-logo-white.png")
  : "/images/logos/wtc-logo-white.png";

const navLogoHref = activeBranch
  ? (BRANCHES.find((b) => b.id === activeBranch)?.rootHref ?? "/")
  : "/";

const branchContactHrefs: Record<string, string> = {
  services: "/services/contatti",
  team: "/team/contatti",
  "global-portal": "/global-portal/contatti",
  pitter: "/pitter-italy/contatti",
  "wtc-food": "/wtc-food/contatti",
};

const contactHref = activeBranch
  ? (branchContactHrefs[activeBranch] ?? "/contatti")
  : "/contatti";
---

<header
  id="global-navbar"
  class="fixed top-0 left-0 right-0 z-50 h-[72px] transition-transform duration-500 ease-in-out"
>
  <!-- Backdrop -->
  <div
    class="navbar-glass absolute inset-0 border-b border-hairline"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative h-full section-px flex items-center justify-between gap-8 max-w-container mx-auto"
  >
    <!-- Logo -->
    <a
      href={navLogoHref}
      class="flex items-center gap-3 flex-shrink-0"
      aria-label="WTC — Home"
    >
      <img
        src={navLogo}
        alt="WTC"
        class="h-8 w-auto object-contain"
        loading="eager"
        transition:name="brand-logo"
      />
    </a>

    <!-- Desktop navigation -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Navigazione WTC">
      {
        GLOBAL_NAV_ITEMS.map((item) => {
          const branch = BRANCHES.find((b) => b.rootHref === item.href);
          const isActive = branch?.id === activeBranch;
          return (
            <a
              href={item.href}
              class:list={[
                "relative px-4 py-2 text-xs font-inter font-medium tracking-widest uppercase transition-colors duration-200 rounded-lg",
                isActive
                  ? "text-wtc-orange"
                  : "text-ice-grey/60 hover:text-ice-grey/90",
              ]}
            >
              {item.label}
              {isActive && (
                <span
                  class="nav-underline absolute bottom-1 left-4 w-4 h-[1.5px] bg-wtc-orange origin-left"
                  aria-hidden="true"
                />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Right: contact + theme + hamburger -->
    <div class="flex items-center gap-3">
      <!-- Quiet contact link (desktop) -->
      <a
        href={contactHref}
        class="hidden lg:block font-inter text-xs text-ice-grey/60 hover:text-ice-grey/90 tracking-wide transition-colors duration-200"
      >
        Parla con noi
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        class="md:hidden w-11 h-11 flex flex-col items-center justify-center gap-[5px]"
        aria-label="Apri menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span
          class="hamburger-line w-5 h-[1.5px] bg-ice-grey/70 transition-[transform,opacity,width] duration-300 origin-center"
        ></span>
        <span
          class="hamburger-line w-5 h-[1.5px] bg-ice-grey/70 transition-[transform,opacity,width] duration-300 origin-center"
        ></span>
        <span
          class="hamburger-line w-3 h-[1.5px] bg-ice-grey/70 transition-[transform,opacity,width] duration-300 origin-center self-start"
        ></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu overlay -->
<div
  id="mobile-menu"
  class="mobile-menu-glass fixed inset-0 z-40 flex flex-col pt-navbar translate-x-full transition-transform duration-300 ease-in-out md:hidden"
  aria-hidden="true"
>
  <nav class="flex flex-col px-8 py-8 gap-1" aria-label="Menu mobile">
    {
      GLOBAL_NAV_ITEMS.map((item, i) => {
        const branch = BRANCHES.find((b) => b.rootHref === item.href);
        const isActive = branch?.id === activeBranch;
        const num = String(i + 1).padStart(2, "0");
        return (
          <a
            href={item.href}
            class:list={[
              "mobile-nav-item flex items-center gap-4 py-5 border-b border-hairline transition-colors duration-200",
              isActive
                ? "text-wtc-orange"
                : "text-ice-grey/80 hover:text-white",
            ]}
          >
            <span class="font-inter text-xs text-ice-grey/20 w-6 flex-shrink-0 tabular-nums">
              {num}
            </span>
            <div class="flex flex-col">
              <span class="font-clash font-semibold text-2xl leading-tight">
                {item.label}
              </span>
              <span class="font-inter text-sm text-text-muted mt-0.5">
                {item.description}
              </span>
            </div>
          </a>
        );
      })
    }

    <div class="mt-8 flex items-center gap-3">
      <a
        href={contactHref}
        class="flex-1 flex items-center justify-center py-4 border border-hairline-strong text-white/80 font-inter text-sm tracking-wide rounded-xl hover:border-white/25 hover:text-white transition-colors duration-200"
      >
        Parla con noi
      </a>
    </div>
  </nav>
</div>

<style>
  #global-navbar.navbar--hidden {
    transform: translateY(-100%);
  }

  /* Hamburger → X animation */
  #mobile-menu-btn.is-open .hamburger-line:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  #mobile-menu-btn.is-open .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  #mobile-menu-btn.is-open .hamburger-line:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
    width: 20px;
    align-self: center;
  }
</style>

<script>
  import { gsap } from "@/lib/gsap";

  // Module-level: the Escape handler is registered on `document` exactly once
  // (document survives view transitions); it delegates to the current page's
  // closeMenu through this ref.
  let escListenerBound = false;
  let closeMenuRef: (() => void) | null = null;

  // Hide-on-scroll. One passive listener for the whole session — `window`
  // survives view transitions (same rationale as the Escape handler above),
  // and elements are looked up lazily so it always targets the current DOM.
  // Lenis drives *native* scroll, so plain window scroll events fire; this
  // avoids coupling to the Lenis singleton's init timing. Hide/show is
  // functional (it returns screen space), so it also runs under
  // prefers-reduced-motion — the CSS transition is the only motion involved.
  let lastScrollY = 0;
  let scrollRafPending = false;

  function updateNavbarVisibility() {
    scrollRafPending = false;
    const nav = document.getElementById("global-navbar");
    if (!nav) return;
    const y = window.scrollY;
    const menuOpen = document
      .getElementById("mobile-menu-btn")
      ?.classList.contains("is-open");

    if (menuOpen || y < 80) {
      nav.classList.remove("navbar--hidden");
    } else if (y > lastScrollY && y > 120) {
      nav.classList.add("navbar--hidden");
    } else if (y < lastScrollY) {
      nav.classList.remove("navbar--hidden");
    }
    lastScrollY = y;
  }

  window.addEventListener(
    "scroll",
    () => {
      if (scrollRafPending) return;
      scrollRafPending = true;
      requestAnimationFrame(updateNavbarVisibility);
    },
    { passive: true },
  );

  function initNavbar() {
    const btnMaybe = document.getElementById("mobile-menu-btn");
    const menuMaybe = document.getElementById("mobile-menu");
    if (!btnMaybe || !menuMaybe) return;
    // Non-null aliases: keeps TS narrowing inside the closures below even
    // though closeMenu escapes to module scope via closeMenuRef.
    const btn = btnMaybe;
    const menu = menuMaybe;

    const focusableSelectors = 'a[href], button:not([disabled])';

    // New page: scroll is reset by RootLayout before paint — start visible
    // and re-baseline the scroll delta so the first event isn't a stale jump.
    lastScrollY = window.scrollY;
    document.getElementById("global-navbar")?.classList.remove("navbar--hidden");

    // Active-link underline draws in on load (scaleX 0 → 1, origin left).
    // Static full-width under reduced motion (its natural CSS state).
    const underline = document.querySelector<HTMLElement>(".nav-underline");
    if (underline && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.fromTo(
        underline,
        { scaleX: 0 },
        { scaleX: 1, duration: 0.4, ease: "power3.out", transformOrigin: "left center" },
      );
    }

    function openMenu() {
      // Menu is anchored to the navbar — force it visible while open.
      document.getElementById("global-navbar")?.classList.remove("navbar--hidden");
      btn.classList.add("is-open");
      btn.setAttribute("aria-expanded", "true");
      menu.classList.remove("translate-x-full");
      menu.setAttribute("aria-hidden", "false");
      document.body.style.overflow = "hidden";

      // Animate items in (skip under reduced motion — items stay visible)
      if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const items = menu.querySelectorAll(".mobile-nav-item");
        gsap.fromTo(items,
          { x: 24, opacity: 0 },
          { x: 0, opacity: 1, stagger: 0.06, duration: 0.4, ease: "power3.out" }
        );
      }

      // Move focus to first focusable element
      const firstFocusable = menu.querySelector<HTMLElement>(focusableSelectors);
      firstFocusable?.focus();
    }

    function closeMenu() {
      btn.classList.remove("is-open");
      btn.setAttribute("aria-expanded", "false");
      menu.classList.add("translate-x-full");
      menu.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      btn.focus();
    }

    btn.addEventListener("click", () => {
      btn.classList.contains("is-open") ? closeMenu() : openMenu();
    });

    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    // Escape key closes menu. The listener lives on `document`, which
    // survives view transitions — register it once, not per navigation,
    // and look the button up lazily so it targets the current DOM.
    if (!escListenerBound) {
      escListenerBound = true;
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        const openBtn = document.getElementById("mobile-menu-btn");
        if (openBtn?.classList.contains("is-open")) closeMenuRef?.();
      });
    }
    closeMenuRef = closeMenu;

    // Focus trap inside open menu
    menu.addEventListener("keydown", (e) => {
      if (e.key !== "Tab") return;
      const focusable = Array.from(menu.querySelectorAll<HTMLElement>(focusableSelectors));
      if (!focusable.length) return;
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    });
  }

  document.addEventListener("astro:page-load", initNavbar);
</script>
