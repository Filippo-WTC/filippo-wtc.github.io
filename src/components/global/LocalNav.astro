---
import type { NavItem } from '../../types/navigation';

export interface Props {
  items: NavItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

// Match indipendente dallo slash finale: si normalizzano entrambi i lati
// togliendo lo slash terminale, così l'attivo funziona sia con href slashati
// (trailingSlash: 'always') sia senza. Senza questa normalizzazione, aggiungere
// `+ '/'` a un href già slashato dava `//`, sempre falso: la voce attiva spariva.
const stripSlash = (p: string) => (p.length > 1 ? p.replace(/\/$/, '') : p);
const cur = stripSlash(currentPath);

// Find the single best match: exact wins; among prefix matches, longest wins.
const activeHref = items
  .map(item => stripSlash(item.href.split('#')[0]))
  .filter(href => cur === href || (href.length > 1 && cur.startsWith(href + '/')))
  .sort((a, b) => b.length - a.length)[0] ?? null;
---

<nav
  class="local-nav-glass local-nav fixed top-[72px] left-0 right-0 z-40 h-[52px] border-b border-hairline overflow-x-auto scrollbar-none transition-transform duration-500 ease-in-out"
  aria-label="Navigazione sezione"
>
  <div class="h-full flex items-center gap-0 max-w-container mx-auto section-px min-w-max">
    {items.map((item) => {
      const cleanHref = stripSlash(item.href.split('#')[0]);
      const isActive = cleanHref === activeHref;
      return (
        <a
          href={item.href}
          data-active={isActive ? "" : undefined}
          class:list={[
            'relative h-full flex items-center px-4 text-xs font-inter tracking-widest uppercase whitespace-nowrap transition-colors duration-200',
            isActive
              ? 'text-wtc-orange'
              : 'text-text-muted hover:text-ice-grey',
          ]}
        >
          {item.label}
          {isActive && (
            <span
              transition:name="localnav-indicator"
              class="absolute bottom-0 left-0 right-0 h-[2px] bg-wtc-orange"
              aria-hidden="true"
            ></span>
          )}
        </a>
      );
    })}
  </div>
</nav>

<style>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

  /* Su mobile la barra scorre in orizzontale e l'ultima voce resta tagliata
     a metà parola. Una dissolvenza sul bordo destro rende il taglio
     deliberato invece che accidentale: si legge "c'è dell'altro, scorri".
     Solo sotto md, dove la barra effettivamente sborda; da desktop tutte le
     voci ci stanno e la maschera non serve. */
  @media (max-width: 767px) {
    .local-nav {
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
      mask-image: linear-gradient(to right, #000 calc(100% - 2rem), transparent);
    }
  }

  /* When the navbar hides on scroll (html.nav-hidden, set by Navbar.astro),
     the LocalNav rises to fill the vacated 72px instead of floating with a
     random gap above it. Same duration/easing as the navbar slide. */
  :global(html.nav-hidden) .local-nav {
    transform: translateY(calc(-1 * var(--navbar-h)));
  }
</style>

<script>
  // Su mobile la barra scorre in orizzontale: se la voce attiva è fuori campo a
  // destra, sembra che non ci sia nulla di selezionato (era così su 11 pagine
  // su 17). Qui la si centra nella barra al caricamento e dopo ogni navigazione,
  // agendo solo su scrollLeft della barra — niente scrollIntoView, così lo
  // scroll della pagina non viene toccato. No-op su desktop (barra non sborda).
  function centerLocalNavActive() {
    const nav = document.querySelector<HTMLElement>(".local-nav");
    const active = nav?.querySelector<HTMLElement>("[data-active]");
    if (!nav || !active) return;
    const target = active.offsetLeft - (nav.clientWidth - active.clientWidth) / 2;
    const max = nav.scrollWidth - nav.clientWidth;
    nav.scrollLeft = Math.max(0, Math.min(target, max));
  }
  // after-swap (prima del paint, niente flash sulla navigazione) + page-load
  // (il caricamento a freddo, dove after-swap non scatta).
  document.addEventListener("astro:after-swap", centerLocalNavActive);
  document.addEventListener("astro:page-load", centerLocalNavActive);
</script>
