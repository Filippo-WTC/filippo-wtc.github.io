---
// EcosystemFlow — the connective tissue between WTC's five companies.
// Not a generic "our services" grid: it shows the real links that make the
// group one thing — machines that process a harvest, products that become
// gifts, an IT backbone under everything, a method exported abroad.
import SectionLabel from "../ui/SectionLabel.astro";
import Badge from "../ui/Badge.astro";

type BadgeVariant = "orange" | "green" | "red" | "neutral" | "outline";

interface Node {
  label: string;
  variant: BadgeVariant;
  href?: string;
}

interface Link {
  from: Node;
  to: Node;
  text: string;
}

const links: Link[] = [
  {
    from: { label: "Pitter Italy", variant: "green", href: "/pitter-italy" },
    to: { label: "WTC Food", variant: "outline", href: "/wtc-food" },
    text: "Le macchine di Pitter Italy denocciolano e puliscono il raccolto che WTC Food trasforma in prodotti finiti.",
  },
  {
    from: { label: "WTC Food", variant: "outline", href: "/wtc-food" },
    to: { label: "WTC Team", variant: "outline", href: "/team" },
    text: "Le specialità WTC Food diventano i cesti e l'hospitality con cui WTC Team apre e coltiva relazioni.",
  },
  {
    from: { label: "WTC Services", variant: "orange", href: "/services" },
    to: { label: "Tutto il gruppo", variant: "neutral" },
    text: "L'infrastruttura IT di WTC Services tiene in piedi il lavoro quotidiano di ogni divisione.",
  },
  {
    from: { label: "WTC Global Portal", variant: "neutral", href: "/global-portal" },
    to: { label: "Mercati esteri", variant: "neutral" },
    text: "WTC Global Portal porta le stesse reti e lo stesso metodo sui mercati internazionali.",
  },
];
---

<section class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.05]">
  <div class="flex flex-col gap-4 mb-14">
    <SectionLabel number="02" label="L'ecosistema" />
    <h2 class="font-clash font-semibold text-display-lg text-white max-w-2xl">
      Cinque aziende che <span class="text-wtc-orange">si parlano.</span>
    </h2>
    <p class="prose-lead text-ice-grey/55 max-w-2xl mt-2">
      Non sono cinque brand sotto lo stesso logo. Un raccolto passa dalle macchine
      di Pitter ai prodotti di WTC Food, che tornano come regali d'impresa con WTC
      Team. Sotto, l'IT di WTC Services. Intorno, le rotte di Global Portal.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-5 ecosystem-cards">
    {
      links.map((link) => (
        <div class="ecosystem-card group relative rounded-bento bg-surface-01 border border-white/[0.06] p-8 flex flex-col gap-5 hover:border-white/[0.12] transition-all duration-500">
          <div class="flex items-center gap-3 flex-wrap">
            {link.from.href ? (
              <a href={link.from.href}>
                <Badge variant={link.from.variant}>{link.from.label}</Badge>
              </a>
            ) : (
              <Badge variant={link.from.variant}>{link.from.label}</Badge>
            )}
            <span class="text-wtc-orange font-clash text-sm" aria-hidden="true">
              &rarr;
            </span>
            {link.to.href ? (
              <a href={link.to.href}>
                <Badge variant={link.to.variant}>{link.to.label}</Badge>
              </a>
            ) : (
              <Badge variant={link.to.variant}>{link.to.label}</Badge>
            )}
          </div>
          <p class="prose-body text-ice-grey/65">
            {link.text}
          </p>
        </div>
      ))
    }
  </div>

  <p class="font-clash font-semibold text-display-sm text-white/90 mt-12 max-w-xl">
    Cinque settori, <span class="text-wtc-orange">un solo modo di lavorare.</span>
  </p>
</section>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Reduced motion: cards stay in their natural (visible) state.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    gsap.fromTo(
      ".ecosystem-card",
      { y: 40, opacity: 0 },
      {
        scrollTrigger: { trigger: ".ecosystem-cards", start: "top 86%", once: true },
        y: 0,
        opacity: 1,
        stagger: 0.1,
        duration: 0.8,
        ease: "power3.out",
      },
    );
  });
</script>
