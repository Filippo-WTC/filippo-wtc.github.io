---
// Native, page-integrated events calendar. Fetches the WTC events app's PUBLIC
// JSON feed at BUILD time (no iframe, no CORS dependency) and renders a native
// month grid + upcoming list that scrolls with the page. Interactivity (month
// nav) runs client-side over the data embedded below. Falls back gracefully to
// a link to the live calendar if the feed is unreachable at build.
const FEED = "https://wtc-events-app.vercel.app/api/public/events";
const LIVE = "https://wtc-events-app.vercel.app/calendar";

interface PublicDay {
  date: string;
  start_time: string | null;
  end_time: string | null;
  time_confirmed: boolean;
  sold_out?: boolean;
  registrable?: boolean;
}
interface PublicEvent {
  id: string;
  title: string;
  sport: string;
  city: string;
  venue: string | null;
  time: string | null;
  dates: string[];
  days?: PublicDay[];
  sold_out?: boolean;
}

let events: PublicEvent[] = [];
let feedOk = false;
try {
  const ctrl = new AbortController();
  const t = setTimeout(() => ctrl.abort(), 10000);
  const res = await fetch(FEED, { signal: ctrl.signal });
  clearTimeout(t);
  if (res.ok) {
    const data = await res.json();
    events = Array.isArray(data?.events) ? data.events : [];
    feedOk = true;
  }
} catch (_e) {
  feedOk = false;
}
---

<div
  class="events-cal rounded-bento bg-surface-01 border border-white/[0.06] overflow-hidden"
  data-events={JSON.stringify(events)}
  data-live={LIVE}
>
  <!-- Header -->
  <div class="flex items-center justify-between px-4 sm:px-6 py-4 border-b border-white/[0.06]">
    <div class="flex items-center gap-3 min-w-0">
      <h3 class="ec-title font-clash font-semibold text-display-sm text-white"></h3>
      <button type="button" class="ec-today hidden text-xs px-2.5 py-1 rounded-md border border-white/[0.08] text-text-muted hover:text-ice-grey hover:bg-white/[0.04] transition-colors">Oggi</button>
    </div>
    <div class="flex items-center gap-2 shrink-0">
      <div class="flex items-center gap-0.5 bg-surface-02 rounded-lg p-0.5 border border-white/[0.06]">
        <button type="button" class="ec-view-cal px-2.5 py-1 rounded-md text-xs font-medium transition-colors" data-view="calendario">Calendario</button>
        <button type="button" class="ec-view-agenda px-2.5 py-1 rounded-md text-xs font-medium transition-colors" data-view="agenda">Agenda</button>
      </div>
      <div class="ec-nav flex items-center gap-1">
        <button type="button" class="ec-prev w-8 h-8 rounded-lg flex items-center justify-center hover:bg-white/[0.06] transition-colors text-text-muted hover:text-white" aria-label="Mese precedente">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button type="button" class="ec-next w-8 h-8 rounded-lg flex items-center justify-center hover:bg-white/[0.06] transition-colors text-text-muted hover:text-white" aria-label="Mese successivo">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Month grid -->
  <div class="ec-cal">
    <div class="grid grid-cols-7 border-b border-white/[0.06]" class:list={["ec-daylabels"]}></div>
    <div class="ec-grid grid grid-cols-7"></div>
  </div>

  <!-- Upcoming list -->
  <div class="ec-list border-t border-white/[0.07] px-4 sm:px-6 py-5">
    <div class="flex items-center gap-2 mb-4">
      <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
      <span class="text-xs font-medium text-text-muted uppercase tracking-widest">Prossimi eventi</span>
    </div>
    <div class="ec-list-body flex flex-col gap-3"></div>
  </div>

  <!-- No-JS / empty fallback -->
  <noscript>
    <div class="px-6 py-10 text-center text-sm text-text-muted">
      Attiva JavaScript per vedere il calendario, oppure <a href={LIVE} class="text-wtc-orange" target="_blank" rel="noopener">apri il calendario completo →</a>
    </div>
  </noscript>
</div>

<script>
  const MONTHS = ['Gennaio','Febbraio','Marzo','Aprile','Maggio','Giugno','Luglio','Agosto','Settembre','Ottobre','Novembre','Dicembre'];
  const DAYS_FULL = ['Lunedì','Martedì','Mercoledì','Giovedì','Venerdì','Sabato','Domenica'];
  const DAYS_SHORT = ['Lun','Mar','Mer','Gio','Ven','Sab','Dom'];
  const SPORT_DOT: Record<string, string> = {
    carrera_cup:'#F59E0B', motogp:'#EF4444', f1:'#FB7185', calcio:'#3B82F6', tennis:'#38BDF8',
    padel:'#14B8A6', rugby:'#F97316', concerti:'#D946EF', teatro:'#8B5CF6', pallavolo:'#EAB308',
    atletica:'#F472B6', basket:'#84CC16', vela:'#06B6D4', bonus:'#6366F1',
  };
  const SPORT_LABEL: Record<string, string> = {
    carrera_cup:'Carrera Cup', motogp:'MotoGP', f1:'Formula 1', calcio:'Calcio', tennis:'Tennis',
    padel:'Padel', rugby:'Rugby', concerti:'Concerti', teatro:'Teatro', pallavolo:'Pallavolo',
    atletica:'Atletica', basket:'Basket', vela:'Vela', bonus:'Bonus',
  };
  const dot = (s: string) => SPORT_DOT[s] ?? '#8896A8';
  const label = (s: string) => SPORT_LABEL[s] ?? (s.charAt(0).toUpperCase() + s.slice(1).replace(/_/g, ' '));

  interface EDay { date: string; start_time: string | null; end_time: string | null; sold_out?: boolean; registrable?: boolean; }
  interface EEvent { id: string; title: string; sport: string; city: string; venue: string | null; time: string | null; dates: string[]; days?: EDay[]; sold_out?: boolean; }

  function initCalendars() {
    document.querySelectorAll<HTMLElement>('.events-cal').forEach((root) => {
      if (root.dataset.init) return;
      root.dataset.init = '1';

      let events: EEvent[] = [];
      try { events = JSON.parse(root.dataset.events || '[]'); } catch { events = []; }
      const live = root.dataset.live || '#';

      const now = new Date();
      const todayMs = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
      let viewYear = now.getFullYear();
      let viewMonth = now.getMonth();
      let view: 'calendario' | 'agenda' = 'calendario';

      const $ = <T extends Element = HTMLElement>(sel: string) => root.querySelector(sel) as T | null;
      const titleEl = $('.ec-title')!;
      const todayBtn = $('.ec-today') as HTMLButtonElement;
      const calWrap = $('.ec-cal') as HTMLElement;
      const dayLabels = $('.ec-daylabels') as HTMLElement;
      const gridEl = $('.ec-grid') as HTMLElement;
      const listBody = $('.ec-list-body') as HTMLElement;
      const navEl = $('.ec-nav') as HTMLElement;
      const viewCalBtn = $('.ec-view-cal') as HTMLButtonElement;
      const viewAgBtn = $('.ec-view-agenda') as HTMLButtonElement;

      dayLabels.innerHTML = DAYS_FULL.map((d, i) =>
        `<div class="text-center py-2.5"><span class="hidden sm:inline text-[11px] font-medium text-text-muted uppercase tracking-wider">${d}</span><span class="sm:hidden text-[11px] font-medium text-text-muted uppercase tracking-wider">${DAYS_SHORT[i]}</span></div>`
      ).join('');

      const iso = (y: number, m: number, d: number) => `${y}-${String(m + 1).padStart(2, '0')}-${String(d).padStart(2, '0')}`;
      const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));

      function eventsByDay(): Record<number, EEvent[]> {
        const map: Record<number, EEvent[]> = {};
        for (const e of events) {
          for (const ds of e.dates) {
            const d = new Date(ds + 'T12:00:00');
            if (d.getFullYear() === viewYear && d.getMonth() === viewMonth) {
              const day = d.getDate();
              (map[day] ||= []);
              if (!map[day].some((x) => x.id === e.id)) map[day].push(e);
            }
          }
        }
        return map;
      }

      function upcoming(): { e: EEvent; dates: string[] }[] {
        const todayIso = iso(now.getFullYear(), now.getMonth(), now.getDate());
        return events
          .map((e) => {
            const future = (e.days && e.days.length ? e.days.map((d) => d.date) : e.dates)
              .filter((d) => d >= todayIso).sort();
            return future.length ? { e, dates: future } : null;
          })
          .filter((x): x is { e: EEvent; dates: string[] } => x !== null)
          .sort((a, b) => a.dates[0].localeCompare(b.dates[0]));
      }

      function dayInfo(e: EEvent, d: string): EDay | undefined {
        return e.days?.find((x) => x.date === d);
      }

      function rangeLabel(dates: string[]): string {
        const f = new Date(dates[0] + 'T12:00:00');
        if (dates.length === 1) return f.toLocaleDateString('it-IT', { day: 'numeric', month: 'long', year: 'numeric' });
        const l = new Date(dates[dates.length - 1] + 'T12:00:00');
        if (f.getMonth() === l.getMonth() && f.getFullYear() === l.getFullYear())
          return `${f.getDate()} – ${l.getDate()} ${l.toLocaleDateString('it-IT', { month: 'long' })} ${l.getFullYear()}`;
        return `${f.toLocaleDateString('it-IT', { day: 'numeric', month: 'short' })} – ${l.toLocaleDateString('it-IT', { day: 'numeric', month: 'short', year: 'numeric' })}`;
      }

      function cardHtml(e: EEvent, dates: string[]): string {
        const first = new Date(dates[0] + 'T12:00:00');
        const dayNum = first.getDate();
        const mon = first.toLocaleDateString('it-IT', { month: 'short' }).replace('.', '');
        const extra = dates.length > 1 ? `<span class="text-[9px] text-text-muted mt-0.5">+${dates.length - 1}g</span>` : '';
        const di = dayInfo(e, dates[0]);
        const t = (di?.start_time) || e.time;
        const soldOut = e.sold_out;
        const venue = [e.venue, e.city].filter(Boolean).join(', ');
        const status = soldOut
          ? `<span class="text-[10px] px-1.5 py-0.5 rounded font-medium bg-amber-500/15 text-amber-400 border border-amber-500/20">Esaurito</span>`
          : `<span class="text-[10px] px-1.5 py-0.5 rounded font-medium bg-green-500/12 text-green-400 border border-green-500/20">Disponibile</span>`;
        return `
          <a href="/team/contatti" class="relative flex bg-surface-02 rounded-xl border border-white/[0.06] overflow-hidden hover:border-wtc-orange/30 transition-colors group">
            <div class="flex flex-col items-center justify-center px-3 py-3 w-[68px] shrink-0">
              <span class="text-xl font-semibold text-white leading-none tabular-nums">${dayNum}</span>
              <span class="text-[10px] uppercase tracking-wide text-text-muted mt-1">${esc(mon)}</span>
              ${extra}
              <span class="w-1.5 h-1.5 rounded-full mt-1.5" style="background:${dot(e.sport)}"></span>
            </div>
            <div class="self-stretch w-px border-l border-dashed border-white/[0.14]"></div>
            <div class="flex-1 min-w-0 py-3 px-4">
              <div class="flex items-center gap-2 mb-1 flex-wrap">
                <span class="inline-flex items-center gap-1 text-[10px] px-1.5 py-0.5 rounded font-medium text-text-muted border border-white/[0.08]"><span class="w-1.5 h-1.5 rounded-full" style="background:${dot(e.sport)}"></span>${esc(label(e.sport))}</span>
                ${status}
              </div>
              <div class="text-sm font-semibold text-white leading-tight">${esc(e.title)}</div>
              <div class="text-xs text-text-muted mt-1">${esc(rangeLabel(dates))}${t ? ' · ' + esc(t) : ''}</div>
              ${venue ? `<div class="text-xs text-text-muted mt-0.5">${esc(venue)}</div>` : ''}
            </div>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 self-center mr-3 text-text-muted group-hover:text-wtc-orange transition-colors"><path d="M9 18l6-6-6-6"/></svg>
          </a>`;
      }

      function renderGrid() {
        titleEl.innerHTML = `${MONTHS[viewMonth]} <span class="text-text-muted font-normal">${viewYear}</span>`;
        const isCurrent = viewYear === now.getFullYear() && viewMonth === now.getMonth();
        todayBtn.classList.toggle('hidden', isCurrent);

        const daysInMonth = new Date(viewYear, viewMonth + 1, 0).getDate();
        const firstDay = (new Date(viewYear, viewMonth, 1).getDay() + 6) % 7;
        const byDay = eventsByDay();
        const cells: (number | null)[] = [...Array(firstDay).fill(null), ...Array.from({ length: daysInMonth }, (_, i) => i + 1)];
        while (cells.length % 7 !== 0) cells.push(null);

        gridEl.innerHTML = cells.map((day, i) => {
          if (day === null) return `<div class="min-h-[64px] sm:min-h-[92px] border-b border-r border-white/[0.04] bg-white/[0.01] ${i % 7 === 6 ? 'border-r-0' : ''}"></div>`;
          const isToday = day === now.getDate() && isCurrent;
          const isPast = new Date(viewYear, viewMonth, day).getTime() < todayMs;
          const evs = byDay[day] ?? [];
          const evHtml = evs.slice(0, 3).map((e) => {
            const d = iso(viewYear, viewMonth, day);
            const so = dayInfo(e, d)?.sold_out;
            return `<div class="flex items-center gap-1 text-[10px] px-1.5 py-0.5 rounded font-medium text-ice-grey/80 leading-[1.35] min-w-0 overflow-hidden" style="background:rgba(255,255,255,0.04)" title="${esc(e.title)}">
              <span class="shrink-0 w-1.5 h-1.5 rounded-full" style="background:${dot(e.sport)}"></span>
              <span class="truncate min-w-0 ${so ? 'line-through opacity-70' : ''}">${esc(e.title)}</span>
            </div>`;
          }).join('');
          const more = evs.length > 3 ? `<div class="text-[10px] text-text-muted pl-0.5">+${evs.length - 3}</div>` : '';
          return `<div class="min-h-[64px] sm:min-h-[92px] p-1 sm:p-2 border-b border-r border-white/[0.04] ${isPast && !isToday ? 'bg-black/20' : ''} ${i % 7 === 6 ? 'border-r-0' : ''}">
            <div class="text-[11px] sm:text-xs font-semibold w-5 h-5 sm:w-6 sm:h-6 flex items-center justify-center rounded-full mb-1 mx-auto sm:mx-0 ${isToday ? 'bg-wtc-orange text-white' : isPast ? 'text-text-muted/50' : 'text-text-muted'}">${day}</div>
            <div class="flex flex-col gap-0.5">${evHtml}${more}</div>
          </div>`;
        }).join('');
      }

      function renderList() {
        const up = upcoming();
        if (!up.length) {
          listBody.innerHTML = `<p class="text-sm text-text-muted py-2">Nessun evento in programma. <a href="${live}" target="_blank" rel="noopener" class="text-wtc-orange">Apri il calendario completo →</a></p>`;
          return;
        }
        const shown = view === 'agenda' ? up : up.slice(0, 6);
        listBody.innerHTML = shown.map(({ e, dates }) => cardHtml(e, dates)).join('')
          + (view === 'calendario' && up.length > 6
            ? `<button type="button" class="ec-see-all w-full text-center text-xs text-wtc-orange hover:opacity-80 py-2 transition-opacity">Vedi tutti gli eventi (${up.length}) →</button>`
            : '');
        const seeAll = root.querySelector('.ec-see-all');
        if (seeAll) seeAll.addEventListener('click', () => setView('agenda'));
      }

      function setView(v: 'calendario' | 'agenda') {
        view = v;
        const on = 'bg-white/[0.08] text-white';
        const off = 'text-text-muted hover:text-ice-grey';
        viewCalBtn.className = `ec-view-cal px-2.5 py-1 rounded-md text-xs font-medium transition-colors ${v === 'calendario' ? on : off}`;
        viewAgBtn.className = `ec-view-agenda px-2.5 py-1 rounded-md text-xs font-medium transition-colors ${v === 'agenda' ? on : off}`;
        calWrap.classList.toggle('hidden', v === 'agenda');
        navEl.classList.toggle('hidden', v === 'agenda');
        if (v === 'calendario') renderGrid();
        renderList();
      }

      $('.ec-prev')!.addEventListener('click', () => { if (viewMonth === 0) { viewMonth = 11; viewYear--; } else viewMonth--; renderGrid(); });
      $('.ec-next')!.addEventListener('click', () => { if (viewMonth === 11) { viewMonth = 0; viewYear++; } else viewMonth++; renderGrid(); });
      todayBtn.addEventListener('click', () => { viewYear = now.getFullYear(); viewMonth = now.getMonth(); renderGrid(); });
      viewCalBtn.addEventListener('click', () => setView('calendario'));
      viewAgBtn.addEventListener('click', () => setView('agenda'));

      setView('calendario');
    });
  }

  document.addEventListener('astro:page-load', initCalendars);
</script>
