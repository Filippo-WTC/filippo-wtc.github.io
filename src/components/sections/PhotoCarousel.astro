---
// Carosello fotografico ambientale — cross-fade lento, non un carosello che
// rimbalza. Costruito secondo le regole del brand ("il movimento rivela la
// struttura, non si esibisce") e accessibile:
//  - pulsante pausa/riproduci (WCAG 2.2.2, contenuto che si aggiorna da solo);
//  - frecce, pallini e frecce-tastiera per la navigazione manuale;
//  - con `prefers-reduced-motion` l'autoplay non parte e il cambio è netto,
//    la navigazione resta tutta manuale;
//  - una live-region annuncia la foto corrente agli screen reader.
import { Picture } from "astro:assets";
import type { ImageMetadata } from "astro";

export interface Slide {
  image: ImageMetadata;
  alt: string;
  caption?: string;
}

export interface Props {
  slides: Slide[];
  label: string; // etichetta accessibile del carosello
  intervalMs?: number;
  class?: string;
}

const { slides, label, intervalMs = 6000, class: className } = Astro.props;
---

<div
  class:list={["photo-carousel relative rounded-bento overflow-hidden border border-hairline bg-surface-01", className]}
  data-carousel
  data-interval={intervalMs}
  role="group"
  aria-roledescription="carosello"
  aria-label={label}
>
  <div class="carousel-viewport relative aspect-[16/9] md:aspect-[21/9]">
    {
      slides.map((s, i) => (
        <figure
          class="carousel-slide absolute inset-0 m-0"
          data-slide
          aria-hidden={i !== 0 ? "true" : "false"}
          style={`opacity:${i === 0 ? 1 : 0}`}
        >
          <Picture
            src={s.image}
            alt={s.alt}
            widths={[768, 1280, 1920, 2400]}
            sizes="100vw"
            formats={["avif", "webp"]}
            fallbackFormat="webp"
            quality={62}
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
            class="w-full h-full object-cover"
          />
          <div
            class="absolute inset-0 pointer-events-none"
            style="background:linear-gradient(to top, rgba(10,11,15,0.85) 0%, rgba(10,11,15,0.15) 32%, transparent 55%);"
            aria-hidden="true"
          />
          {s.caption && (
            <figcaption class="absolute left-5 md:left-9 bottom-12 md:bottom-8 max-w-[76%] md:max-w-md">
              <span class="font-inter text-xs md:text-base text-white/95 drop-shadow">
                {s.caption}
              </span>
            </figcaption>
          )}
        </figure>
      ))
    }

    <!-- Frecce -->
    <button
      type="button"
      data-prev
      class="carousel-arrow absolute left-3 md:left-4 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-wtc-black/45 hover:bg-wtc-black/70 text-white transition-colors"
      aria-label="Immagine precedente"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>
    <button
      type="button"
      data-next
      class="carousel-arrow absolute right-3 md:right-4 top-1/2 -translate-y-1/2 w-11 h-11 flex items-center justify-center rounded-full bg-wtc-black/45 hover:bg-wtc-black/70 text-white transition-colors"
      aria-label="Immagine successiva"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M9 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </button>

    <!-- Pallini + pausa -->
    <div class="absolute right-4 md:right-5 bottom-4 md:bottom-6 flex items-center gap-3">
      <div class="flex items-center gap-2" data-dots>
        {
          slides.map((_, i) => (
            <button
              type="button"
              data-dot
              class="carousel-dot w-2.5 h-2.5 rounded-full transition-colors"
              aria-label={`Vai all'immagine ${i + 1} di ${slides.length}`}
              aria-current={i === 0 ? "true" : "false"}
            />
          ))
        }
      </div>
      <button
        type="button"
        data-playpause
        class="carousel-playpause w-8 h-8 hidden items-center justify-center rounded-full bg-wtc-black/45 hover:bg-wtc-black/70 text-white transition-colors"
        aria-label="Metti in pausa lo scorrimento automatico"
      >
        <svg data-icon-pause width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
        <svg data-icon-play width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="hidden" aria-hidden="true"><path d="M7 5l12 7-12 7z"/></svg>
      </button>
    </div>

    <!-- Annuncio per screen reader -->
    <div class="sr-only" aria-live="polite" data-live></div>
  </div>
</div>

<style>
  .carousel-slide {
    transition: opacity 0.9s ease;
  }
  .carousel-dot {
    background: rgb(255 255 255 / 0.4);
  }
  .carousel-dot:hover {
    background: rgb(255 255 255 / 0.7);
  }
  .carousel-dot[aria-current="true"] {
    background: var(--color-orange);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-slide {
      transition: none;
    }
  }
</style>

<script>
  // Un solo teardown/rebuild per navigazione (il DOM arriva nuovo a ogni swap).
  interface Instance { stop: () => void }
  let instances: Instance[] = [];

  document.addEventListener("astro:before-swap", () => {
    instances.forEach((i) => i.stop());
    instances = [];
  });

  function build(root: HTMLElement): Instance {
    const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-slide]"));
    const dots = Array.from(root.querySelectorAll<HTMLElement>("[data-dot]"));
    const live = root.querySelector<HTMLElement>("[data-live]");
    const playpause = root.querySelector<HTMLButtonElement>("[data-playpause]");
    const iconPause = root.querySelector<HTMLElement>("[data-icon-pause]");
    const iconPlay = root.querySelector<HTMLElement>("[data-icon-play]");
    const interval = Number(root.dataset.interval) || 6000;
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let current = 0;
    let timer: number | null = null;
    let paused = false;

    const render = () => {
      slides.forEach((s, i) => {
        const active = i === current;
        s.style.opacity = active ? "1" : "0";
        s.setAttribute("aria-hidden", active ? "false" : "true");
      });
      dots.forEach((d, i) =>
        d.setAttribute("aria-current", i === current ? "true" : "false"),
      );
      if (live) {
        const cap = slides[current].querySelector("figcaption")?.textContent?.trim();
        live.textContent = `Immagine ${current + 1} di ${slides.length}${cap ? ": " + cap : ""}`;
      }
    };

    const go = (i: number) => {
      current = (i + slides.length) % slides.length;
      render();
    };
    const next = () => go(current + 1);
    const prev = () => go(current - 1);

    // ---- autoplay (mai sotto reduced-motion)
    const start = () => {
      if (reduced || paused || timer !== null) return;
      timer = window.setInterval(next, interval);
    };
    const stopTimer = () => {
      if (timer !== null) {
        clearInterval(timer);
        timer = null;
      }
    };
    const setPaused = (p: boolean) => {
      paused = p;
      if (p) stopTimer();
      else start();
      if (playpause) {
        playpause.setAttribute(
          "aria-label",
          p ? "Riprendi lo scorrimento automatico" : "Metti in pausa lo scorrimento automatico",
        );
        iconPause?.classList.toggle("hidden", p);
        iconPlay?.classList.toggle("hidden", !p);
      }
    };

    // ---- listeners
    const onPrev = () => { prev(); };
    const onNext = () => { next(); };
    root.querySelector("[data-prev]")?.addEventListener("click", onPrev);
    root.querySelector("[data-next]")?.addEventListener("click", onNext);
    dots.forEach((d, i) => d.addEventListener("click", () => go(i)));

    const onKey = (e: KeyboardEvent) => {
      if (e.key === "ArrowLeft") { prev(); e.preventDefault(); }
      else if (e.key === "ArrowRight") { next(); e.preventDefault(); }
    };
    root.addEventListener("keydown", onKey);

    // Pausa quando il puntatore o il focus sono dentro, e a tab nascosta —
    // così l'autoplay non ruota mentre l'utente sta guardando/interagendo.
    const onEnter = () => stopTimer();
    const onLeave = () => { if (!paused) start(); };
    root.addEventListener("mouseenter", onEnter);
    root.addEventListener("mouseleave", onLeave);
    root.addEventListener("focusin", onEnter);
    root.addEventListener("focusout", onLeave);
    const onVis = () => (document.hidden ? stopTimer() : (!paused && start()));
    document.addEventListener("visibilitychange", onVis);

    const onPlayPause = () => setPaused(!paused);

    if (reduced) {
      // Niente autoplay: la navigazione è tutta manuale, il tasto pausa non serve.
      playpause?.remove();
    } else {
      playpause?.classList.remove("hidden");
      playpause?.classList.add("flex");
      playpause?.addEventListener("click", onPlayPause);
      start();
    }

    render();

    return {
      stop() {
        stopTimer();
        document.removeEventListener("visibilitychange", onVis);
      },
    };
  }

  document.addEventListener("astro:page-load", () => {
    document
      .querySelectorAll<HTMLElement>("[data-carousel]")
      .forEach((root) => instances.push(build(root)));
  });
</script>
