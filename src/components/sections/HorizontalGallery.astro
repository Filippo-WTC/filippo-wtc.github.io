---
// Horizontal-scroll showcase. Desktop (md+): the section pins and the card track
// scrubs sideways as you scroll vertically. Mobile: native horizontal swipe with
// snap — no pin (pinning is janky on touch). Integrated with Lenis + ScrollTrigger.
import SectionLabel from "../ui/SectionLabel.astro";

export interface GalleryItem {
  title: string;
  description: string;
  tag?: string;
}

interface Props {
  number?: string;
  label: string;
  heading: string;
  headingAccent?: string;
  intro?: string;
  items: GalleryItem[];
}

const { number, label, heading, headingAccent, intro, items } = Astro.props;

function buildHeading(text: string, accent?: string): string {
  if (!accent) return text;
  let out = text;
  for (const w of accent.split(" ").filter(Boolean)) {
    out = out.replace(new RegExp(`\\b(${w})\\b`, "gi"), `<span class="text-wtc-orange">$1</span>`);
  }
  return out;
}
---

<section class="hgallery relative">
  <!-- Heading (normal flow) -->
  <div class="section-px max-w-container mx-auto pt-[var(--section-py)]">
    <div class="flex flex-col gap-4 max-w-2xl">
      <SectionLabel number={number} label={label} />
      <h2
        class="font-clash font-semibold text-display-md text-white"
        set:html={buildHeading(heading, headingAccent)}
      />
      {intro && <p class="prose-lead text-ice-grey/55">{intro}</p>}
    </div>
  </div>

  <!-- Track viewport -->
  <div class="hg-viewport relative mt-10 md:mt-14 pb-[var(--section-py)] overflow-hidden md:overflow-visible">
    <div
      class="hg-track flex gap-5 px-[max(1.5rem,calc((100vw-1600px)/2+1.5rem))] pr-6 overflow-x-auto md:overflow-visible snap-x snap-mandatory md:snap-none scrollbar-none"
    >
      {
        items.map((it, i) => (
          <article class="hg-card snap-start shrink-0 w-[280px] sm:w-[340px] rounded-bento bg-surface-01 border border-hairline p-8 flex flex-col gap-3 hover:border-wtc-orange/20 transition-colors duration-300">
            <div class="flex items-center justify-between">
              <span class="font-clash font-semibold text-sm text-wtc-orange/70 tracking-widest">
                {String(i + 1).padStart(2, "0")}
              </span>
              {it.tag && (
                <span class="prose-caption text-text-muted uppercase tracking-widest">{it.tag}</span>
              )}
            </div>
            <h3 class="font-clash font-semibold text-lg text-white">{it.title}</h3>
            <p class="prose-body-sm text-ice-grey/55">{it.description}</p>
          </article>
        ))
      }
    </div>
    <!-- progress rail (desktop) -->
    <div class="hg-rail hidden md:block section-px max-w-container mx-auto mt-10">
      <div class="h-[2px] bg-veil-strong rounded-full overflow-hidden">
        <div class="hg-progress h-full w-0 bg-wtc-orange/70 rounded-full"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

  /* Reduced-motion fallback (class added by the script): no pin, no
     scrub, no hidden-scrollbar trap — the cards simply wrap into a
     visible grid. Zero motion, all content on screen. */
  .hg-static { overflow: visible; }
  .hg-static .hg-track {
    flex-wrap: wrap;
    overflow: visible;
    scroll-snap-type: none;
    padding-right: max(1.5rem, calc((100vw - 1600px) / 2 + 1.5rem));
  }
  .hg-static .hg-rail { display: none; }
</style>

<script>
  import { gsap } from "@/lib/gsap";

  let mm: gsap.MatchMedia | null = null;

  // The matchMedia context (and its MediaQueryList listeners) must be
  // reverted on navigation, or one set accumulates per page visit.
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
  });

  document.addEventListener("astro:page-load", () => {
    // Reduced motion: no pin, no scrub — the track falls back to native
    // horizontal overflow scrolling (see .hg-viewport CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document
        .querySelectorAll<HTMLElement>(".hg-viewport")
        .forEach((vp) => vp.classList.add("hg-static"));
      return;
    }

    mm = gsap.matchMedia();

    // Desktop: pin the section and scrub the track horizontally.
    mm.add("(min-width: 768px)", () => {
      document.querySelectorAll<HTMLElement>(".hgallery").forEach((sec) => {
        const vp = sec.querySelector<HTMLElement>(".hg-viewport");
        const track = sec.querySelector<HTMLElement>(".hg-track");
        const progress = sec.querySelector<HTMLElement>(".hg-progress");
        if (!vp || !track) return;

        const distance = () => Math.max(0, track.scrollWidth - vp.clientWidth);

        // Per-card depth: cards near the viewport centre are full size and
        // opacity; far cards sit slightly back (scale 0.96, dim 0.55).
        // Offsets are precomputed on refresh — the per-frame update reads
        // only the tweened x, never layout.
        const cards = Array.from(track.querySelectorAll<HTMLElement>(".hg-card"));
        let cardCenters: number[] = [];
        const setters = cards.map((c) => ({
          scale: gsap.quickSetter(c, "scale"),
          opacity: gsap.quickSetter(c, "opacity"),
        }));

        const measureCards = () => {
          cardCenters = cards.map((c) => c.offsetLeft + c.offsetWidth / 2);
        };
        measureCards();

        const updateDepth = () => {
          const trackX = Number(gsap.getProperty(track, "x")) || 0;
          const viewCenter = vp.clientWidth / 2;
          const falloff = vp.clientWidth * 0.9;
          for (let i = 0; i < cards.length; i++) {
            const d = Math.abs(cardCenters[i] + trackX - viewCenter);
            const t = Math.min(1, d / falloff);
            // Near-threshold: readability first, depth second.
            setters[i].scale(1 - 0.015 * t);
            setters[i].opacity(1 - 0.12 * t);
          }
        };

        gsap.to(track, {
          x: () => -distance(),
          ease: "none",
          scrollTrigger: {
            trigger: sec,
            start: "top top",
            end: () => "+=" + distance(),
            pin: true,
            scrub: 0.6,
            invalidateOnRefresh: true,
            onRefresh: () => {
              measureCards();
              updateDepth();
            },
            onUpdate: (self) => {
              if (progress) progress.style.width = (self.progress * 100).toFixed(1) + "%";
              updateDepth();
            },
          },
        });
        updateDepth();
      });
    });
  });
</script>
