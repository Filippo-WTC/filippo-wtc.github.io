---
// Galleria a scorrimento orizzontale.
//
// Storia, perché la scelta non sembri arbitraria: la versione precedente
// inchiodava la sezione con ScrollTrigger (`pin: true`) e traduceva il track
// di lato al variare dello scroll verticale. Funzionava in Chrome e in
// WebKit headless, e NON funzionava in Safari reale — tre giri di correzioni
// senza rete di sicurezza, perché Playwright non modella lo scroll inerziale
// e quindi non riproduce il difetto.
//
// Le cause plausibili erano tutte legate al `position: fixed` che il pin usa:
// `overflow-x: clip` è implementato male in Safari (clippa anche l'asse Y —
// bug Apple aperto), `mix-blend-mode` dentro un elemento fisso è un punto
// debole noto di WebKit, e Lenis avvisa che `position: fixed` arranca su
// Safari macOS. Ma il motivo che ha deciso è un altro: il track inchiodato
// non aveva ALCUN accesso da tastiera — una violazione WCAG 2.1.1 contro il
// target AA dichiarato.
//
// La prima riscrittura è però caduta nell'errore opposto: contenitore
// nativo e basta. Con un mouse senza rotella orizzontale le schede oltre la
// prima schermata diventano IRRAGGIUNGIBILI — il movimento guidato dallo
// scroll non era un vezzo, era il modo in cui la maggior parte delle
// persone vede il contenuto.
//
// Assetto attuale, che tiene insieme le due cose: il contenitore resta
// nativo (dito, trackpad, frecce, focus: tutto continua a funzionare) e in
// più lo scroll verticale della pagina ne pilota `scrollLeft`. Il punto
// chiave è che NON c'è pin: si anima una proprietà di scorrimento, non un
// transform, e nessun elemento diventa `position: fixed` — cioè sparisce
// esattamente ciò che rompeva Safari, non la funzione.
import SectionLabel from "../ui/SectionLabel.astro";
import SectionTexture from "../global/SectionTexture.astro";

export interface GalleryItem {
  title: string;
  description: string;
  tag?: string;
}

interface Props {
  number?: string;
  label: string;
  heading: string;
  headingAccent?: string;
  intro?: string;
  items: GalleryItem[];
}

const { number, label, heading, headingAccent, intro, items } = Astro.props;

function buildHeading(text: string, accent?: string): string {
  if (!accent) return text;
  let out = text;
  for (const w of accent.split(" ").filter(Boolean)) {
    out = out.replace(new RegExp(`\\b(${w})\\b`, "gi"), `<span class="text-wtc-orange">$1</span>`);
  }
  return out;
}
---

<section class="hgallery relative border-t border-hairline">
  <SectionTexture />

  <!-- Testata (flusso normale) -->
  <div class="relative section-px max-w-container mx-auto pt-[var(--section-py)]">
    <div class="flex flex-col gap-4 max-w-2xl">
      <SectionLabel number={number} label={label} />
      <h2
        class="font-clash font-semibold text-display-md text-white"
        set:html={buildHeading(heading, headingAccent)}
      />
      {intro && <p class="prose-lead text-ice-grey/55">{intro}</p>}
    </div>
  </div>

  <div class="hg-viewport relative mt-10 md:mt-14 pb-[var(--section-py)]">
    <!--
      `tabindex="0"` è deliberato e necessario: un contenitore che scorre deve
      poter ricevere il focus, altrimenti chi naviga da tastiera non ha modo
      di raggiungere le schede oltre la prima schermata. Con role/aria-label
      viene annunciato come una regione navigabile.
    -->
    <div
      class="hg-track flex gap-5 overflow-x-auto snap-x snap-mandatory md:snap-none scrollbar-none px-[max(1.5rem,calc((100vw-1600px)/2+1.5rem))] pr-6 scroll-px-[max(1.5rem,calc((100vw-1600px)/2+1.5rem))]"
      tabindex="0"
      role="region"
      aria-label={`${label} — scorri per vedere tutte le schede`}
    >
      {
        items.map((it, i) => (
          <article class="hg-card snap-start shrink-0 w-[280px] sm:w-[340px] rounded-bento bg-surface-01 border border-hairline p-8 flex flex-col gap-3 hover:border-wtc-orange/20 transition-colors duration-300">
            <div class="flex items-center justify-between">
              <span class="font-clash font-semibold text-sm text-wtc-orange/70 tracking-widest">
                {String(i + 1).padStart(2, "0")}
              </span>
              {it.tag && (
                <span class="prose-caption text-text-muted uppercase tracking-widest">{it.tag}</span>
              )}
            </div>
            <h3 class="font-clash font-semibold text-lg text-white">{it.title}</h3>
            <p class="prose-body-sm text-ice-grey/55">{it.description}</p>
          </article>
        ))
      }
    </div>

    <!-- Avanzamento: legato allo scroll del track, qualunque cosa lo muova -->
    <div class="hg-rail hidden md:block section-px max-w-container mx-auto mt-10" aria-hidden="true">
      <div class="h-[2px] bg-veil-strong rounded-full overflow-hidden">
        <div class="hg-progress h-full w-full bg-wtc-orange/70 rounded-full"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .scrollbar-none::-webkit-scrollbar { display: none; }
  .scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

  /* Il focus sul contenitore non deve disegnare un rettangolo attorno a
     tutta la fascia: basta un accenno sul bordo superiore delle schede. */
  .hg-track:focus-visible {
    outline: none;
  }

  .hg-track:focus-visible .hg-card {
    border-color: rgb(242 101 34 / 0.45);
  }

  /* Avanzamento guidato dallo scroll. Il timeline è dichiarato sul track e
     resta visibile ai fratelli successivi e ai loro discendenti — .hg-rail
     viene dopo .hg-track, quindi .hg-progress lo raggiunge senza
     `timeline-scope`. scaleX su transform, non width: resta sul
     compositore. Dove non è supportato la barra resta piena e statica,
     che è un ripiego onesto e non un elemento rotto. */
  .hg-progress {
    transform-origin: left center;
  }

  @supports (animation-timeline: scroll()) {
    .hg-track {
      scroll-timeline: --hg-scroll x;
    }

    .hg-progress {
      animation: hg-fill linear both;
      animation-timeline: --hg-scroll;
    }

    @keyframes hg-fill {
      from { transform: scaleX(0); }
      to   { transform: scaleX(1); }
    }
  }

  /* Il blocco globale del movimento ridotto azzera ogni animation-duration;
     su un'animazione guidata dallo scroll la durata non ha significato e
     azzerarla la spegnerebbe. L'avanzamento non è movimento autonomo — è
     informazione legata al gesto dell'utente — quindi va tenuto vivo. */
  @media (prefers-reduced-motion: reduce) {
    .hg-progress {
      animation-duration: auto !important;
    }

    /* Con movimento ridotto lo scroll-drive è spento (vedi lo script). Ma
       senza il drive un mouse senza rotella orizzontale ricadrebbe nella
       stessa trappola: schede irraggiungibili. Quindi qui il track non
       scorre affatto — le schede vanno a capo in griglia, tutte visibili,
       zero movimento e niente da raggiungere di lato. */
    .hg-track {
      flex-wrap: wrap;
      overflow-x: visible;
      scroll-snap-type: none;
      padding-right: max(1.5rem, calc((100vw - 1600px) / 2 + 1.5rem));
    }

    .hg-rail {
      display: none;
    }
  }
</style>

<script>
  import { gsap, ScrollTrigger } from "@/lib/gsap";

  let mm: gsap.MatchMedia | null = null;

  // Il contesto matchMedia (e i suoi listener) va revertito a ogni
  // navigazione, o se ne accumula uno per visita.
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
  });

  document.addEventListener("astro:page-load", () => {
    // Movimento ridotto: nessun drive. Le schede restano tutte visibili
    // grazie al ripiego a griglia nel CSS qui sopra — niente scorrimento
    // orizzontale da guidare, e nulla di irraggiungibile.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    mm = gsap.matchMedia();

    // Solo da tablet in su: lo scroll verticale della pagina pilota lo
    // scorrimento orizzontale del track. Su telefono lo swipe nativo è già
    // il gesto giusto, e far muovere l'orizzontale con il verticale su touch
    // confonde — lì resta scorrimento nativo con snap.
    mm.add("(min-width: 768px)", () => {
      const triggers: ScrollTrigger[] = [];

      document.querySelectorAll<HTMLElement>(".hgallery").forEach((sec) => {
        const viewport = sec.querySelector<HTMLElement>(".hg-viewport");
        const track = sec.querySelector<HTMLElement>(".hg-track");
        if (!viewport || !track) return;

        // Quanto il track può scorrere di lato. Letto live: si riadatta al
        // resize senza ricreare il trigger.
        const maxScroll = () => Math.max(0, track.scrollWidth - track.clientWidth);
        if (maxScroll() === 0) return; // tutte le schede già visibili

        // NIENTE pin: si mappa la posizione della sezione nel viewport su
        // scrollLeft. La corsa orizzontale si compie mentre la galleria
        // attraversa lo schermo — nessun `position: fixed`, quindi niente
        // della fragilità che rompeva Safari. `scrollLeft` (non un
        // transform) tiene il track nativo: dito, frecce e trackpad
        // continuano a valere in aggiunta.
        // La finestra attiva è centrata su quando la galleria è a schermo:
        // comincia poco dopo che è entrata (top al 75% dell'altezza) e si
        // completa poco prima che esca (bottom al 25%). Così l'ultima scheda
        // è pienamente visibile mentre la sezione è ancora comodamente in
        // vista, non solo mentre sta scomparendo in alto.
        const st = ScrollTrigger.create({
          trigger: viewport,
          start: "top 75%",
          end: "bottom 25%",
          invalidateOnRefresh: true,
          onUpdate: (self) => {
            track.scrollLeft = self.progress * maxScroll();
          },
        });
        triggers.push(st);
      });

      return () => triggers.forEach((t) => t.kill());
    });
  });
</script>
