---
import SectionLabel from "../ui/SectionLabel.astro";
import Button from "../ui/Button.astro";
import HeroCanvas from "../ui/HeroCanvas.astro";

export interface CTA {
  label: string;
  href: string;
  variant?: "primary" | "ghost" | "outline";
}

export interface Props {
  eyebrow?: string;
  eyebrowNumber?: string;
  title: string;
  titleAccent?: string; // words to highlight in orange (space separated)
  subtitle?: string;
  ctas?: CTA[];
  bgVariant?: "telemetry" | "radial" | "none";
  canvas?: "services" | "team" | "globe" | "production" | "food" | "none";
  minHeight?: string;
  class?: string;
  topOffset?: "navbar" | "nav-full" | "none";
}

const {
  eyebrow,
  eyebrowNumber,
  title,
  titleAccent = "",
  subtitle,
  ctas = [],
  bgVariant = "radial",
  canvas = "none",
  minHeight = "h-[100svh] min-h-[600px]",
  class: className,
  topOffset = "nav-full",
} = Astro.props;

// Highlight the key word(s) in orange. `titleAccent` is the exact contiguous
// phrase to accent, matched ONCE. The previous version split it into words and
// ran a `\bword\b` regex per word, which broke two ways on Italian:
//  - `\b` sits between a word char and a non-word char, but accented letters
//    (à, è, ì, ò, ù) are not \w, so `\bspecialità\b` never matched — the key
//    word stayed white while stray function words lit up.
//  - a global per-word replace coloured every occurrence, so a word repeated
//    in the sentence ("proteggere … proteggere") got accented twice.
// Matching the whole phrase once, with Unicode letter/number boundaries,
// fixes both: exactly the intended key phrase turns orange, accents included.
function buildTitle(text: string, accent: string): string {
  const phrase = accent.trim();
  if (!phrase) return text;
  const esc = phrase.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const re = new RegExp(`(?<![\\p{L}\\p{N}])(${esc})(?![\\p{L}\\p{N}])`, "iu");
  return text.replace(re, `<span class="text-wtc-orange">$1</span>`);
}

const topClasses: Record<string, string> = {
  navbar: "pt-navbar",
  "nav-full": "pt-nav-full",
  none: "",
};
---

<section
  class:list={[
    "hero-parallax relative flex flex-col justify-center overflow-hidden shrink-0",
    minHeight,
    topClasses[topOffset],
    className,
  ]}
>
  <!-- Background layers -->
  {
    bgVariant === "radial" && (
      <>
        <div
          class="absolute inset-0 bg-telemetry opacity-20 pointer-events-none"
          aria-hidden="true"
        />
        <div
          class="hero-radial-bg absolute inset-0 pointer-events-none"
          aria-hidden="true"
        />
      </>
    )
  }
  {
    bgVariant === "telemetry" && (
      <div
        class="absolute inset-0 bg-telemetry opacity-60 pointer-events-none"
        aria-hidden="true"
      />
    )
  }

  <!-- Canvas animation (right-side, gradient-masked) -->
  {
    canvas !== "none" && (
      <div
        class="absolute inset-0 pointer-events-none overflow-hidden hidden sm:block"
        style="mask-image: linear-gradient(to left, black 30%, transparent 65%); -webkit-mask-image: linear-gradient(to left, black 30%, transparent 65%);"
        aria-hidden="true"
      >
        <HeroCanvas variant={canvas} />
      </div>
    )
  }

  <!-- Content — entrance is pure CSS (.hero-enter) so the H1 paints
       without waiting for the GSAP bundle; GSAP only drives the parallax -->
  <div class="hero-content relative section-px max-w-container mx-auto w-full py-10 md:py-16">
    {
      eyebrow && (
        <div class="hero-eyebrow hero-enter mb-8">
          <SectionLabel number={eyebrowNumber} label={eyebrow} />
        </div>
      )
    }

    <h1
      class="hero-title hero-enter font-clash font-semibold text-display-lg md:text-display-xl text-white leading-[1.0] tracking-tight max-w-3xl mb-6 text-balance hyphens-none"
      set:html={buildTitle(title, titleAccent)}
    />

    {
      subtitle && (
        <p
          class="hero-subtitle hero-enter prose-lead text-ice-grey/70 max-w-2xl mb-12"
        >
          {subtitle}
        </p>
      )
    }

    {
      ctas.length > 0 && (
        <div class="hero-ctas hero-enter flex flex-wrap gap-4">
          {ctas.map((cta) => (
            <Button
              href={cta.href}
              variant={cta.variant ?? "primary"}
              size="lg"
            >
              {cta.label}
            </Button>
          ))}
        </div>
      )
    }
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Parallax depth: as you scroll past the hero, the content drifts up and
    // fades while the background (canvas / glow) stays — gives a sense of depth.
    if (!reduce) {
      document.querySelectorAll<HTMLElement>(".hero-parallax").forEach((hero) => {
        const content = hero.querySelector<HTMLElement>(".hero-content");
        if (content) {
          gsap.to(content, {
            yPercent: -12,
            opacity: 0.35,
            ease: "none",
            scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.6 },
          });
        }
        // Background layers drift slightly slower (subtle counter-parallax).
        hero.querySelectorAll<HTMLElement>(".hero-radial-bg, [data-hero-bg]").forEach((bg) => {
          gsap.to(bg, {
            yPercent: 12,
            ease: "none",
            scrollTrigger: { trigger: hero, start: "top top", end: "bottom top", scrub: 0.6 },
          });
        });
      });
    }
    // Entrance is handled entirely in CSS (.hero-enter in global.css) so the
    // hero paints before this bundle loads.
  });
</script>
