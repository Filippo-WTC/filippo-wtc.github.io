---
import SectionLabel from "../ui/SectionLabel.astro";

export interface LogoItem {
  name: string;
  slug: string;
  img?: string;
  /** Placca chiara dietro questo marchio. Serve ai loghi disegnati per fondo
      bianco: sul nostro fondo scuro non arrivano a 3:1, sulla placca ci
      arrivano. È per-marchio e non per-griglia perché la misura dice che i
      due casi convivono nella stessa riga: sette loghi su undici sono file
      bianchi e sulla placca crollerebbero a 1,26:1. Vedi il commento nella
      pagina che lo usa per i numeri misurati. */
  plate?: boolean;
}

interface Props {
  items: LogoItem[];
  sectionNumber: string;
  sectionLabel: string;
  headline: string;
  headlineAccent?: string;
  intro: string;
  borderTop?: boolean;
  /** Rende i marchi con il loro colore di origine invece di schiacciarli a
      bianco. Non è un vezzo: alcuni titolari del marchio non accettano una
      resa monocromatica. Va acceso solo dove gli asset si leggono davvero
      sul fondo scuro — vedi il commento sulla classe .logo-adaptive. */
  preserveBrandColors?: boolean;
}

const {
  items,
  sectionNumber,
  sectionLabel,
  headline,
  headlineAccent,
  intro,
  borderTop = false,
  preserveBrandColors = false,
} = Astro.props;

function buildHeadline(text: string, accent?: string): string {
  if (!accent) return text;
  const words = accent.split(" ");
  let result = text;
  for (const word of words) {
    result = result.replace(
      new RegExp(`\\b${word}\\b`, "gi"),
      `<span class="text-wtc-orange">${word}</span>`
    );
  }
  return result;
}
---

<section
  data-logo-section={sectionNumber}
  class:list={[
    "section-px section-py max-w-container mx-auto",
    borderTop && "border-t border-hairline",
  ]}
>
  <div class="flex flex-col gap-4 mb-14">
    <SectionLabel number={sectionNumber} label={sectionLabel} />
    <h2
      class="font-clash font-semibold text-display-md text-white max-w-2xl js-reveal"
      set:html={buildHeadline(headline, headlineAccent)}
    />
    <p class="prose-lead text-ice-grey/55 max-w-xl mt-2 js-reveal">
      {intro}
    </p>
  </div>

  <div class={`logo-grid-${sectionNumber} grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4`}>
    {
      items.map((item) => (
          <div class={`logo-card-${sectionNumber} group rounded-bento border transition duration-300 h-20 flex items-center justify-center px-4 ${item.plate ? "bg-ice-grey border-transparent hover:border-wtc-black/25 active:border-wtc-black/25" : "bg-surface-01 border-hairline hover:border-hairline-strong active:border-hairline-strong"}`}>
          {/* Senza file il marchio si rende direttamente come wordmark tipografico.
              Prima il percorso veniva dedotto dallo slug anche quando il file non
              c'era: una richiesta condannata al 404, mascherata da onerror — errore
              in console e sostituzione visibile a caricamento avvenuto. L'onerror
              resta come rete di sicurezza per i file dichiarati ma irraggiungibili. */}
          {item.img ? (
            <>
              <img
                src={item.img}
                alt={item.name}
                class:list={[
                  "max-h-9 max-w-[80%] object-contain transition-opacity duration-300",
                  // Col colore di marca niente velo: lo 0,55 era tarato sul
                  // bianco pieno prodotto dal filtro, e su un colore vero
                  // spegne. Senza colore di marca il velo storico resta.
                  preserveBrandColors
                    ? "opacity-100"
                    : "logo-adaptive opacity-55 group-hover:opacity-80 group-active:opacity-80",
                ]}
                loading="lazy"
                onerror="this.style.display='none';this.nextElementSibling.style.display='block';"
              />
              <span class:list={["hidden font-clash font-semibold prose-caption uppercase tracking-wider text-center leading-tight",
                    // Sulla placca chiara il grigio chiaro sparisce: 1,00:1.
                    item.plate ? "text-wtc-black/70" : "text-ice-grey/60"]}>
                {item.name}
              </span>
            </>
          ) : (
            <span class:list={["font-clash font-semibold prose-caption uppercase tracking-wider text-center leading-tight",
                  item.plate ? "text-wtc-black/70" : "text-ice-grey/60"]}>
              {item.name}
            </span>
          )}
        </div>
      ))
    }
  </div>
</section>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Il listener sopravvive agli swap delle view transition, ma qui non serve una
    // guardia esplicita: la querySelectorAll è già la guardia. Su una pagina senza
    // logo section il forEach non gira e GSAP non viene mai chiamato; dove gira, il
    // numero arriva dal DOM corrente, quindi i selettori risolvono sempre su elementi
    // di QUESTA pagina. Non aggiungere selettori hardcoded qui: romperebbe l'invariante.
    document.querySelectorAll<HTMLElement>("[data-logo-section]").forEach((section) => {
      const num = section.dataset.logoSection;
      if (!num) return;
      gsap.fromTo(
        `.logo-card-${num}`,
        { y: 30, opacity: 0, scale: 0.96 },
        {
          scrollTrigger: {
            trigger: `.logo-grid-${num}`,
            start: "top 88%",
            once: true,
          },
          y: 0,
          opacity: 1,
          scale: 1,
          stagger: 0.04,
          duration: 0.65,
          ease: "power3.out",
        }
      );
    });
  });
</script>
