---
import Button from "../ui/Button.astro";

export interface CTAAction {
  label: string;
  href: string;
  variant?: "primary" | "outline" | "ghost";
}

export interface Props {
  headline: string;
  subtext?: string;
  actions?: CTAAction[];
  variant?: "full" | "contained";
  class?: string;
}

const {
  headline,
  subtext,
  actions = [],
  variant = "contained",
  class: className,
} = Astro.props;
---

<section
  class:list={[
    "relative overflow-hidden border-t border-white/[0.05]",
    className,
  ]}
>
  <!-- Subtle radial glow -->
  <div class="cta-radial-glow absolute inset-0 pointer-events-none" aria-hidden="true"></div>

  <div
    class:list={[
      "relative",
      variant === "contained"
        ? "section-px max-w-[1600px] mx-auto py-24 md:py-36"
        : "px-8 py-24",
    ]}
  >
    <div class="max-w-2xl mx-auto text-center flex flex-col items-center gap-8">
      <h2
        class="cta-headline font-clash font-semibold uppercase text-display-md text-white text-balance leading-snug"
      >
        {headline}
      </h2>

      {
        subtext && (
          <p class="prose-lead text-ice-grey/60 max-w-xl text-balance">
            {subtext}
          </p>
        )
      }

      {
        actions.length > 0 && (
          <div class="flex flex-wrap justify-center gap-4">
            {actions.map((action) => (
              <Button
                href={action.href}
                variant={action.variant ?? "primary"}
                size="lg"
              >
                {action.label}
              </Button>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Reduced motion: headline stays in its natural (visible) state.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    document.querySelectorAll(".cta-headline").forEach((el) => {
      gsap.fromTo(
        el,
        { y: 40, opacity: 0 },
        {
          scrollTrigger: { trigger: el, start: "top 82%", once: true },
          y: 0,
          opacity: 1,
          duration: 0.8,
          ease: "power3.out",
        },
      );
    });
  });
</script>
