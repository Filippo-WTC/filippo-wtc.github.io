---
export interface TimelineStep {
  number: string;
  title: string;
  description: string;
  tag?: string;
  duration?: string;
}

export interface Props {
  steps: TimelineStep[];
  class?: string;
}

const { steps, class: className } = Astro.props;
---

<div class:list={['relative', className]}>
  <!-- Vertical line -->
  <div
    class="absolute left-6 md:left-1/2 top-0 bottom-0 w-[1px] bg-gradient-to-b from-transparent via-wtc-orange/30 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="flex flex-col gap-0">
    {steps.map((step, i) => (
      <div
        class:list={[
          'timeline-step relative flex gap-8 md:gap-0',
          i % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse',
        ]}
      >
        <!-- Content block -->
        <div class:list={[
          'pl-16 md:pl-0 pb-16 md:pb-20',
          i % 2 === 0
            ? 'md:pr-16 md:w-1/2 md:text-right'
            : 'md:pl-16 md:w-1/2',
        ]}>
          {step.tag && (
            <span class="inline-block font-inter text-xs text-wtc-orange tracking-widest uppercase mb-3">
              {step.tag}
            </span>
          )}
          <h3 class="font-clash font-semibold text-display-sm text-white uppercase mb-3">
            {step.title}
          </h3>
          <p class="font-inter text-base text-ice-grey/60 leading-relaxed">
            {step.description}
          </p>
          {step.duration && (
            <div class="mt-4 inline-flex items-center gap-2">
              <span class="w-8 h-[1px] bg-wtc-orange/40"></span>
              <span class="font-inter text-xs text-wtc-orange">{step.duration}</span>
            </div>
          )}
        </div>

        <!-- Center node -->
        <div
          class="absolute left-0 md:left-1/2 top-0 md:-translate-x-1/2 flex items-center justify-center w-12 h-12 rounded-full bg-surface-02 border border-wtc-orange/30"
          aria-hidden="true"
        >
          <span class="font-clash font-semibold text-sm text-wtc-orange">{step.number}</span>
        </div>

        <!-- Empty space (opposite side) -->
        <div class="hidden md:block md:w-1/2"></div>
      </div>
    ))}
  </div>
</div>

<script>
  import { gsap, ScrollTrigger } from '@/lib/gsap';

  document.addEventListener('astro:page-load', () => {
    gsap.fromTo('.timeline-step', 
      {
        x: (i: number) => (i % 2 === 0 ? -40 : 40),
        opacity: 0,
      },
      {
        scrollTrigger: {
          trigger: '.timeline-step',
          start: 'top 88%',
          once: true,
        },
        x: 0,
        opacity: 1,
        stagger: 0.2,
        duration: 0.8,
        ease: 'power3.out',
      }
    );
  });
</script>
