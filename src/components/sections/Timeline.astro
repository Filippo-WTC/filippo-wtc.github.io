---
export interface TimelineStep {
  number: string;
  title: string;
  description: string;
  tag?: string;
  duration?: string;
}

export interface Props {
  steps: TimelineStep[];
  class?: string;
}

const { steps, class: className } = Astro.props;
---

<div class:list={['relative max-w-3xl', className]}>
  <!-- Vertical rail (aligned with the centre of the nodes) -->
  <div
    class="absolute left-6 top-3 bottom-3 w-[1px] bg-gradient-to-b from-transparent via-wtc-orange/30 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="flex flex-col">
    {steps.map((step, i) => (
      <div class:list={['timeline-step relative flex gap-6', i === steps.length - 1 ? '' : 'pb-12']}>
        <!-- Node -->
        <div
          class="relative z-10 shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-surface-02 border border-wtc-orange/30"
        >
          <span class="font-clash font-semibold text-sm text-wtc-orange">{step.number}</span>
        </div>

        <!-- Content (always left-aligned, reads top to bottom) -->
        <div class="pt-1 min-w-0">
          {step.tag && (
            <span class="inline-block font-inter text-xs text-wtc-orange tracking-widest uppercase mb-2">
              {step.tag}
            </span>
          )}
          <h3 class="font-clash font-semibold text-display-sm text-white mb-2">
            {step.title}
          </h3>
          <p class="prose-body text-ice-grey/60">
            {step.description}
          </p>
          {step.duration && (
            <div class="mt-3 inline-flex items-center gap-2">
              <span class="w-8 h-[1px] bg-wtc-orange/40"></span>
              <span class="font-inter text-xs text-wtc-orange">{step.duration}</span>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import { gsap } from '@/lib/gsap';

  document.addEventListener('astro:page-load', () => {
    // Reduced motion: steps stay in their natural (visible) state.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    gsap.fromTo(
      '.timeline-step',
      { x: -24, opacity: 0 },
      {
        scrollTrigger: { trigger: '.timeline-step', start: 'top 88%', once: true },
        x: 0,
        opacity: 1,
        stagger: 0.15,
        duration: 0.7,
        ease: 'power3.out',
      },
    );
  });
</script>
