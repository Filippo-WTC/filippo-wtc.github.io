---
export interface TimelineStep {
  number: string;
  title: string;
  description: string;
  tag?: string;
  duration?: string;
}

export interface Props {
  steps: TimelineStep[];
  class?: string;
}

const { steps, class: className } = Astro.props;
---

<div class:list={['timeline-root relative max-w-3xl', className]}>
  <!-- Vertical rail: faint base line + an orange fill that draws with
       scroll progress (scaleY scrub, see script). Under reduced motion
       the fill stays fully drawn — its natural CSS state. -->
  <div
    class="absolute left-6 top-3 bottom-3 w-[1px] bg-gradient-to-b from-transparent via-hairline-strong to-transparent"
    aria-hidden="true"
  >
    <div
      class="timeline-rail-fill absolute inset-0 origin-top bg-gradient-to-b from-wtc-orange/50 via-wtc-orange/35 to-transparent"
    ></div>
  </div>

  <div class="flex flex-col">
    {steps.map((step, i) => (
      <div class:list={['timeline-step relative flex gap-6', i === steps.length - 1 ? '' : 'pb-12']}>
        <!-- Node -->
        <div
          class="relative z-10 shrink-0 flex items-center justify-center w-12 h-12 rounded-full bg-surface-02 border border-wtc-orange/30"
        >
          <span class="font-clash font-semibold text-sm text-wtc-orange">{step.number}</span>
        </div>

        <!-- Content (always left-aligned, reads top to bottom) -->
        <div class="pt-1 min-w-0">
          {step.tag && (
            <span class="inline-block font-inter text-xs text-wtc-orange tracking-widest uppercase mb-2">
              {step.tag}
            </span>
          )}
          <h3 class="font-clash font-semibold text-display-sm text-white mb-2">
            {step.title}
          </h3>
          <p class="prose-body text-ice-grey/60">
            {step.description}
          </p>
          {step.duration && (
            <div class="mt-3 inline-flex items-center gap-2">
              <span class="w-8 h-[1px] bg-wtc-orange/40"></span>
              <span class="font-inter text-xs text-wtc-orange">{step.duration}</span>
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  import { gsap } from '@/lib/gsap';

  document.addEventListener('astro:page-load', () => {
    // Reduced motion: steps visible, rail fully drawn (natural CSS state).
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // Per-instance init, so multiple timelines on one page each animate
    // when they enter the viewport (a global selector would tie every
    // instance to the first one's trigger).
    document.querySelectorAll<HTMLElement>('.timeline-root').forEach((root) => {
      const steps = root.querySelectorAll('.timeline-step');
      if (steps.length) {
        gsap.fromTo(
          steps,
          { x: -24, opacity: 0 },
          {
            scrollTrigger: { trigger: root, start: 'top 88%', once: true },
            x: 0,
            opacity: 1,
            stagger: 0.15,
            duration: 0.7,
            ease: 'power3.out',
          },
        );
      }

      // Rail fill draws top→bottom, scrubbed to scroll progress.
      const fill = root.querySelector<HTMLElement>('.timeline-rail-fill');
      if (fill) {
        gsap.fromTo(
          fill,
          { scaleY: 0 },
          {
            scaleY: 1,
            ease: 'none',
            scrollTrigger: {
              trigger: root,
              start: 'top 75%',
              end: 'bottom 55%',
              scrub: 0.5,
            },
          },
        );
      }
    });
  });
</script>
