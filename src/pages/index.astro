---
import BranchLayout from "../layouts/BranchLayout.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import EcosystemFlow from "../components/sections/EcosystemFlow.astro";
import CTASection from "../components/sections/CTASection.astro";
import SectionHeader from "../components/ui/SectionHeader.astro";
import Badge from "../components/ui/Badge.astro";
import { BRANCHES } from "../data/navigation";

const badgeByBranch: Record<string, "orange" | "green" | "red" | "neutral" | "outline"> = {
  services: "orange",
  team: "outline",
  "global-portal": "neutral",
  pitter: "green",
  "wtc-food": "outline",
};
---

<BranchLayout
  title="WTC Group — IT, Sport, Import e Agroalimentare"
  description="WTC Group riunisce cinque aziende italiane: assistenza IT enterprise, hospitality sportiva, connessione con produttori esteri, macchinari per l'agroalimentare e specialità agricole di nicchia."
>
  <!-- HERO -->
  <HeroSection
    eyebrow="WTC Group"
    title="Nato come gruppo IT, cresciuto in cinque direzioni."
    titleAccent="cinque direzioni"
    subtitle="Assistenza IT per aziende e istituti di credito, connessione diretta con i produttori esteri, macchinari per l'agroalimentare, specialità agricole di nicchia e hospitality sportiva. Cinque attività, gestite dalle stesse persone."
    ctas={[
      { label: "Scopri i servizi IT", href: "/services", variant: "primary" },
      { label: "Contattaci", href: "/contatti", variant: "outline" },
    ]}
    bgVariant="radial"
    canvas="none"
    topOffset="nav-full"
  />


  <!-- DIVISIONS GRID -->
  <section class="section-px section-py max-w-container mx-auto">
    <SectionHeader
      number="01"
      label="Le divisioni"
      size="lg"
      lead="Ogni divisione ha un proprio settore e un proprio team, ma condivide lo stesso metodo di lavoro."
      class="mb-16"
    >
      Cinque aziende.<br />
      <span class="text-wtc-orange">Le stesse persone.</span>
    </SectionHeader>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 service-cards">
      {BRANCHES.map((branch) => (
        <a
          href={branch.rootHref}
          class="service-card group relative overflow-hidden rounded-bento bg-surface-01 border border-hairline p-10 flex flex-col gap-7 hover:border-hairline-strong transition-all duration-500"
        >
          <Badge variant={badgeByBranch[branch.id] ?? "neutral"}>{branch.name}</Badge>
          <div>
            <h3 class="font-clash font-semibold text-display-sm text-white mb-4">{branch.name}</h3>
            <p class="prose-body-sm text-ice-grey/55">
              {branch.tagline}
            </p>
          </div>
          <div class="mt-auto pt-6">
            <span class="font-inter text-sm text-wtc-orange">Scopri di più →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- ECOSYSTEM -->
  <EcosystemFlow />

  <!-- CTA -->
  <CTASection
    headline="Vuoi capire quale divisione fa al caso tuo?"
    subtext="Scrivici cosa ti serve — ti mettiamo in contatto con il team giusto."
    actions={[
      { label: "Contattaci", href: "/contatti", variant: "primary" },
      { label: "Tutti i servizi IT", href: "/services", variant: "outline" },
    ]}
  />
</BranchLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.fromTo(
      ".service-card",
      { y: 50, opacity: 0 },
      {
        scrollTrigger: { trigger: ".service-cards", start: "top 88%", once: true },
        y: 0, opacity: 1, stagger: 0.1, duration: 0.9, ease: "power3.out",
      },
    );
  });
</script>
