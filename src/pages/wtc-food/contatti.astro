---
import BranchLayout from "../../layouts/BranchLayout.astro";
import { breadcrumbLd } from "../../lib/breadcrumbs";

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'WTC Food',
  legalName: 'WTC SERVICES S.r.l.s.',
  email: 'wtc@wtcservices.it',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Leone XIII, 464',
    postalCode: '00165',
    addressLocality: 'Roma',
    addressCountry: 'IT',
  },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
const breadcrumb = breadcrumbLd(
  [
    { name: "WTC Food", path: "/wtc-food/" },
    { name: "Contatti", path: Astro.url.pathname },
  ],
  Astro.site,
);
---

<BranchLayout
  branchId="wtc-food"
  title="Contatti — WTC Food"
  description="Catalogo, forniture e collaborazioni con WTC Food. Specialità agroalimentari di nicchia: la gamma alle visciole e le eccellenze del territorio di Regedano."
  structuredData={[localBusinessLd, breadcrumb]}
>
  <div class="pt-navbar md:pt-nav-full">

    <!-- Hero -->
    <section class="section-py section-px max-w-container mx-auto">
      <div class="max-w-2xl">
        <p class="font-inter text-xs text-wtc-orange tracking-widest uppercase mb-4">Contatti</p>
        <h1 class="font-clash font-semibold text-display-lg md:text-display-xl text-white mb-6 text-balance">
          Catalogo e forniture
        </h1>
        <p class="prose-lead text-text-muted max-w-lg">
          Sei un ristoratore, un distributore o un buyer internazionale? Raccontaci quali specialità ti interessano e ti inviamo il catalogo con disponibilità e condizioni di fornitura.
        </p>
      </div>
    </section>

    <div class="section-px max-w-container mx-auto">
      <div class="h-px bg-veil-strong"></div>
    </div>

    <!-- Form + Sidebar -->
    <section class="section-py section-px max-w-container mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16 items-start">

        <!-- Email CTA (2/3) -->
        <div class="lg:col-span-2">
          <div class="flex flex-col gap-6 rounded-bento border border-hairline bg-surface-01 p-8 sm:p-10">
            <p class="prose-caption text-wtc-orange tracking-widest uppercase">Scrivici</p>
            <h2 class="font-clash font-semibold text-display-sm text-white text-balance">
              Catalogo e forniture via email.<br />Ti rispondiamo entro un giorno lavorativo.
            </h2>
            <p class="prose-body text-text-muted max-w-lg">
              Dicci chi sei (ristorante, distributore, buyer estero) e quali specialità ti interessano: la gamma alle visciole, i tartufi, lo zafferano o le altre eccellenze di Regedano. Ti inviamo il catalogo con disponibilità e condizioni di fornitura.
            </p>
            <a
              href="mailto:wtc@wtcservices.it?subject=Richiesta%20catalogo%20WTC%20Food"
              class="link-arrow w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 font-inter text-xs font-medium tracking-wide uppercase bg-wtc-orange text-wtc-black rounded-lg hover:bg-wtc-neon transition-colors duration-200"
            >
              Scrivici una email <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>

        <!-- Sidebar (1/3) -->
        <div class="lg:col-span-1 flex flex-col gap-6">

          <div class="rounded-xl border border-hairline bg-surface-01/50 p-6 flex flex-col gap-5">
            <p class="prose-caption text-wtc-orange tracking-widest uppercase">Contatti diretti</p>

            <div class="flex flex-col gap-1">
              <p class="font-inter text-xs text-text-muted">Email</p>
              <a href="mailto:wtc@wtcservices.it" class="font-inter text-sm text-ice-grey hover:text-white transition-colors break-all">
                wtc@wtcservices.it
              </a>
            </div>

            <div class="flex flex-col gap-1">
              <p class="font-inter text-xs text-text-muted">Sede</p>
              <p class="font-inter text-sm text-ice-grey leading-relaxed">
                Via Leone XIII, 464<br />
                00165 Roma (RM)
              </p>
            </div>

            <div class="pt-4 border-t border-hairline">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400 flex-shrink-0"></span>
                <p class="font-inter text-xs text-text-muted">Rispondiamo entro 1 giorno lavorativo</p>
              </div>
            </div>
          </div>

          <!-- Specialità -->
          <div class="rounded-xl border border-hairline bg-surface-01/30 p-6 flex flex-col gap-3">
            <p class="prose-caption text-ice-grey/60 tracking-widest uppercase">Le nostre specialità</p>
            <p class="font-inter text-sm text-text-muted leading-relaxed">
              La gamma alle visciole e le eccellenze del territorio di Regedano: specialità di nicchia, difficili da trovare altrove. Scopri la gamma.
            </p>
            <a
              href="/wtc-food/"
              class="link-arrow inline-flex items-center gap-1.5 font-inter text-xs text-ice-grey/70 hover:text-ice-grey transition-colors duration-200"
            >
              Scopri i prodotti
              <span aria-hidden="true">→</span>
            </a>
          </div>

        </div>

      </div>
    </section>

  </div>
</BranchLayout>
