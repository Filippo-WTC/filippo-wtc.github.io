---
import BranchLayout from "../../layouts/BranchLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import StatsRow from "../../components/sections/StatsRow.astro";
import HorizontalGallery from "../../components/sections/HorizontalGallery.astro";
import CTASection from "../../components/sections/CTASection.astro";

const visciole = [
  { title: "Vino di Visciole", description: "Affonda le radici nella tradizione contadina italiana e unisce le caratteristiche del vino al carattere unico delle visciole." },
  { title: "Aceto di Visciole", description: "Una specialità per la ristorazione e per chi ama la gastronomia, ideale su piatti gourmet e creazioni culinarie." },
  { title: "Liquore di Visciole", description: "Aromi intensi, profumi delicati e tutto il carattere delle visciole mature." },
  { title: "Visciole Snocciolate Surgelate", description: "Per laboratori, gelaterie, pasticcerie e aziende alimentari che vogliono materia prima di qualità tutto l'anno." },
  { title: "Yogurt alle Visciole", description: "La cremosità dello yogurt incontra il carattere intenso di uno dei frutti più tipici della tradizione italiana." },
  { title: "Gelato alle Visciole", description: "Artigianale, con aromi naturali e un equilibrio preciso tra dolcezza e acidità." },
  { title: "Ciambelle al Vino di Visciole", description: "Una ricetta tradizionale reinterpretata con uno dei prodotti simbolo dell'azienda." },
  { title: "Visciole Disidratate Snocciolate", description: "Uno snack naturale, buono da solo e utile in preparazioni, prodotti da forno e pasticceria." },
];

const continua = [
  { title: "Le Eccellenze di Regedano", desc: "Tartufi, nocciole, olive, zafferano e altre specialità del territorio.", href: "/wtc-food/regedano", cta: "Scopri il territorio →" },
  { title: "Export e regali d'impresa", desc: "I mercati internazionali e la corporate gifts collection.", href: "/wtc-food/export", cta: "Mercati e regali →" },
];
---

<BranchLayout
  branchId="wtc-food"
  title="WTC Food — Specialità agroalimentari italiane di nicchia"
  description="WTC Food trasforma materie prime agricole selezionate in specialità di nicchia: la linea completa alle visciole e le eccellenze del territorio di Regedano, per i mercati che cercano l'eccellenza."
>
  <!-- HERO -->
  <HeroSection
    eyebrow="WTC Food"
    title="Dal territorio al mondo."
    titleAccent="mondo"
    subtitle="WTC Food trasforma materie prime agricole selezionate in specialità di nicchia, difficili da trovare e pensate per chi cerca qualità vera. Al centro ci sono le visciole, insieme alle eccellenze del territorio di Regedano."
    ctas={[
      { label: "Richiedi il catalogo", href: "/wtc-food/contatti", variant: "primary" },
      { label: "Le eccellenze di Regedano", href: "/wtc-food/regedano", variant: "outline" },
    ]}
    bgVariant="radial"
    canvas="food"
    topOffset="nav-full"
  />

  <!-- STATS -->
  <StatsRow
    stats={[
      { value: "8", suffix: "", label: "Specialità alle visciole" },
      { value: "6", suffix: "", label: "Eccellenze di Regedano" },
      { value: "0", suffix: "", label: "Prodotti nella grande distribuzione" },
      { value: "100", suffix: "%", label: "Filiera corta e selezionata" },
    ]}
  />

  <!-- SPECIALITÀ ALLE VISCIOLE (galleria a scorrimento orizzontale) -->
  <HorizontalGallery
    number="01"
    label="Specialità alle Visciole"
    heading="Tutto nasce dalle visciole."
    headingAccent="visciole"
    intro="Dopo anni di studio, coltivazione e tecnologie sviluppate apposta per lavorarle, abbiamo trasformato questo frutto in una linea completa di prodotti ad alto valore aggiunto."
    items={visciole.map((p) => ({ title: p.title, description: p.description }))}
  />

  <!-- CONTINUA -->
  <section class="section-px section-py max-w-container mx-auto border-t border-hairline">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        continua.map((c) => (
          <a
            href={c.href}
            class="group rounded-bento bg-surface-01 border border-hairline p-10 flex flex-col gap-4 hover:border-hairline-strong transition-all duration-500"
          >
            <h3 class="font-clash font-semibold text-display-sm text-white">{c.title}</h3>
            <p class="font-inter text-sm text-ice-grey/55 leading-relaxed">{c.desc}</p>
            <span class="mt-2 font-inter text-sm text-wtc-orange">{c.cta}</span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Vuoi portare queste specialità sul tuo mercato?"
    subtext="Ristoratori, distributori, buyer internazionali: raccontaci cosa cerchi e ti inviamo il catalogo con disponibilità e condizioni di fornitura."
    actions={[
      { label: "Richiedi il catalogo", href: "/wtc-food/contatti", variant: "primary" },
    ]}
  />
</BranchLayout>
