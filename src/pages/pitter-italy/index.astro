---
import BranchLayout from "../../layouts/BranchLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
import Disclosure from "../../components/ui/Disclosure.astro";

const areas = [
  {
    number: "01",
    badge: { label: "Macchinari di Processo", variant: "orange" as const },
    title: "Snocciolatrici e Vasche",
    description:
      "Macchine in acciaio inox per la denocciolatura di visciole e altri piccoli frutti. Sistemi di lavaggio ad acqua specializzati per tuberi e tartufi.",
    features: [
      "Snocciolatrici",
      "Lavatartufi",
      "Acciaio inox",
      "Assistenza e ricambi",
    ],
    href: "/pitter-italy/machinery",
    cta: "Vedi i macchinari",
    cols: "lg:col-span-2",
  },
  {
    number: "02",
    badge: { label: "Impianti su misura", variant: "neutral" as const },
    title: "Linee Complete",
    description:
      "Integrazione di più stadi: calibratura, lavaggio, snocciolatura, deferrizzazione e confezionamento. Progettazione e installazione su misura.",
    features: [
      "Sistemi integrati",
      "Layout su misura",
      "Idonee alle lavorazioni alimentari",
      "Installazione in loco",
    ],
    href: "/pitter-italy/machinery#linee",
    cta: "Progettazione linee",
    cols: "",
  },
  {
    number: "03",
    badge: { label: "Credenziali", variant: "green" as const },
    title: "Collaudo Reale",
    description:
      "L'affidabilità di Pitter Italy si misura in produzione. I macchinari lavorano nei siti produttivi di WTC Food: quello che installiamo dal cliente lo collaudiamo prima nella nostra azienda.",
    features: [
      "Test in condizioni reali",
      "Nessuna simulazione",
      "Feedback costante",
      "Affidabilità provata",
    ],
    href: "#prova",
    cta: "La nostra prova",
    cols: "lg:col-span-3",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Che tipo di macchinari produce Pitter Italy?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Snocciolatrici e vasche di lavaggio in acciaio inox per visciole, piccoli frutti e tartufi, oltre a linee complete integrate: calibratura, lavaggio, snocciolatura, deferrizzazione e confezionamento su misura.",
      },
    },
    {
      "@type": "Question",
      name: "I macchinari sono collaudati prima di essere installati dal cliente?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sì: i macchinari lavorano prima nei siti produttivi di WTC Food, in condizioni di produzione reale, non in una simulazione.",
      },
    },
    {
      "@type": "Question",
      name: "Che tempi di intervento e ricambi garantite?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Garantiamo assistenza e disponibilità dei ricambi.",
      },
    },
    {
      "@type": "Question",
      name: "I macchinari sono adatti alle ispezioni nelle lavorazioni alimentari?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Sì: le linee sono costruite in acciaio inox e pensate per una pulizia a fondo, adatte alle ispezioni nelle lavorazioni alimentari.",
      },
    },
  ],
};
---

<BranchLayout
  branchId="pitter"
  title="Pitter Italy — Ingegneria e Macchinari per l'Agroalimentare"
  description="Pitter Italy progetta macchinari in acciaio inox per l'industria agroalimentare. Snocciolatrici, lavatartufi e linee complete su misura per le PMI."
  structuredData={[faqLd]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Pitter Italy"

    title="Acciaio inox e ingegneria per l'agroalimentare."
    titleAccent="ingegneria"
    subtitle="Progettiamo, costruiamo e installiamo macchinari in acciaio inox per il settore agroalimentare. Snocciolatrici e sistemi di lavaggio fatti per durare e collaudati nei nostri impianti produttivi."
    ctas={[
      {
        label: "Vedi i macchinari",
        href: "/pitter-italy/machinery",
        variant: "primary",
      },
      { label: "La nostra prova", href: "#prova", variant: "outline" },
    ]}
    bgVariant="radial"
    canvas="production"
    topOffset="nav-full"
  />

  <!-- AREE -->
  <section class="section-px section-py max-w-container mx-auto">
    <SectionLabel number="01" label="Le Nostre Specializzazioni" class="mb-12" />

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 areas-grid"
    >
      {
        areas.map((area) => (
          <article
            class:list={[
              "area-card card-lift card-lift-glow group relative overflow-hidden rounded-bento bg-surface-01 border border-hairline p-8 flex flex-col gap-6",
              area.cols,
            ]}
          >
            <div class="flex items-start justify-between">
              <Badge variant={area.badge.variant} dot>
                {area.badge.label}
              </Badge>
              <span class="font-clash text-5xl font-bold text-wtc-orange/10 group-hover:text-wtc-orange/20 transition-all duration-300">
                {area.number}
              </span>
            </div>

            <div>
              <h2 class="font-clash font-semibold text-display-sm text-white mb-3">
                {area.title}
              </h2>
              <p class="prose-body-sm text-ice-grey/60">
                {area.description}
              </p>
            </div>

            <ul class="flex flex-wrap gap-2">
              {area.features.map((f) => (
                <li class="px-3 py-1 rounded prose-caption text-ice-grey/60 border border-hairline bg-veil">
                  {f}
                </li>
              ))}
            </ul>

            <div class="mt-auto">
              <a
                href={area.href}
                class="link-arrow font-inter text-sm text-wtc-orange hover:text-wtc-neon transition-colors"
              >
                {area.cta} <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- PROVA IN CAMPO -->
  <section id="prova" class="section-px section-py max-w-container mx-auto border-t border-hairline">
    <SectionHeader
      number="02"
      label="La Nostra Prova"
      lead="Chi vende macchinari senza usarli non conosce davvero i problemi che incontrerai. Noi quei problemi li abbiamo già risolti, nei nostri siti, con le nostre macchine."
      class="mb-14"
    >
      Non siamo solo fornitori.<br />
      <span class="text-wtc-orange">Siamo anche produttori.</span>
    </SectionHeader>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 proof-cards">
      <div class="proof-card rounded-bento bg-surface-01 border border-hairline p-8 flex flex-col gap-4 hover:border-hairline-strong transition-colors duration-300">
        <Badge variant="green">Materie prime</Badge>
        <h3 class="font-clash font-semibold text-lg text-white">Le lavorazioni WTC Food</h3>
        <p class="font-inter text-sm text-ice-grey/55 leading-relaxed">
          Le nostre denocciolatrici lavorano le visciole, le lavatartufi puliscono i tartufi: le materie prime che WTC Food trasforma in prodotti di specialità.
        </p>
      </div>
      <div class="proof-card rounded-bento bg-surface-01 border border-hairline p-8 flex flex-col gap-4 hover:border-hairline-strong transition-colors duration-300">
        <Badge variant="orange">Macchinari</Badge>
        <h3 class="font-clash font-semibold text-lg text-white">Impianti in uso reale</h3>
        <p class="font-inter text-sm text-ice-grey/55 leading-relaxed">
          Le nostre snocciolatrici e linee girano nei siti WTC Food. Conosciamo ogni modo in cui una macchina può fermarsi.
        </p>
      </div>
      <div class="proof-card rounded-bento bg-surface-01 border border-hairline p-8 flex flex-col gap-4 hover:border-hairline-strong transition-colors duration-300">
        <Badge variant="neutral">Tecnologia</Badge>
        <h3 class="font-clash font-semibold text-lg text-white">IT WTC integrato</h3>
        <p class="font-inter text-sm text-ice-grey/55 leading-relaxed">
          La stessa infrastruttura IT che installiamo nei clienti opera sui nostri impianti. Dati reali, presi in produzione.
        </p>
      </div>
    </div>
  </section>

  <!-- INGEGNERIA COLLAUDATA -->
  <section
    class="section-px section-py max-w-container mx-auto border-t border-hairline"
  >
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="flex flex-col gap-7">
        <SectionLabel number="03" label="Ingegneria Collaudata" />
        <h2
          class="font-clash font-semibold text-display-md text-white"
        >
          Progettiamo le macchine.<br />
          <span class="text-wtc-orange">Le usiamo noi per primi.</span>
        </h2>
        <p class="prose-body text-ice-grey/55">
          Pitter Italy progetta snocciolatrici e linee di lavorazione in acciaio inox capaci di resistere negli anni. Le nostre macchine si giudicano sul campo: i primissimi impianti li usiamo noi nei siti produttivi di WTC Food.
        </p>
        <p class="prose-body text-ice-grey/55">
          Ogni macchina che installiamo da un cliente è collaudata in un ambiente di vera produzione industriale intensiva. Ogni criticità, o necessità di facile pulizia, la risolviamo sul campo prima ancora di spedire.
        </p>
        <p class="prose-body text-ice-grey/55">
          A questo si aggiunge l'infrastruttura IT WTC per il monitoraggio continuo dei parametri e l'efficienza della linea, così da ridurre al minimo le interruzioni.
        </p>
        <div class="flex flex-wrap gap-4">
          <Button href="#prova" variant="primary">
            La prova in campo
          </Button>
          <Button href="/pitter-italy/machinery" variant="outline" class="link-arrow">
            Il catalogo completo <span aria-hidden="true">→</span>
          </Button>
        </div>
      </div>

      <div class="flex flex-col gap-4">
        {
          [
            {
              step: "01",
              title: "Analisi Specifica",
              desc: "Progettiamo a partire dalle tue esigenze di volume, tipologia di lavorazione e layout industriale.",
            },
            {
              step: "02",
              title: "Costruzione Inox",
              desc: "Costruzioni in acciaio inox per tutta la filiera del prodotto, ideali per le ispezioni nelle lavorazioni alimentari.",
            },
            {
              step: "03",
              title: "Confronto sul campo",
              desc: "La garanzia delle performance non ci è data da terzi: la tocchiamo con mano nelle lavorazioni delle nostre società agricole.",
            },
            {
              step: "04",
              title: "Assistenza Immediata",
              desc: "La comodità di chiamare e avere una fornitura di ricambistica disponibile in tempi rapidi.",
            },
          ].map((item) => (
            <div class="filiera-item flex gap-5 items-start p-5 rounded-xl bg-surface-01 border border-hairline hover:border-hairline-strong transition-colors duration-300">
              <span class="font-clash font-semibold text-2xl text-wtc-orange/40 shrink-0 leading-none pt-1">
                {item.step}
              </span>
              <div>
                <h3 class="font-clash font-semibold text-base text-white mb-1">
                  {item.title}
                </h3>
                <p class="prose-body-sm text-ice-grey/55">
                  {item.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section
    class="section-px section-py max-w-container mx-auto border-t border-hairline"
  >
    <SectionHeader
      label="Domande Frequenti"
      heading="Le domande dei buyer."
      headingAccent="dei buyer."
      class="mb-14"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {
        [
          {
            q: "Che tipo di macchinari produce Pitter Italy?",
            a: "Snocciolatrici e vasche di lavaggio in acciaio inox per visciole, piccoli frutti e tartufi, oltre a linee complete integrate: calibratura, lavaggio, snocciolatura, deferrizzazione e confezionamento su misura.",
          },
          {
            q: "I macchinari sono collaudati prima di essere installati dal cliente?",
            a: "Sì: i macchinari lavorano prima nei siti produttivi di WTC Food, in condizioni di produzione reale, non in una simulazione.",
          },
          {
            q: "Che tempi di intervento e ricambi garantite?",
            a: "Garantiamo assistenza e disponibilità dei ricambi.",
          },
          {
            q: "I macchinari sono adatti alle ispezioni nelle lavorazioni alimentari?",
            a: "Sì: le linee sono costruite in acciaio inox e pensate per una pulizia a fondo, adatte alle ispezioni nelle lavorazioni alimentari.",
          },
        ].map((faq) => (
          <div class="rounded-bento bg-surface-01 border border-hairline p-8">
            <Disclosure hit="card">
              <h3 slot="summary" class="font-clash font-semibold text-lg text-white">
                {faq.q}
              </h3>
              <p class="prose-body-sm text-ice-grey/55 pt-4">
                {faq.a}
              </p>
            </Disclosure>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Cerchi macchinari resistenti per la tua produzione?"
    subtext="Sei un trasformatore e hai bisogno di una snocciolatrice, una lavatrice per tartufi o una linea su misura, parliamo. Parlerai con esperti che progettano e usano queste macchine da una vita."
    actions={[
      { label: "Vedi i macchinari", href: "/pitter-italy/machinery", variant: "primary" },
      { label: "Contattaci", href: "/pitter-italy/contatti", variant: "outline" },
    ]}
  />
</BranchLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.fromTo(
      ".area-card",
      {
        y: 36,
        opacity: 0,
        scale: 0.97,
      },
      {
        scrollTrigger: { trigger: ".areas-grid", start: "top 88%", once: true },
        y: 0,
        opacity: 1,
        scale: 1,
        stagger: 0.1,
        duration: 0.8,
        ease: "power3.out",
        // Clear inline transform after the entrance so .card-lift:hover can translate.
        clearProps: "transform,opacity",
      },
    );

    gsap.fromTo(
      ".proof-card",
      { y: 40, opacity: 0 },
      {
        scrollTrigger: { trigger: ".proof-cards", start: "top 88%", once: true },
        y: 0, opacity: 1, stagger: 0.1, duration: 0.8, ease: "power3.out",
      },
    );

    gsap.fromTo(
      ".filiera-item",
      {
        x: 30,
        opacity: 0,
      },
      {
        scrollTrigger: { trigger: ".filiera-item", start: "top 88%", once: true },
        x: 0,
        opacity: 1,
        stagger: 0.1,
        duration: 0.7,
        ease: "power3.out",
      },
    );
  });
</script>
