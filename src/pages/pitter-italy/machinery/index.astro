---
import BranchLayout from '../../../layouts/BranchLayout.astro';
import { breadcrumbLd } from "../../../lib/breadcrumbs";
import HeroSection from '../../../components/sections/HeroSection.astro';
import CTASection from '../../../components/sections/CTASection.astro';
import SectionLabel from '../../../components/ui/SectionLabel.astro';
import SectionHeader from '../../../components/ui/SectionHeader.astro';
import Button from '../../../components/ui/Button.astro';
import Badge from '../../../components/ui/Badge.astro';
import Disclosure from '../../../components/ui/Disclosure.astro';
import { Picture } from "astro:assets";
import imgSnocciolatrice from "../../../assets/pitter/snocciolatrice.jpg";
import imgLavaggio from "../../../assets/pitter/lavaggio.jpg";
import imgLinea from "../../../assets/pitter/linea.jpg";
import imgControlli from "../../../assets/pitter/controlli.jpg";

const machines = [
  {
    id: 'snocciolatrice',
    number: '01',
    badge: { label: 'Denocciolatura', variant: 'orange' as const },
    title: 'Snocciolatrici Industriali',
    img: imgSnocciolatrice,
    imgAlt: "Snocciolatrice Pitter in produzione, con le visciole in lavorazione",
    description:
      "Macchine per la rimozione del nocciolo da visciole e altri piccoli frutti. Struttura interamente in acciaio inox, con parti a contatto pensate per l'uso alimentare e per una pulizia a fondo.",
    features: [
      'Regolazione calibro frutto',
      'Parti in gomma alimentare',
      'Telaio in acciaio inox',
      'Ricambi reperibili',
      'Facile pulizia',
    ],
  },
  {
    id: 'lavatartufi',
    number: '02',
    badge: { label: 'Lavaggio', variant: 'neutral' as const },
    title: 'Lavatartufi & Lavafrutti',
    img: imgLavaggio,
    imgAlt: "Vasca di lavaggio Pitter in acciaio inox con cestello ottagonale forato",
    description:
      'Sistemi di lavaggio ad acqua per tartufi, tuberi e frutti a buccia dura. Doppio stadio con pre-ammollo e lavaggio a spazzole rotanti, scarico automatizzato.',
    features: [
      'Spazzole in nylon alimentare',
      'Doppio stadio di lavaggio',
      'Ciclo idrico efficiente',
      'Acciaio inox',
      'Facile smontaggio',
    ],
  },
  {
    id: 'linee',
    number: '03',
    badge: { label: 'Su misura', variant: 'green' as const },
    title: 'Linee di Lavorazione Complete',
    img: imgLinea,
    imgAlt: "Linea di lavorazione Pitter: vasca di lavaggio e gruppo pompa su telaio carrellato",
    description:
      'Integrazione di più stadi: selezione, lavaggio, snocciolatura, deferrizzazione e confezionamento. Progettate a partire dal layout del tuo stabilimento e dal prodotto finito.',
    features: [
      'Progettazione layout inclusa',
      'Automazione su misura',
      'Idonee alle lavorazioni alimentari',
      'Assistenza post-vendita',
    ],
  },
  {
    id: 'accessori',
    number: '04',
    badge: { label: 'Componenti', variant: 'neutral' as const },
    title: 'Accessori & Ricambi',
    img: imgControlli,
    imgAlt: "Pulsantiera avvio/arresto tricolore di un macchinario Pitter, made in Italy",
    description:
      'Ugelli, cinghie, tappeti, spazzole e gruppi di snocciolatura. Compatibili con i macchinari Pitter Italy.',
    features: [
      'Ricambi a magazzino',
      'Consegna rapida',
      'Supporto tecnico',
      'Componenti originali',
    ],
  },
];

const materiali = [
  {
    label: 'Acciaio inox',
    desc: 'Per tutte le superfici a contatto con il prodotto, idoneo all\'uso alimentare.',
  },
  {
    label: 'Gomma alimentare',
    desc: 'Tappeti e guarnizioni in gomma idonea al contatto con gli alimenti.',
  },
  {
    label: 'Nylon alimentare',
    desc: 'Spazzole resistenti all\'abrasione e facili da sostituire.',
  },
  {
    label: 'Pulizia a fondo',
    desc: 'Superfici e giunzioni pensate per una pulizia accurata tra le lavorazioni.',
  },
];

const productListLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: machines.map((m, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Product',
      name: m.title,
      description: m.description,
      category: "Macchinari industriali per l'agroalimentare",
      brand: {
        '@type': 'Brand',
        name: 'Pitter Italy',
      },
    },
  })),
};

const breadcrumb = breadcrumbLd(
  [
    { name: "Pitter Italy", path: "/pitter-italy" },
    { name: "Macchinari", path: Astro.url.pathname },
  ],
  Astro.site,
);
---

<BranchLayout
  branchId="pitter"
  title="Macchinari Industriali Agroalimentari — Pitter Italy"
  description="Snocciolatrici industriali, lavatartufi e linee di lavorazione complete in acciaio inox. Progettazione su misura per PMI agroalimentari."
  structuredData={[productListLd, breadcrumb]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Macchinari"

    title="Acciaio inox. Progettato per lavorare sul serio."
    titleAccent="lavorare"
    subtitle="Snocciolatrici industriali, lavafrutti e linee complete per la trasformazione agroalimentare. Ogni macchina è progettata sulle tue specifiche e collaudata nei nostri impianti prima dell'installazione."
    ctas={[
      { label: 'Richiedi un preventivo', href: '/pitter-italy/contatti', variant: 'primary' },
      { label: 'La nostra prova',        href: '/pitter-italy#prova', variant: 'outline' },
    ]}
    bgVariant="radial"
    topOffset="nav-full"
  />

  <!-- CATALOGO -->
  <section class="section-px section-py max-w-container mx-auto">
    <SectionHeader
      number="02"
      label="Catalogo Prodotti"
      heading="Le macchine"
      size="lg"
      lead="Tutti i macchinari sono disponibili con personalizzazioni su capacità, tensione di alimentazione e configurazione del layout."
      class="mb-14"
    />

    <div class="flex flex-col gap-6 machines-list">
      {
        machines.map((m, i) => (
          <article
            id={m.id}
            class="machine-card rounded-bento bg-surface-01 border border-hairline overflow-hidden hover:border-hairline-strong transition-colors duration-300"
          >
            <div class:list={["flex flex-col md:flex-row", i % 2 === 1 && "md:flex-row-reverse"]}>
              {/* Foto reale della macchina (I-1): mostrata, non nascosta */}
              <div class="relative md:w-2/5 shrink-0 aspect-[4/3] md:aspect-auto md:min-h-[320px] border-b md:border-b-0 border-hairline">
                <Picture
                  src={m.img}
                  alt={m.imgAlt}
                  widths={[400, 700, 1000]}
                  sizes="(min-width: 768px) 40vw, 100vw"
                  formats={["avif", "webp"]}
                  fallbackFormat="webp"
                  quality={64}
                  loading="lazy"
                  decoding="async"
                  class="img-fade absolute inset-0 w-full h-full object-cover"
                />
              </div>

              <div class="md:w-3/5 p-8 flex flex-col gap-6">
                <div class="flex items-center gap-4">
                  <Badge variant={m.badge.variant} dot>
                    {m.badge.label}
                  </Badge>
                  <span class="font-clash text-3xl font-bold text-wtc-orange/15">
                    {m.number}
                  </span>
                </div>

                <div>
                  <h3 class="font-clash font-semibold text-display-sm text-white mb-3">
                    {m.title}
                  </h3>
                  <p class="prose-body-sm text-ice-grey/60 max-w-2xl">
                    {m.description}
                  </p>
                </div>

                {/* Progressive disclosure: la card afferma, il dettaglio si apre */}
                <Disclosure summary="Dettagli e personalizzazioni" class="border-t border-hairline pt-4 mt-auto">
                  <ul class="flex flex-wrap gap-2 pt-4 pb-2">
                    {m.features.map((f) => (
                      <li class="px-3 py-1 rounded prose-caption text-ice-grey/60 border border-hairline bg-veil">
                        {f}
                      </li>
                    ))}
                  </ul>
                </Disclosure>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- MATERIALI -->
  <section class="section-px section-py max-w-container mx-auto border-t border-hairline">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div class="flex flex-col gap-7">
        <SectionLabel number="03" label="Standard Materiali" />
        <h2 class="font-clash font-semibold text-display-md text-white">
          Solo materiali<br />
          <span class="text-wtc-orange">conformi all'uso alimentare.</span>
        </h2>
        <p class="prose-body text-ice-grey/55">
          Tutti i componenti a contatto con l'alimento sono idonei all'uso alimentare. Acciaio, gomme e plastiche sono scelti per resistere ai detergenti usati nella pulizia.
        </p>
        <p class="prose-body text-ice-grey/55">
          La documentazione della macchina è fornita alla consegna, utile per le ispezioni nelle lavorazioni alimentari.
        </p>
        <Button href="/pitter-italy/contatti" variant="outline" class="link-arrow">
          Richiedi documentazione tecnica <span aria-hidden="true">→</span>
        </Button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {
          materiali.map((mat) => (
            <div class="material-card p-6 rounded-xl bg-surface-01 border border-hairline flex flex-col gap-3 hover:border-wtc-orange/20 transition-colors duration-300">
              <span class="font-clash font-semibold text-lg text-wtc-orange">
                {mat.label}
              </span>
              <p class="prose-body-sm text-ice-grey/55">
                {mat.desc}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- IL VANTAGGIO PITTER -->
  <section class="section-px section-py max-w-container mx-auto border-t border-hairline">
    <SectionLabel number="04" label="Il Vantaggio Pitter" class="mb-12" />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 advantage-grid">
      {[
        {
          title: 'Collaudo reale',
          desc: 'Ogni macchina viene testata nei nostri impianti WTC Food prima della consegna. Usiamo quello che vendiamo.',
          icon: '✓',
        },
        {
          title: 'Assistenza diretta',
          desc: 'Il tecnico che ha progettato la macchina è lo stesso che risponde al telefono. Nessun call center.',
          icon: '✓',
        },
        {
          title: 'Ricambi garantiti',
          desc: 'Stock permanente. Ricambi consegnati in tempi rapidi in tutta Italia. Fermo produzione ridotto al minimo.',
          icon: '✓',
        },
      ].map((adv) => (
        <div class="advantage-card p-8 rounded-bento bg-surface-01 border border-hairline flex flex-col gap-4 hover:border-hairline-strong transition-colors duration-300">
          <span class="font-clash text-2xl text-wtc-orange">{adv.icon}</span>
          <h3 class="font-clash font-semibold text-lg text-white">
            {adv.title}
          </h3>
          <p class="prose-body-sm text-ice-grey/55">
            {adv.desc}
          </p>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Stai cercando un macchinario specifico?"
    subtext="Inviaci le tue esigenze di produzione: prodotto, volumi, spazio disponibile. Ti risponde un tecnico Pitter Italy in tempi rapidi con una valutazione concreta."
    actions={[
      { label: 'Richiedi un preventivo', href: '/pitter-italy/contatti', variant: 'primary' },
      { label: 'La nostra prova',        href: '/pitter-italy#prova', variant: 'outline' },
    ]}
  />
</BranchLayout>

<script>
  import { gsap } from '@/lib/gsap';

  document.addEventListener('astro:page-load', () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.fromTo('.machine-card', 
      {
        y: 50,
        opacity: 0,
      },
      {
        scrollTrigger: { trigger: '.machines-list', start: 'top 88%', once: true },
        y: 0,
        opacity: 1,
        stagger: 0.12,
        duration: 0.8,
        ease: 'power3.out',
      }
    );

    gsap.fromTo('.material-card', 
      {
        y: 30,
        opacity: 0,
      },
      {
        scrollTrigger: { trigger: '.material-card', start: 'top 88%', once: true },
        y: 0,
        opacity: 1,
        stagger: 0.1,
        duration: 0.7,
        ease: 'power3.out',
      }
    );

    gsap.fromTo('.advantage-card', 
      {
        y: 40,
        opacity: 0,
      },
      {
        scrollTrigger: { trigger: '.advantage-grid', start: 'top 88%', once: true },
        y: 0,
        opacity: 1,
        stagger: 0.1,
        duration: 0.75,
        ease: 'power3.out',
      }
    );
  });
</script>
