---
import BranchLayout from "../../layouts/BranchLayout.astro";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import Timeline from "../../components/sections/Timeline.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
const methodSteps = [
  {
    number: "01",
    tag: "Prima della crisi",
    title: "Protocolli pre-autorizzati",
    description:
      "Prima che qualcosa vada storto, definiamo insieme i protocolli di intervento: chi autorizza cosa, quali sistemi possiamo toccare, quali procedure sono pre-approvate. In emergenza, non aspettiamo l'approvazione di chi in quel momento è irraggiungibile.",
  },
  {
    number: "02",
    tag: "Rilevazione anomalia",
    title: "Allerta prima che tu lo sappia",
    description:
      "I nostri sistemi di monitoraggio rilevano l'anomalia, che sia un picco di CPU, un tentativo di accesso non autorizzato o un disco vicino alla saturazione. Tu non apri un ticket: il primo segnale arriva a noi.",
  },
  {
    number: "03",
    tag: "Mentre la burocrazia si scalda",
    title: "Azione immediata in parallelo",
    description:
      "Il processo interno standard è: rilevazione → ticket → assegnazione → approvazione → escalation → procurement → azione. Noi agiamo subito, in parallelo: il tuo sistema burocratico completa i passi successivi senza che nessuno venga saltato.",
  },
  {
    number: "04",
    tag: "Durante l'incidente",
    title: "Comunicazione strutturata",
    description:
      "Mentre i tecnici lavorano, il coordinatore WTC gestisce la comunicazione: aggiornamenti regolari al referente aziendale, briefing alla direzione se richiesto, template per comunicazione ai dipendenti e clienti. Nessuno resta all'oscuro.",
  },
  {
    number: "05",
    tag: "Risoluzione",
    title: "Ripristino e stabilizzazione",
    description:
      "Il problema è risolto. Ma il lavoro non finisce qui: stabilizzazione del sistema, verifica che la causa di fondo non possa ripresentarsi, monitoraggio intensivo nelle ore successive.",
  },
  {
    number: "06",
    tag: "A freddo",
    title: "Analisi e prevenzione",
    description:
      "Dopo l'incidente: report completo con cronologia, analisi delle cause e piano di prevenzione per eliminare definitivamente quel vettore di rischio.",
  },
];

const comparisons = [
  {
    label: "Tempo prima di intervento reale",
    wtc: "Immediato",
    standard: "Dopo la coda interna",
    highlight: true,
  },
  {
    label: "Interlocutore durante la crisi",
    wtc: "Tecnico senior",
    standard: "Helpdesk standard",
  },
  {
    label: "Autorizzazione ad agire",
    wtc: "Pre-autorizzata",
    standard: "Da richiedere in tempo reale",
  },
  {
    label: "Comunicazione aggiornamenti",
    wtc: "A intervalli regolari",
    standard: "Su richiesta",
  },
  {
    label: "Report post-incidente",
    wtc: "Dettagliato, incluso",
    standard: "Opzionale / su richiesta",
  },
  {
    label: "Piano prevenzione recidiva",
    wtc: "Incluso sempre",
    standard: "Venduto separatamente",
  },
];

const breadcrumb = breadcrumbLd(
  [
    { name: "WTC Services", path: "/services" },
    { name: "Il Metodo WTC", path: Astro.url.pathname },
  ],
  Astro.site,
);
---

<BranchLayout
  branchId="services"
  title="Il Metodo WTC — Come Interveniamo"
  description="Protocolli pre-autorizzati, azione in parallelo alla burocrazia, comunicazione strutturata. Come WTC bypassa le code interne senza saltare nessun processo."
  structuredData={[breadcrumb]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Il Metodo"

    title="Agiamo mentre la burocrazia si scalda."
    titleAccent="burocrazia"
    subtitle="In ogni azienda strutturata, un problema tecnico attraversa: rilevazione, ticket, assegnazione, approvazione, escalation. WTC ha protocolli pre-autorizzati che ci permettono di agire al passo uno, mentre il tuo sistema gestisce i passi successivi."
    bgVariant="radial"
    canvas="services"
    topOffset="nav-full"
    minHeight="min-h-[65vh]"
  />

  <!-- THE PROBLEM -->
  <section class="section-px section-py max-w-container mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <div class="flex flex-col gap-6">
        <SectionHeader number="01" label="Il Problema Reale">
          Ogni minuto conta.<br />
          <span class="text-wtc-orange">La burocrazia no.</span>
        </SectionHeader>
        <p class="prose-body text-ice-grey/60 js-reveal">
          Hai un fornitore IT. Un problema critico emerge all'inizio di una
          giornata di lavoro qualsiasi. Cosa succede nei minuti successivi?
        </p>
        <p class="prose-body text-ice-grey/60 js-reveal">
          Il tuo responsabile IT invia una mail. Apre un ticket. Il fornitore
          classifica la severity. Qualcuno deve approvare l'intervento urgente.
          Il tecnico senior è già su un altro cliente. L'escalation richiede
          l'ok del loro responsabile. Nel frattempo, un tuo sistema critico è
          offline.
        </p>
        <p class="prose-body text-ice-grey/60 js-reveal">
          Non è colpa di nessuno: è il processo standard. Ed è proprio quello
          che WTC ha eliminato.
        </p>
      </div>

      <!-- Standard process visual -->
      <div class="flex flex-col gap-2">
        <p
          class="font-inter text-xs text-ice-grey/60 uppercase tracking-widest mb-2"
        >
          Processo standard vs WTC
        </p>
        {
          [
            {
              step: "Rilevazione problema",
              std: "Sì",
              wtc: "Sì",
              stdOk: true,
            },
            {
              step: "Apertura ticket",
              std: "In coda",
              wtc: "—",
              stdOk: false,
            },
            {
              step: "Assegnazione tecnico",
              std: "In coda",
              wtc: "—",
              stdOk: false,
            },
            {
              step: "Approvazione urgenza",
              std: "In coda",
              wtc: "—",
              stdOk: false,
            },
            {
              step: "Primo intervento reale",
              std: "Dopo la coda",
              wtc: "Subito",
              stdOk: false,
            },
          ].map((row) => (
            <div class="grid grid-cols-3 gap-2">
              <span class="font-inter text-xs text-ice-grey/60 py-2">
                {row.step}
              </span>
              <div
                class:list={[
                  "rounded px-3 py-2 text-center font-inter text-xs font-medium",
                  row.stdOk
                    ? "bg-veil text-ice-grey/60"
                    : "bg-red-950/40 text-red-400 border border-red-900/30",
                ]}
              >
                {row.std}
              </div>
              <div
                class:list={[
                  "rounded px-3 py-2 text-center font-inter text-xs font-bold",
                  "bg-wtc-orange/10 text-wtc-orange border border-wtc-orange/20",
                ]}
              >
                {row.wtc}
              </div>
            </div>
          ))
        }
        <div class="grid grid-cols-3 gap-2 mt-1">
          <span></span>
          <span
            class="text-center prose-caption text-red-400 uppercase tracking-widest"
            >Standard</span
          >
          <span
            class="text-center prose-caption text-wtc-orange uppercase tracking-widest"
            >WTC</span
          >
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE DEL METODO -->
  <section
    class="section-px section-py max-w-container mx-auto border-t border-hairline"
  >
    <SectionHeader
      number="02"
      label="I 6 Step del Metodo"
      size="lg"
      lead="Il metodo WTC è un protocollo documentato, che eseguiamo uguale in ogni intervento: ogni passaggio è misurabile, ogni responsabilità assegnata."
      class="mb-16"
    >
      Dal monitoraggio<br />
      <span class="text-wtc-orange">all'autopsia.</span>
    </SectionHeader>

    <Timeline steps={methodSteps} />
  </section>

  <!-- COMPARISON TABLE -->
  <section
    class="section-px section-py max-w-container mx-auto border-t border-hairline"
  >
    <SectionHeader number="03" label="Confronto" class="mb-12">
      WTC vs supporto<br />
      <span class="text-wtc-orange">standard.</span>
    </SectionHeader>

    <div
      class="rounded-bento bg-surface-01 border border-hairline overflow-x-auto"
    >
      <div class="min-w-[520px]">
      <div
        class="grid grid-cols-3 gap-0 border-b border-hairline bg-surface-02"
      >
        <div
          class="p-4 font-inter text-xs text-ice-grey/60 uppercase tracking-widest"
        >
          Parametro
        </div>
        <div
          class="p-4 font-inter text-xs text-ice-grey/60 uppercase tracking-widest border-l border-hairline"
        >
          Supporto Standard
        </div>
        <div
          class="p-4 font-inter text-xs text-wtc-orange uppercase tracking-widest border-l border-hairline"
        >
          Metodo WTC
        </div>
      </div>

      {
        comparisons.map((row) => (
          <div
            class:list={[
              "comparison-row grid grid-cols-3 gap-0 border-b border-hairline last:border-0",
              row.highlight ? "bg-wtc-orange/[0.04]" : "",
            ]}
          >
            <div class="p-4 font-inter text-sm text-ice-grey/70">
              {row.label}
            </div>
            <div class="p-4 font-inter text-sm text-red-400/70 border-l border-hairline">
              {row.standard}
            </div>
            <div class="p-4 font-inter text-sm font-semibold text-wtc-orange border-l border-hairline">
              {row.wtc}
            </div>
          </div>
        ))
      }
      </div><!-- /min-w -->
    </div>
  </section>

  <!-- WHAT WE DON'T SKIP -->
  <section class="section-px pb-24 max-w-container mx-auto">
    <div
      class="rounded-bento border border-hairline bg-surface-01 p-8 md:p-12"
    >
      <SectionLabel label="Attenzione" class="mb-6" />
      <h3
        class="font-clash font-semibold text-display-sm text-white mb-4"
      >
        Azione in anticipo, non evasione delle regole
      </h3>
      <p class="prose-body text-ice-grey/60 max-w-2xl">
        I nostri protocolli pre-autorizzati vengono definiti <strong
          class="text-white">prima</strong
        > dell'emergenza, insieme al tuo IT manager e al tuo management. Sappiamo
        cosa possiamo toccare, come lo documentiamo e come lo comunichiamo.
      </p>
      <p class="prose-body text-ice-grey/60 max-w-2xl mt-4">
        Non saltiamo la burocrazia, la anticipiamo. Tutto quello che facciamo è
        documentato, reversibile e comunicato. Il tuo team interno rimane sempre
        nel loop.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Vuoi vedere il Metodo in azione?"
    subtext="Organizziamo una sessione con il tuo IT manager per mostrare esattamente come funzionano i nostri protocolli sul tuo specifico scenario."
    actions={[
      {
        label: "Richiedi una sessione",
        href: "/services/contatti",
        variant: "primary",
      },
      {
        label: "Pronto intervento",
        href: "/services/emergency-it",
        variant: "outline",
      },
    ]}
  />
</BranchLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.fromTo(
      ".comparison-row",
      { opacity: 0, x: -16 },
      {
        scrollTrigger: { trigger: ".comparison-row", start: "top 88%", once: true },
        opacity: 1,
        x: 0,
        stagger: 0.06,
        duration: 0.5,
        ease: "power3.out",
      },
    );

    gsap.utils.toArray<Element>(".js-reveal").forEach((el) => {
      gsap.fromTo(
        el,
        {
          y: 36,
          opacity: 0,
          scale: 0.97,
        },
        {
          scrollTrigger: {
            trigger: el,
            start: "top 88%",
            toggleActions: "play none none none",
            once: true,
          },
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: "power3.out",
        },
      );
    });
  });
</script>
