---
import ServicesLayout from "../../layouts/branch/ServicesLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import Timeline from "../../components/sections/Timeline.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import Button from "../../components/ui/Button.astro";

const timelineSteps = [
  {
    number: "01",
    tag: "Contatto",
    title: "Contatto ricevuto",
    description:
      "Il tuo referente WTC risponde direttamente. Nessun IVR, nessun modulo da compilare. Un tecnico senior comprende subito il contesto e classifica la severity in tempo reale.",
  },
  {
    number: "02",
    tag: "Attivazione",
    title: "Team attivato",
    description:
      "Il profilo dell'incidente determina la composizione del team. L'accesso ai sistemi viene stabilito mentre sei ancora in chiamata, senza un secondo passaggio.",
  },
  {
    number: "03",
    tag: "Diagnosi",
    title: "Diagnosi in corso",
    description:
      "I tecnici sono sui sistemi. Prima stima della causa root e dei tempi di ripristino comunicata rapidamente, con aggiornamenti regolari fino alla risoluzione.",
  },
  {
    number: "04",
    tag: "Ripristino",
    title: "Ripristino e stabilizzazione",
    description:
      "Risoluzione del blocco critico. Il sistema torna operativo. In parallelo: analisi delle cause, contenimento del rischio residuo e aggiornamento strutturato a tutte le parti coinvolte.",
  },
  {
    number: "05",
    tag: "Follow-up",
    title: "Report post-intervento",
    description:
      "Documento tecnico completo: timeline dell'incidente, causa root, azioni eseguite, raccomandazioni per prevenire la recidiva. Pronto per la direzione o per l'auditor.",
  },
];

const scenarios = [
  {
    title: "Server irraggiungibile",
    desc: "Crash hardware, kernel panic, BSOD su sistemi di produzione. Ripristino o failover immediato.",
  },
  {
    title: "Database offline",
    desc: "I database aziendali non rispondono. Recovery da backup, analisi della corruzione, sblocco di lock critici.",
  },
  {
    title: "Incidente di sicurezza",
    desc: "Attività anomala, accesso non autorizzato, ransomware in corso. Contenimento, isolamento rete, incident response.",
  },
  {
    title: "Connettività aziendale",
    desc: "Sedi remote isolate, VPN corporate non disponibile, firewall bloccato. Ripristino e analisi della causa.",
  },
  {
    title: "Perdita dati critica",
    desc: "File cancellati, NAS corrotto, backup fallito silenziosamente. Recovery forense con priorità ai dati business-critical.",
  },
  {
    title: "Posta e comunicazioni",
    desc: "Posta aziendale non disponibile, anomalie sugli strumenti di collaborazione. Le comunicazioni aziendali ripristinate nel minor tempo possibile.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'WTC Services',
      item: new URL('/services', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Pronto Intervento IT',
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};
---

<ServicesLayout
  title="Pronto Intervento IT — WTC Services"
  description="Risposta rapida per interruzioni operative critiche: server giù, database offline, incidenti di sicurezza. WTC interviene con un team, non con un ticket."
  structuredData={[breadcrumbLd]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Pronto Intervento"

    title="Un'interruzione operativa ha un costo reale. Ogni minuto."
    titleAccent="costo reale"
    subtitle="WTC interviene sulle interruzioni IT critiche con un team già operativo, protocolli pre-autorizzati e comunicazione strutturata verso la tua direzione. Si parte subito, senza code."
    ctas={[
      {
        label: "Richiedi un intervento",
        href: "/services/contatti",
        variant: "primary",
      },
      {
        label: "Come interveniamo",
        href: "/services/method",
        variant: "outline",
      },
    ]}
    bgVariant="radial"
    canvas="services"
    topOffset="nav-full"
  />

  <!-- SCENARI -->
  <section class="section-px section-py max-w-[1600px] mx-auto">
    <div class="flex flex-col gap-4 mb-14">
      <SectionLabel number="02" label="Scenari di Intervento" />
      <h2
        class="font-clash font-semibold text-display-lg text-white uppercase max-w-2xl js-reveal"
      >
        Cosa gestiamo
      </h2>
      <p class="prose-lead text-ice-grey/55 max-w-xl mt-2 js-reveal">
        Questi sono i sei scenari più frequenti. Se la tua situazione non
        rientra in nessuno, contattaci comunque: il protocollo si adatta.
      </p>
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 scenarios-grid"
    >
      {
        scenarios.map((s, i) => (
          <div
            class:list={[
              "scenario-card group relative rounded-bento bg-surface-01 border border-white/[0.06] p-8 flex flex-col gap-4 hover:border-white/[0.12] transition duration-400",
              i === 0 && "lg:col-span-2",
            ]}
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-clash font-semibold text-lg text-white uppercase">
                {s.title}
              </h3>
              <span class="font-clash font-bold text-4xl leading-none tabular-nums flex-shrink-0 text-white/[0.05] group-hover:text-white/[0.10] transition duration-500">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>
            <p class="prose-body text-ice-grey/55">
              {s.desc}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- COSTO DOWNTIME -->
  <section
    class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.05]"
  >
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="flex flex-col gap-7">
        <SectionLabel number="03" label="Il Costo del Fermo" />
        <h2
          class="font-clash font-semibold text-display-md text-white uppercase js-reveal"
        >
          Ogni ora ferma<br />
          <span class="text-wtc-orange">ha un costo reale.</span>
        </h2>
        <p
          class="prose-body text-ice-grey/55 js-reveal"
        >
          Un'interruzione IT non blocca solo i sistemi: ferma la produttività
          delle persone, sospende ordini e fatturato, complica la gestione dei
          clienti e mette a rischio la reputazione dell'azienda.
        </p>
        <p
          class="prose-body text-ice-grey/55 js-reveal"
        >
          Più a lungo dura il fermo, più questi costi si sommano. Intervenire in
          fretta significa contenerli: è per questo che rispondiamo con un team
          già operativo, non con l'apertura di un ticket.
        </p>
        <div>
          <Button href="/services/contatti" variant="outline">
            Parla con il team →
          </Button>
        </div>
      </div>

      <!-- Cost categories -->
      <div class="flex flex-col gap-4">
        {
          [
            "Produttività delle persone ferma",
            "Ordini e fatturato sospesi",
            "Gestione dei clienti compromessa",
            "Rischio reputazionale",
          ].map((label) => (
            <div class="cost-bar-item flex items-center gap-4 rounded-bento bg-surface-01 border border-white/[0.06] p-5">
              <span class="w-8 h-[1px] bg-wtc-orange/50 flex-shrink-0" />
              <span class="font-inter text-base text-ice-grey/70">{label}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- TIMELINE INTERVENTO -->
  <section
    class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.05]"
  >
    <div class="flex flex-col gap-4 mb-16">
      <SectionLabel number="04" label="Il Protocollo di Intervento" />
      <h2
        class="font-clash font-semibold text-display-md text-white uppercase max-w-2xl js-reveal"
      >
        Dalla chiamata<br />
        <span class="text-wtc-orange">al ripristino.</span>
      </h2>
      <p class="prose-body text-ice-grey/55 max-w-lg mt-2 js-reveal">
        Il protocollo WTC è collaudato sul campo. Ogni passaggio è definito e
        ogni responsabilità assegnata in anticipo.
      </p>
    </div>

    <Timeline steps={timelineSteps} />
  </section>

  <!-- CTA -->
  <CTASection
    headline="Hai una situazione che non può aspettare?"
    subtext="Contatta il team WTC. Valutiamo il tuo scenario e ti diciamo cosa possiamo fare, senza impegno."
    actions={[
      {
        label: "Contatta il team",
        href: "/services/contatti",
        variant: "primary",
      },
      {
        label: "Come interveniamo",
        href: "/services/method",
        variant: "outline",
      },
    ]}
  />
</ServicesLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.utils.toArray<Element>(".js-reveal").forEach((el) => {
      gsap.fromTo(
        el,
        {
          y: 36,
          opacity: 0,
          scale: 0.97,
        },
        {
          scrollTrigger: {
            trigger: el,
            start: "top 88%",
            toggleActions: "play none none none",
            once: true,
          },
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: "power3.out",
        },
      );
    });

    gsap.fromTo(
      ".scenario-card",
      {
        y: 40,
        opacity: 0,
      },
      {
        scrollTrigger: { trigger: ".scenarios-grid", start: "top 88%", once: true },
        y: 0,
        opacity: 1,
        stagger: 0.08,
        duration: 0.85,
        ease: "power3.out",
      },
    );

    // Fade in the container rows first
    gsap.fromTo(
      ".cost-bar-item",
      { opacity: 0, y: 12 },
      {
        scrollTrigger: { trigger: ".cost-bar-item", start: "top 88%", once: true },
        opacity: 1,
        y: 0,
        stagger: 0.1,
        duration: 0.5,
        ease: "power3.out",
      },
    );

  });
</script>
