---
import ServicesLayout from "../../layouts/branch/ServicesLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import StatsRow from "../../components/sections/StatsRow.astro";
import CTASection from "../../components/sections/CTASection.astro";
import Timeline from "../../components/sections/Timeline.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import Button from "../../components/ui/Button.astro";
import ImagePlaceholder from "../../components/ui/ImagePlaceholder.astro";

const timelineSteps = [
  {
    number: "01",
    tag: "T+0",
    title: "Contatto ricevuto",
    description:
      "Il tuo referente WTC risponde direttamente. Nessun IVR, nessun modulo da compilare. Un tecnico senior comprende subito il contesto e classifica la severity in tempo reale.",
    duration: "< 2 minuti",
  },
  {
    number: "02",
    tag: "T+5 min",
    title: "Team attivato",
    description:
      "Il profilo dell'incidente determina la composizione del team. L'accesso ai sistemi viene stabilito mentre sei ancora in chiamata: nessun secondo passaggio, nessuna attesa.",
    duration: "< 5 minuti",
  },
  {
    number: "03",
    tag: "T+15 min",
    title: "Diagnosi in corso",
    description:
      "I tecnici sono sui sistemi. Prima stima della causa root e del tempo di ripristino comunicata entro questo intervallo, con aggiornamenti regolari fino alla risoluzione.",
    duration: "< 15 minuti",
  },
  {
    number: "04",
    tag: "T+variabile",
    title: "Ripristino e stabilizzazione",
    description:
      "Risoluzione del blocco critico. Il sistema torna operativo. In parallelo: analisi delle cause, contenimento del rischio residuo e aggiornamento strutturato a tutte le parti coinvolte.",
    duration: "Dipende dalla severity",
  },
  {
    number: "05",
    tag: "T+24h",
    title: "Report post-intervento",
    description:
      "Documento tecnico completo: timeline dell'incidente, causa root, azioni eseguite, raccomandazioni per prevenire la recidiva. Pronto per la direzione o per l'auditor.",
    duration: "Entro 24 ore",
  },
];

const scenarios = [
  {
    title: "Server irraggiungibile",
    desc: "Crash hardware, kernel panic, BSOD su sistemi di produzione. Ripristino o failover immediato.",
  },
  {
    title: "Database offline",
    desc: "Oracle, SQL Server, PostgreSQL non rispondono. Recovery da backup, analisi della corruzione, sblocco di lock critici.",
  },
  {
    title: "Incidente di sicurezza",
    desc: "Attività anomala, accesso non autorizzato, ransomware in corso. Contenimento, isolamento rete, incident response.",
  },
  {
    title: "Connettività aziendale",
    desc: "Sedi remote isolate, VPN corporate non disponibile, firewall bloccato. Ripristino e analisi della causa.",
  },
  {
    title: "Perdita dati critica",
    desc: "File cancellati, NAS corrotto, backup fallito silenziosamente. Recovery forense con priorità ai dati business-critical.",
  },
  {
    title: "Posta e comunicazioni",
    desc: "Exchange non disponibile, anomalie Microsoft 365. Le comunicazioni aziendali ripristinate nel minor tempo possibile.",
  },
];
---

<ServicesLayout
  title="Pronto Intervento IT — WTC Services"
  description="Risposta rapida per interruzioni operative critiche: server giù, database offline, incidenti di sicurezza. WTC interviene con un team, non con un ticket."
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Pronto Intervento"

    title="Un'interruzione operativa ha un costo reale. Ogni minuto."
    titleAccent="costo reale"
    subtitle="WTC interviene sulle interruzioni IT critiche con un team già operativo, protocolli pre-autorizzati e comunicazione strutturata verso la tua direzione. Senza code, senza attese."
    ctas={[
      {
        label: "Richiedi un intervento",
        href: "/team/vip-accreditation",
        variant: "primary",
      },
      {
        label: "Vedi i case study",
        href: "/services/vault",
        variant: "outline",
      },
    ]}
    bgVariant="radial"
    canvas="services"
    topOffset="nav-full"
  />

  <!-- STATS -->
  <StatsRow
    stats={[
      {
        value: "15",
        suffix: " min",
        label: "Tempo massimo di risposta garantito contrattualmente",
      },
      {
        value: "98",
        suffix: ".7%",
        label: "Incidenti risolti nella stessa giornata lavorativa",
        decimals: 1,
      },
      {
        value: "47",
        suffix: "",
        label: "Interventi documentati nel periodo 2022–2024",
      },
      {
        value: "0",
        suffix: "",
        label: "Riscatti pagati su infrastrutture gestite da WTC",
      },
    ]}
  />

  <!-- SCENARI -->
  <section class="section-px section-py max-w-[1600px] mx-auto">
    <div class="flex flex-col gap-4 mb-14">
      <SectionLabel number="02" label="Scenari di Intervento" />
      <h2
        class="font-clash font-semibold text-display-lg text-white uppercase max-w-2xl js-reveal"
      >
        Cosa gestiamo
      </h2>
      <p class="font-inter text-lg text-ice-grey/55 max-w-xl mt-2 js-reveal">
        Questi sono i sei scenari più frequenti. Se la tua situazione non
        rientra in nessuno, contattaci comunque: il protocollo si adatta.
      </p>
    </div>

    <div
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 scenarios-grid"
    >
      {
        scenarios.map((s, i) => (
          <div
            class:list={[
              "scenario-card group relative rounded-bento bg-surface-01 border border-white/[0.06] p-8 flex flex-col gap-4 hover:border-white/[0.12] transition duration-400",
              i === 0 && "lg:col-span-2",
            ]}
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-clash font-semibold text-lg text-white uppercase">
                {s.title}
              </h3>
              <span class="font-clash font-bold text-4xl leading-none tabular-nums flex-shrink-0 text-white/[0.05] group-hover:text-white/[0.10] transition duration-500">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>
            <p class="font-inter text-base text-ice-grey/55 leading-relaxed">
              {s.desc}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- COSTO DOWNTIME -->
  <section
    class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.05]"
  >
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="flex flex-col gap-7">
        <SectionLabel number="03" label="Il Costo del Fermo" />
        <h2
          class="font-clash font-semibold text-display-md text-white uppercase js-reveal"
        >
          Ogni ora ferma costa<br />
          <span class="text-wtc-orange">più di un anno di contratto.</span>
        </h2>
        <p
          class="font-inter text-base text-ice-grey/55 leading-relaxed js-reveal"
        >
          Per una PMI italiana con 50 dipendenti, un'ora di fermo IT costa in
          media <strong class="text-white font-semibold">€&nbsp;8.500</strong> tra
          produttività persa, ordini bloccati e gestione dei clienti.
        </p>
        <p
          class="font-inter text-base text-ice-grey/55 leading-relaxed js-reveal"
        >
          Per un istituto bancario con 200 dipendenti, quella cifra supera <strong
            class="text-white font-semibold">€&nbsp;70.000 per ora</strong
          >.
        </p>
        <p
          class="font-inter text-base text-ice-grey/55 leading-relaxed js-reveal"
        >
          Il costo di un intervento WTC è una frazione di questi numeri. Il
          nostro tempo massimo di risposta è definito contrattualmente.
        </p>
        <div>
          <Button href="/services/vault" variant="outline">
            Vedi i costi evitati reali →
          </Button>
        </div>
      </div>

      <!-- Cost breakdown bars -->
      <div class="flex flex-col gap-5">
        {
          [
            { label: "Produttività persa", pct: 45, color: "bg-wtc-orange" },
            { label: "Ordini e fatturato", pct: 28, color: "bg-wtc-orange/50" },
            { label: "Gestione clienti", pct: 16, color: "bg-white/25" },
            { label: "Rischio reputazionale", pct: 11, color: "bg-white/15" },
          ].map((item) => (
            <div class="cost-bar-item flex flex-col gap-2">
              <div class="flex items-center justify-between">
                <span class="font-inter text-sm text-ice-grey/60">
                  {item.label}
                </span>
                <span class="font-clash font-semibold text-sm text-white">
                  {item.pct}%
                </span>
              </div>
              <div class="h-1 rounded-full bg-white/[0.06] overflow-hidden">
                <div
                  class:list={[
                    "h-full rounded-full cost-bar",
                    item.color,
                  ]}
                  style={`width: ${item.pct}%`}
                />
              </div>
            </div>
          ))
        }
        <p class="font-inter text-xs text-ice-grey/30 mt-2">
          Elaborazione WTC su 47 interventi gestiti nel periodo 2022–2024
        </p>
      </div>
    </div>
  </section>

  <!-- PHOTO PLACEHOLDER -->
  <section class="section-px pb-6 max-w-[1600px] mx-auto">
    <ImagePlaceholder
      label="Team durante un intervento — foto da aggiungere"
      aspect="21/9"
    />
  </section>

  <!-- TIMELINE INTERVENTO -->
  <section
    class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.05]"
  >
    <div class="flex flex-col gap-4 mb-16">
      <SectionLabel number="04" label="Il Protocollo di Intervento" />
      <h2
        class="font-clash font-semibold text-display-md text-white uppercase max-w-2xl js-reveal"
      >
        Dalla chiamata<br />
        <span class="text-wtc-orange">al ripristino.</span>
      </h2>
      <p class="font-inter text-base text-ice-grey/55 max-w-lg mt-2 js-reveal">
        Il protocollo WTC è stato eseguito in oltre 47 interventi. Ogni step è
        misurabile, ogni responsabilità è assegnata in anticipo.
      </p>
    </div>

    <Timeline steps={timelineSteps} />
  </section>

  <!-- CTA -->
  <CTASection
    headline="Hai una situazione che non può aspettare?"
    subtext="Contatta il team WTC. Valutiamo il tuo scenario e ti diciamo cosa possiamo fare — senza impegni, senza pressioni."
    actions={[
      {
        label: "Contatta il team",
        href: "/team/vip-accreditation",
        variant: "primary",
      },
      {
        label: "Vedi i case study",
        href: "/services/vault",
        variant: "outline",
      },
    ]}
  />
</ServicesLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    gsap.utils.toArray<Element>(".js-reveal").forEach((el) => {
      gsap.fromTo(
        el,
        {
          y: 36,
          opacity: 0,
          scale: 0.97,
        },
        {
          scrollTrigger: {
            trigger: el,
            start: "top 88%",
            toggleActions: "play none none none",
            once: true,
          },
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: "power3.out",
        },
      );
    });

    gsap.fromTo(
      ".scenario-card",
      {
        y: 40,
        opacity: 0,
      },
      {
        scrollTrigger: { trigger: ".scenarios-grid", start: "top 88%", once: true },
        y: 0,
        opacity: 1,
        stagger: 0.08,
        duration: 0.85,
        ease: "power3.out",
      },
    );

    // Fade in the container rows first
    gsap.fromTo(
      ".cost-bar-item",
      { opacity: 0, y: 12 },
      {
        scrollTrigger: { trigger: ".cost-bar-item", start: "top 88%", once: true },
        opacity: 1,
        y: 0,
        stagger: 0.1,
        duration: 0.5,
        ease: "power3.out",
      },
    );

    // Then grow the bars
    gsap.fromTo(
      ".cost-bar",
      { scaleX: 0, opacity: 0 },
      {
        scrollTrigger: { trigger: ".cost-bar-item", start: "top 88%", once: true },
        scaleX: 1,
        opacity: 1,
        transformOrigin: "left center",
        stagger: 0.12,
        duration: 1,
        delay: 0.2,
        ease: "power3.out",
      },
    );
  });
</script>
