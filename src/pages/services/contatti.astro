---
import BranchLayout from "../../layouts/BranchLayout.astro";

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'WTC Services S.r.l.s.',
  email: 'wtc@wtcservices.it',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Leone XIII, 464',
    postalCode: '00165',
    addressLocality: 'Roma',
    addressCountry: 'IT',
  },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BranchLayout
  branchId="services"
  title="Contatti — WTC Services"
  description="Parla direttamente con il team IT di WTC Services. Assistenza, emergenze, infrastrutture di rete e cybersecurity: rispondiamo entro un giorno lavorativo."
  structuredData={[localBusinessLd]}
>
  <div class="pt-navbar lg:pt-nav-full">

    <!-- Hero -->
    <section class="section-py section-px max-w-container mx-auto">
      <div class="max-w-2xl">
        <p class="font-inter text-xs text-wtc-orange tracking-widest uppercase mb-4">WTC Services — Contatti</p>
        <h1 class="font-clash font-semibold text-display-lg md:text-display-xl text-white mb-6 text-balance">
          Parla con il team IT
        </h1>
        <p class="prose-lead text-text-muted max-w-lg">
          Hai un'infrastruttura da mettere in sicurezza, un'emergenza in corso o vuoi capire se possiamo diventare il tuo partner IT continuativo? Scrivi qui.
        </p>
      </div>
    </section>

    <div class="section-px max-w-container mx-auto">
      <div class="h-px bg-veil-strong"></div>
    </div>

    <!-- Form + Sidebar -->
    <section class="section-py section-px max-w-container mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16 items-start">

        <!-- Email CTA (2/3) -->
        <div class="lg:col-span-2">
          <div class="flex flex-col gap-6 rounded-bento border border-hairline bg-surface-01 p-8 sm:p-10">
            <p class="prose-caption text-wtc-orange tracking-widest uppercase">Scrivici</p>
            <h2 class="font-clash font-semibold text-display-sm text-white text-balance">
              Parla con il team IT via email.<br />Ti rispondiamo entro un giorno lavorativo.
            </h2>
            <p class="prose-body text-text-muted max-w-lg">
              Dicci quanti device gestite, se avete già un fornitore IT e cosa non funziona adesso. Più dettagli ci dai, più precisi saremo nella risposta.
            </p>
            <a
              href="mailto:wtc@wtcservices.it?subject=Richiesta%20WTC%20Services"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 font-inter text-xs font-medium tracking-wide uppercase bg-wtc-orange text-white rounded-lg hover:bg-wtc-neon transition-colors duration-200"
            >
              Scrivici una email →
            </a>
          </div>
        </div>

        <!-- Sidebar (1/3) -->
        <div class="lg:col-span-1 flex flex-col gap-6">

          <!-- Contatti diretti -->
          <div class="rounded-xl border border-hairline bg-surface-01/50 p-6 flex flex-col gap-5">
            <p class="prose-caption text-wtc-orange tracking-widest uppercase">Contatti diretti</p>

            <div class="flex flex-col gap-1">
              <p class="font-inter text-xs text-text-muted">Email</p>
              <a href="mailto:wtc@wtcservices.it" class="font-inter text-sm text-ice-grey hover:text-white transition-colors break-all">
                wtc@wtcservices.it
              </a>
            </div>

            <div class="flex flex-col gap-1">
              <p class="font-inter text-xs text-text-muted">Sede operativa</p>
              <p class="font-inter text-sm text-ice-grey leading-relaxed">
                Via Leone XIII, 464<br />
                00165 Roma (RM)
              </p>
            </div>

            <div class="pt-4 border-t border-hairline">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400 flex-shrink-0"></span>
                <p class="font-inter text-xs text-text-muted">Rispondiamo entro 1 giorno lavorativo</p>
              </div>
            </div>
          </div>

          <!-- Emergenza IT -->
          <div class="rounded-xl border border-wtc-orange/20 bg-wtc-orange/[0.04] p-6 flex flex-col gap-3">
            <p class="prose-caption text-wtc-orange tracking-widest uppercase">Emergenza in corso?</p>
            <p class="font-inter text-sm text-text-muted leading-relaxed">
              Per interventi urgenti (sistemi giù, attacco in corso, perdita di dati) il form non è il canale più veloce. Scrivi direttamente alla mail con oggetto URGENTE.
            </p>
            <a
              href="mailto:wtc@wtcservices.it?subject=URGENTE"
              class="inline-flex items-center gap-1.5 font-inter text-xs text-wtc-orange hover:text-wtc-neon transition-colors duration-200 group"
            >
              Scrivi urgenza
              <span class="group-hover:translate-x-0.5 transition-transform duration-200">→</span>
            </a>
          </div>

        </div>

      </div>
    </section>

  </div>
</BranchLayout>
