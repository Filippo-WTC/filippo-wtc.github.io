---
import BranchLayout from "../../layouts/BranchLayout.astro";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import HeroSection from "../../components/sections/HeroSection.astro";
import LogoGrid from "../../components/sections/LogoGrid.astro";
import CTASection from "../../components/sections/CTASection.astro";
import type { LogoItem } from "../../components/sections/LogoGrid.astro";

const partners: LogoItem[] = [
  { name: "Apple",                   slug: "apple", img: "/images/logos/partners/apple.svg" },
  { name: "ASUS",                    slug: "asus", img: "/images/logos/partners/asus.svg" },
  { name: "Samsung",                 slug: "samsung", img: "/images/logos/partners/samsung.svg" },
  { name: "Acer",                    slug: "acer", img: "/images/logos/partners/acer.svg" },
  { name: "Epson",                   slug: "epson", img: "/images/logos/partners/epson.svg" },
  { name: "Lenovo",                  slug: "lenovo", img: "/images/logos/partners/lenovo.svg" },
  { name: "LG",                      slug: "lg", img: "/images/logos/partners/lg.svg" },
  { name: "ESET",                    slug: "eset", img: "/images/logos/partners/eset.svg" },
  { name: "Dell",                    slug: "dell", img: "/images/logos/partners/dell.svg" },
  { name: "HP",                      slug: "hp", img: "/images/logos/partners/hp.svg" },
  { name: "Microsoft",               slug: "microsoft", img: "/images/logos/partners/microsoft.png" },
  { name: "Centreon",                slug: "centreon", img: "/images/logos/partners/centreon.png" },
  { name: "Acronis",                 slug: "acronis", img: "/images/logos/partners/acronis.svg" },
  { name: "YASHI",                   slug: "yashi", img: "/images/logos/partners/yashi.png" },
  { name: "Ubiquiti",                slug: "ubiquiti", img: "/images/logos/partners/ubiquiti.svg" },
  { name: "Cisco",                   slug: "cisco", img: "/images/logos/partners/cisco.svg" },
  { name: "Hewlett Packard Enterprise", slug: "hpe" },
  { name: "Poly",                    slug: "poly", img: "/images/logos/partners/poly.svg" },
];

const clients: LogoItem[] = [
  { name: "RDS",                slug: "rds", img: "/images/logos/clients/rds.svg" },
  { name: "Banca CF+",          slug: "banca-cf-plus", img: "/images/logos/clients/banca-cf-plus.svg" },
  { name: "Gardant",            slug: "gardant", img: "/images/logos/clients/gardant.svg" },
  { name: "EPM",                slug: "epm" },
  { name: "Meridian Group",     slug: "meridian-group" },
  { name: "Gruppocity",         slug: "gruppocity" },
  { name: "Sanatrix",           slug: "sanatrix" },
  { name: "Invitalia",          slug: "invitalia", img: "/images/logos/clients/invitalia.svg" },
  { name: "Intellitronika",     slug: "intellitronika", img: "/images/logos/clients/intellitronika.svg" },
  { name: "Banca del Fucino",   slug: "banca-del-fucino", img: "/images/logos/clients/banca-del-fucino.svg" },
  { name: "ALES",               slug: "ales", img: "/images/logos/clients/ales.png" },
];

const breadcrumb = breadcrumbLd(
  [
    { name: "WTC Services", path: "/services" },
    { name: "Partner e Clienti", path: Astro.url.pathname },
  ],
  Astro.site,
);
---

<BranchLayout
  branchId="services"
  title="Partner e Clienti — WTC Services"
  description="I partner tecnologici e i clienti che hanno scelto WTC Services. Un ecosistema costruito su collaborazioni operative con i principali vendor IT e organizzazioni che ci affidano infrastrutture critiche."
  structuredData={[breadcrumb]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Ecosistema"
    title="Un network costruito negli anni."
    titleAccent="network"
    subtitle="Dai produttori hardware (Dell, HP, Lenovo, Apple, Acer, ASUS) ai vendor di networking e sicurezza (Cisco, Ubiquiti, HPE, ESET, Acronis), fino agli istituti bancari e agli enti pubblici che ci affidano le loro infrastrutture critiche: qui trovi le relazioni tecniche e commerciali su cui costruiamo ogni progetto."
    bgVariant="radial"
    canvas="none"
    topOffset="nav-full"
  />

  <!-- PARTNER DI RIFERIMENTO -->
  <LogoGrid
    items={partners}
    baseImgPath="/images/logos/partners"
    sectionNumber="01"
    sectionLabel="Partner di riferimento"
    headline="Le tecnologie che integriamo."
    headlineAccent="integriamo"
    intro="Lavoriamo con i principali produttori e vendor del settore IT. Ogni partnership è operativa, non è solo un logo: accesso diretto al supporto tecnico avanzato, prezzi dedicati e canali di escalation che si traducono in un servizio migliore per i nostri clienti."
    borderTop={false}
  />

  <!-- CLIENTI DI FIDUCIA -->
  <LogoGrid
    items={clients}
    baseImgPath="/images/logos/clients"
    sectionNumber="02"
    sectionLabel="Clienti di fiducia"
    headline="Si fidano di noi."
    headlineAccent="fidano"
    intro="Banche, istituti finanziari, enti pubblici e aziende manifatturiere che hanno scelto WTC Services per la sicurezza dei dati e la continuità operativa dei sistemi centrali. La fiducia si costruisce intervento dopo intervento."
    borderTop={true}
  />

  <!-- CTA -->
  <CTASection
    headline="Vuoi entrare in questo ecosistema?"
    subtext="Contatta il team WTC: analizziamo la tua infrastruttura attuale e ti indichiamo quali vendor e quali competenze servono davvero per il tuo caso specifico."
    actions={[
      {
        label: "Parla con noi",
        href: "/services/contatti",
        variant: "primary",
      },
      {
        label: "I nostri servizi",
        href: "/services",
        variant: "outline",
      },
    ]}
  />
</BranchLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.utils.toArray<Element>(".js-reveal").forEach((el) => {
      gsap.fromTo(
        el,
        { y: 36, opacity: 0, scale: 0.97 },
        {
          scrollTrigger: {
            trigger: el,
            start: "top 88%",
            toggleActions: "play none none none",
            once: true,
          },
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: "power3.out",
        }
      );
    });
  });
</script>
