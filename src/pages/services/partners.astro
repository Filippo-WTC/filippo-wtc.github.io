---
import ServicesLayout from "../../layouts/branch/ServicesLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import LogoGrid from "../../components/sections/LogoGrid.astro";
import CTASection from "../../components/sections/CTASection.astro";
import type { LogoItem } from "../../components/sections/LogoGrid.astro";

const partners: LogoItem[] = [
  { name: "Apple",                   slug: "apple" },
  { name: "ASUS",                    slug: "asus" },
  { name: "Samsung",                 slug: "samsung" },
  { name: "Acer",                    slug: "acer" },
  { name: "Epson",                   slug: "epson" },
  { name: "Lenovo",                  slug: "lenovo" },
  { name: "LG",                      slug: "lg" },
  { name: "ESET",                    slug: "eset" },
  { name: "Dell",                    slug: "dell" },
  { name: "HP",                      slug: "hp" },
  { name: "Microsoft",               slug: "microsoft" },
  { name: "Centreon",                slug: "centreon" },
  { name: "Acronis",                 slug: "acronis" },
  { name: "YASHI",                   slug: "yashi" },
  { name: "Ubiquiti",                slug: "ubiquiti" },
  { name: "Cisco",                   slug: "cisco" },
  { name: "Hewlett Packard Enterprise", slug: "hpe" },
  { name: "Poly",                    slug: "poly" },
];

const clients: LogoItem[] = [
  { name: "RDS",                slug: "rds" },
  { name: "Banca CF+",          slug: "banca-cf-plus" },
  { name: "Gardant",            slug: "gardant" },
  { name: "EPM",                slug: "epm" },
  { name: "Meridian Group",     slug: "meridian-group" },
  { name: "Gruppocity",         slug: "gruppocity" },
  { name: "Sanatrix",           slug: "sanatrix" },
  { name: "Invitalia",          slug: "invitalia" },
  { name: "Intellitronika",     slug: "intellitronika" },
  { name: "Banca del Fucino",   slug: "banca-del-fucino" },
  { name: "ALES",               slug: "ales" },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'WTC Services',
      item: new URL('/services', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Partner e Clienti',
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};
---

<ServicesLayout
  title="Partner e Clienti — WTC Services"
  description="I partner tecnologici e i clienti che hanno scelto WTC Services. Un ecosistema costruito su collaborazioni operative con i principali vendor IT e organizzazioni che ci affidano infrastrutture critiche."
  structuredData={[breadcrumbLd]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Ecosistema"
    title="Un network costruito negli anni."
    titleAccent="network"
    subtitle="Dai produttori hardware (Dell, HP, Lenovo, Apple, Acer, ASUS) ai vendor di networking e sicurezza (Cisco, Ubiquiti, HPE, ESET, Acronis), fino agli istituti bancari e agli enti pubblici che ci affidano le loro infrastrutture critiche: qui trovi le relazioni tecniche e commerciali su cui costruiamo ogni progetto."
    bgVariant="radial"
    canvas="none"
    topOffset="nav-full"
  />

  <!-- PARTNER DI RIFERIMENTO -->
  <LogoGrid
    items={partners}
    baseImgPath="/images/logos/partners"
    sectionNumber="01"
    sectionLabel="Partner di riferimento"
    headline="Le tecnologie che integriamo."
    headlineAccent="integriamo"
    intro="Lavoriamo con i principali produttori e vendor del settore IT. Ogni partnership è operativa — non solo un logo: significa accesso diretto al supporto tecnico avanzato, prezzi dedicati e canali di escalation che si traducono in servizi più solidi per i nostri clienti."
    borderTop={false}
  />

  <!-- CLIENTI DI FIDUCIA -->
  <LogoGrid
    items={clients}
    baseImgPath="/images/logos/clients"
    sectionNumber="02"
    sectionLabel="Clienti di fiducia"
    headline="Si fidano di noi."
    headlineAccent="fidano"
    intro="Banche, istituti finanziari, enti pubblici e aziende manifatturiere che hanno scelto WTC Services per la sicurezza dei dati e la continuità operativa dei sistemi centrali. La fiducia si costruisce intervento dopo intervento."
    borderTop={true}
  />

  <!-- CTA -->
  <CTASection
    headline="Vuoi entrare in questo ecosistema?"
    subtext="Contatta il team WTC: analizziamo la tua infrastruttura attuale e ti indichiamo quali vendor e quali competenze servono davvero per il tuo caso specifico."
    actions={[
      {
        label: "Parla con noi",
        href: "/team/vip-accreditation",
        variant: "primary",
      },
      {
        label: "Vedi i case study",
        href: "/services/vault",
        variant: "outline",
      },
    ]}
  />
</ServicesLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    gsap.utils.toArray<Element>(".js-reveal").forEach((el) => {
      gsap.fromTo(
        el,
        { y: 36, opacity: 0, scale: 0.97 },
        {
          scrollTrigger: {
            trigger: el,
            start: "top 88%",
            toggleActions: "play none none none",
            once: true,
          },
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: "power3.out",
        }
      );
    });
  });
</script>
