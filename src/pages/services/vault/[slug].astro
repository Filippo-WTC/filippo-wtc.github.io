---
import { getCollection, getEntry } from 'astro:content';
import ServicesLayout from '../../../layouts/branch/ServicesLayout.astro';
import CTASection from '../../../components/sections/CTASection.astro';
import SectionLabel from '../../../components/ui/SectionLabel.astro';
import Button from '../../../components/ui/Button.astro';
import Badge from '../../../components/ui/Badge.astro';

export async function getStaticPaths() {
  const entries = await getCollection('vault');
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, sector, tag, summary, costAvoided, costLabel, date, duration, tags } = entry.data;

// Format date
const dateFormatted = new Date(date + '-01').toLocaleDateString('it-IT', {
  month: 'long',
  year: 'numeric',
});
---

<ServicesLayout
  title={`${title} — Il Caveau WTC`}
  description={summary}
>
  <!-- BACK -->
  <div class="section-px pt-[124px] pb-6 max-w-[1600px] mx-auto">
    <a
      href="/services/vault"
      class="inline-flex items-center gap-2 font-inter text-sm text-ice-grey/50 hover:text-wtc-orange transition-colors duration-200"
    >
      ← Tutti i Case Study
    </a>
  </div>

  <!-- HEADER -->
  <header class="section-px pb-16 max-w-[1600px] mx-auto">
    <div class="flex flex-wrap items-center gap-3 mb-6">
      <span class="font-inter text-xs text-ice-grey/40 uppercase tracking-widest">{sector}</span>
      <span class="text-white/20">·</span>
      <Badge variant="neutral">{tag}</Badge>
    </div>

    <h1 class="font-clash font-semibold text-display-lg text-white uppercase leading-tight max-w-4xl mb-6">
      {title}
    </h1>

    <p class="font-inter text-lg text-ice-grey/60 leading-relaxed max-w-2xl mb-10">
      {summary}
    </p>

    <!-- Meta grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 p-6 rounded-bento bg-surface-01 border border-white/[0.06]">
      <div class="flex flex-col gap-1">
        <span class="font-inter text-xs text-ice-grey/40 uppercase tracking-widest">Settore</span>
        <span class="font-clash font-semibold text-white">{sector}</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="font-inter text-xs text-ice-grey/40 uppercase tracking-widest">Durata intervento</span>
        <span class="font-clash font-semibold text-white">{duration}</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="font-inter text-xs text-ice-grey/40 uppercase tracking-widest">Data</span>
        <span class="font-clash font-semibold text-white capitalize">{dateFormatted}</span>
      </div>
      <div class="flex flex-col gap-1">
        <span class="font-inter text-xs text-ice-grey/40 uppercase tracking-widest">{costLabel}</span>
        <span class="font-clash font-semibold text-2xl text-wtc-orange">{costAvoided}</span>
      </div>
    </div>
  </header>

  <!-- CONTENT -->
  <article class="section-px pb-24 max-w-[1600px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-12">
      <!-- Main content -->
      <div class="vault-content prose prose-invert prose-orange max-w-none
        prose-headings:font-clash prose-headings:uppercase prose-headings:font-bold
        prose-h2:text-display-sm prose-h2:text-white prose-h2:mt-12 prose-h2:mb-4
        prose-h3:text-lg prose-h3:text-white prose-h3:mt-8 prose-h3:mb-3
        prose-p:font-inter prose-p:text-ice-grey/65 prose-p:leading-relaxed
        prose-strong:text-white prose-strong:font-semibold
        prose-li:font-inter prose-li:text-ice-grey/65
        prose-table:w-full prose-th:font-clash prose-th:text-white prose-th:font-bold prose-th:uppercase
        prose-td:font-inter prose-td:text-ice-grey/65
        prose-a:text-wtc-orange prose-a:no-underline hover:prose-a:text-wtc-neon
      ">
        <Content />
      </div>

      <!-- Sidebar -->
      <aside class="flex flex-col gap-6 lg:sticky lg:top-[140px] lg:self-start">
        <!-- Cost card -->
        <div class="card-proactive-gradient rounded-bento border border-wtc-orange/30 p-6 flex flex-col gap-3">
          <p class="font-inter text-xs text-ice-grey/40 uppercase tracking-widest">Valore economico</p>
          <div class="font-clash font-semibold text-display-sm text-wtc-orange">{costAvoided}</div>
          <p class="font-inter text-sm text-ice-grey/60">{costLabel}</p>
        </div>

        <!-- Tags -->
        <div class="rounded-bento bg-surface-01 border border-white/[0.06] p-6 flex flex-col gap-4">
          <p class="font-inter text-xs text-ice-grey/40 uppercase tracking-widest">Tecnologie coinvolte</p>
          <div class="flex flex-wrap gap-2">
            {tags.map((t) => (
              <span class="px-3 py-1 rounded text-xs font-inter text-ice-grey/60 border border-white/[0.06] bg-white/[0.02]">
                {t}
              </span>
            ))}
          </div>
        </div>

        <!-- Privacy note -->
        <div class="rounded-bento border border-white/[0.04] p-4 flex items-start gap-3 bg-surface-01/50">
          <span class="text-ice-grey/30 flex-shrink-0 mt-0.5 text-xs">🔒</span>
          <p class="font-inter text-xs text-ice-grey/35 leading-relaxed">
            Dettagli identificativi omessi — policy di riservatezza WTC. I dati economici sono reali.
          </p>
        </div>

        <!-- CTA sidebar -->
        <div class="rounded-bento bg-surface-01 border border-white/[0.06] p-6 flex flex-col gap-4">
          <p class="font-clash font-semibold text-white uppercase text-sm">Hai uno scenario simile?</p>
          <p class="font-inter text-sm text-ice-grey/55 leading-relaxed">
            Parla con un tecnico WTC in 15 minuti. Valutiamo il tuo scenario gratuitamente.
          </p>
          <Button href="/services/emergency-it" variant="primary" size="sm">
            Attiva Emergency IT →
          </Button>
          <Button href="/team/vip-accreditation" variant="ghost" size="sm">
            Contatta il team
          </Button>
        </div>
      </aside>
    </div>
  </article>

  <!-- MORE CASE STUDIES -->
  <section class="section-px pb-16 max-w-[1600px] mx-auto border-t border-white/[0.06]">
    <div class="flex items-center justify-between mb-8">
      <SectionLabel label="Altri Case Study" />
      <Button href="/services/vault" variant="ghost">
        Tutti →
      </Button>
    </div>
    <!-- Placeholder: in a full implementation, fetch related entries -->
    <p class="font-inter text-sm text-ice-grey/40">
      <a href="/services/vault" class="text-wtc-orange hover:text-wtc-neon transition-colors">
        Esplora tutti i case study nel Caveau →
      </a>
    </p>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Il tuo problema non può aspettare. Noi nemmeno."
    subtext="Emergency IT attivo 24/7. Parla con un tecnico senior entro 15 minuti."
    actions={[
      { label: 'Attiva Emergency IT',  href: '/services/emergency-it',   variant: 'primary' },
      { label: 'Contatta il Team',     href: '/team/vip-accreditation',  variant: 'outline' },
    ]}
  />
</ServicesLayout>

<script>
  import { gsap } from '@/lib/gsap';

  document.addEventListener('astro:page-load', () => {
    gsap.from('.vault-content', {
      y: 30,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
      delay: 0.2,
    });
  });
</script>
