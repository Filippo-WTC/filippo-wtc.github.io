---
import ServicesLayout from "../../layouts/branch/ServicesLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";

const securityPoints = [
  {
    title: "Firewall avanzati",
    desc: "Protezione perimetrale progettata e gestita per filtrare il traffico e bloccare gli accessi non autorizzati.",
  },
  {
    title: "Protezione degli endpoint",
    desc: "Postazioni, server e dispositivi mobili difesi in modo coerente, dove spesso passano gli attacchi reali.",
  },
  {
    title: "Rilevamento delle minacce",
    desc: "Individuiamo attività anomale e potenziali compromissioni prima che si trasformino in un incidente.",
  },
  {
    title: "Gestione degli accessi",
    desc: "Chi accede a cosa, con quali permessi: controllo puntuale delle identità e delle autorizzazioni.",
  },
  {
    title: "Monitoraggio continuo",
    desc: "Tenere d'occhio sistemi e infrastrutture nel tempo, per intervenire in fretta quando qualcosa cambia.",
  },
  {
    title: "Approccio consulenziale",
    desc: "Gli strumenti contano, ma buona parte della sicurezza dipende dalle persone. Spieghiamo rischi e soluzioni in modo chiaro, anche a chi non è tecnico.",
  },
];

const networkPoints = [
  {
    title: "LAN, WAN e Wi-Fi professionali",
    desc: "Progettiamo infrastrutture di rete che garantiscono prestazioni, sicurezza e continuità di servizio.",
  },
  {
    title: "Prestazioni e continuità",
    desc: "Reti pensate per sostenere il lavoro di ogni giorno, non per complicarlo.",
  },
  {
    title: "Sicurezza integrata",
    desc: "La sicurezza parte dalla rete: la costruiamo con la protezione al centro, non aggiunta in un secondo momento.",
  },
  {
    title: "Soluzioni multi-sede scalabili",
    desc: "Dalle piccole realtà alle organizzazioni con più sedi, architetture che permettono alle persone di collaborare in modo efficace e sicuro.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'WTC Services',
      item: new URL('/services', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Cybersecurity & Networking',
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};
---

<ServicesLayout
  title="Cybersecurity & Networking — WTC Services"
  description="Sicurezza informatica a più livelli e reti LAN, WAN e Wi-Fi enterprise. Firewall, protezione degli endpoint, monitoraggio continuo e infrastrutture progettate per il business."
  structuredData={[breadcrumbLd]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Cybersecurity & Networking"

    title="Proteggere i dati significa proteggere il futuro dell'azienda."
    titleAccent="proteggere il futuro"
    subtitle="Progettiamo e gestiamo una sicurezza a più livelli e reti che sostengono il lavoro di ogni giorno. Infrastrutture pensate per prestazioni, continuità e protezione, dalla piccola realtà alle organizzazioni con più sedi."
    ctas={[
      {
        label: "Richiedi una valutazione",
        href: "/services/contatti",
        variant: "primary",
      },
      {
        label: "I nostri servizi",
        href: "/services",
        variant: "outline",
      },
    ]}
    bgVariant="radial"
    canvas="services"
    topOffset="nav-full"
  />

  <!-- CYBERSECURITY -->
  <section class="section-px section-py max-w-[1600px] mx-auto">
    <div class="flex flex-col gap-4 mb-16">
      <SectionLabel number="02" label="Cybersecurity" />
      <h2
        class="font-clash font-semibold text-display-lg text-white uppercase max-w-2xl js-reveal"
      >
        Sicurezza<br />
        <span class="text-wtc-orange">a più livelli.</span>
      </h2>
      <p class="prose-lead text-ice-grey/60 max-w-xl mt-2 js-reveal">
        Le minacce informatiche diventano più sofisticate ogni anno e possono
        colpire qualsiasi organizzazione, grande o piccola. Copriamo utenti,
        dispositivi, infrastrutture e dati con un approccio coerente e
        consulenziale.
      </p>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 security-grid"
    >
      {
        securityPoints.map((p, i) => (
          <article class="feature-card group rounded-bento bg-surface-01 border border-white/[0.06] p-6 flex flex-col gap-4 hover:border-wtc-orange/20 transition duration-300">
            <span class="font-clash font-bold text-4xl leading-none text-wtc-orange/[0.12] group-hover:text-wtc-orange/[0.28] transition duration-300">
              {String(i + 1).padStart(2, "0")}
            </span>
            <h3 class="font-clash font-semibold text-lg text-white uppercase">
              {p.title}
            </h3>
            <p class="prose-body text-ice-grey/60">
              {p.desc}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- NETWORKING & WI-FI -->
  <section
    class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.06]"
  >
    <div class="flex flex-col gap-4 mb-16">
      <SectionLabel number="03" label="Networking & Wi-Fi Enterprise" />
      <h2
        class="font-clash font-semibold text-display-md text-white uppercase max-w-2xl js-reveal"
      >
        Reti progettate<br />
        <span class="text-wtc-orange">per il business.</span>
      </h2>
      <p class="prose-lead text-ice-grey/60 max-w-xl mt-2 js-reveal">
        Una rete efficiente è la base di tutto il resto. Realizziamo soluzioni
        scalabili che permettono alle persone di collaborare in modo efficace e
        sicuro.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 network-grid">
      {
        networkPoints.map((p) => (
          <div class="feature-card rounded-bento bg-surface-01 border border-white/[0.06] p-6 flex flex-col gap-3 hover:border-wtc-orange/20 transition-colors duration-300">
            <h3 class="font-clash font-semibold text-lg text-white uppercase leading-snug">
              {p.title}
            </h3>
            <p class="prose-body text-ice-grey/60">
              {p.desc}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Vuoi capire quanto è protetta la tua infrastruttura?"
    subtext="Parla con il team WTC: analizziamo la tua rete e la tua sicurezza e ti diciamo, in modo chiaro, dove intervenire e come."
    actions={[
      {
        label: "Richiedi una valutazione",
        href: "/services/contatti",
        variant: "primary",
      },
      {
        label: "Come lavoriamo",
        href: "/services/method",
        variant: "outline",
      },
    ]}
  />
</ServicesLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    gsap.utils.toArray<Element>(".js-reveal").forEach((el) => {
      gsap.fromTo(
        el,
        {
          y: 36,
          opacity: 0,
          scale: 0.97,
        },
        {
          scrollTrigger: {
            trigger: el,
            start: "top 88%",
            toggleActions: "play none none none",
            once: true,
          },
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: "power3.out",
        },
      );
    });

    gsap.fromTo(
      ".feature-card",
      {
        y: 40,
        opacity: 0,
      },
      {
        scrollTrigger: { trigger: ".security-grid", start: "top 88%", once: true },
        y: 0,
        opacity: 1,
        stagger: 0.08,
        duration: 0.75,
        ease: "power3.out",
      },
    );
  });
</script>
