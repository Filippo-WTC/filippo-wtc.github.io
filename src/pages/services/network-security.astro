---
import ServicesLayout from "../../layouts/branch/ServicesLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import StatsRow from "../../components/sections/StatsRow.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";

const capabilities = [
  {
    number: "01",
    title: "Architettura di Rete HA",
    desc: "Progettazione e implementazione di reti ad alta disponibilità con ridondanza su tutti i livelli critici. Failover automatico, load balancing, link aggregation. Uptime 99.99% garantito contrattualmente.",
    tags: ["Cisco", "Fortinet", "HPE Aruba", "SD-WAN", "BGP/OSPF"],
  },
  {
    number: "02",
    title: "Zero Trust & ZTNA",
    desc: "Architettura zero-trust implementata su infrastrutture esistenti. ZTNA in sostituzione della VPN tradizionale: nessun accesso implicito, autenticazione continua, microsegmentazione.",
    tags: ["Fortinet ZTNA", "Zscaler", "ZTNA as a Service", "MFA", "SSO"],
  },
  {
    number: "03",
    title: "Conformità DORA & NIS2",
    desc: "Gap analysis, remediation plan e supporto all'implementazione per istituti finanziari soggetti a DORA (Digital Operational Resilience Act) e aziende soggette a NIS2.",
    tags: ["DORA", "NIS2", "GDPR", "ISO 27001", "Gap Analysis"],
  },
  {
    number: "04",
    title: "Firewall & WAF Enterprise",
    desc: "Deploy e gestione di next-generation firewall con deep packet inspection, IPS/IDS, SSL inspection. Web Application Firewall per protezione applicazioni web critiche.",
    tags: ["Fortinet FortiGate", "Palo Alto", "F5 WAF", "IPS/IDS", "DPI"],
  },
  {
    number: "05",
    title: "Penetration Testing",
    desc: "Test di intrusione su perimetro di rete, applicazioni web e infrastruttura interna. Report dettagliato con severity score CVSS, proof-of-concept e remediation roadmap.",
    tags: [
      "Pentest perimetrale",
      "Web app test",
      "Internal test",
      "CVSS",
      "Red team",
    ],
  },
  {
    number: "06",
    title: "SOC as a Service",
    desc: "Security Operations Center con SIEM centralizzato, correlazione eventi 24/7, threat hunting e incident response. Alert con severity e context — non solo log.",
    tags: ["SIEM", "SOAR", "Threat hunting", "IOC/IOA", "24/7 monitoring"],
  },
];

const sectors = [
  {
    name: "Istituti Bancari",
    compliance: ["DORA", "PSD2", "EBA Guidelines"],
    desc: "Core banking protection, accesso SWIFT sicuro, conformità normativa EBA. Protocolli specifici per ambienti regolamentati con audit trail completo.",
  },
  {
    name: "Manifatturiero",
    compliance: ["NIS2", "IEC 62443", "ISO 27001"],
    desc: "Segmentazione IT/OT, protezione linee di produzione, accesso remoto sicuro ai PLC. Evitare che un attacco all'IT si propaghi all'OT.",
  },
  {
    name: "Corporate Multisite",
    compliance: ["GDPR", "ISO 27001", "NIS2"],
    desc: "SD-WAN gestita, accesso centralizzato per sedi distribuite, policy unificate su tutta l'organizzazione. Visibilità globale, governance locale.",
  },
  {
    name: "Retail & E-commerce",
    compliance: ["PCI-DSS", "GDPR", "NIS2"],
    desc: "Protezione dati carta di credito, segmentazione rete POS, WAF per e-commerce. Conformità PCI-DSS livello 1.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'WTC Services',
      item: new URL('/services', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Ingegneria di Rete & Cybersecurity',
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};
---

<ServicesLayout
  title="Ingegneria di Rete & Cybersecurity — WTC Services"
  description="Architetture di rete ad alta disponibilità per istituti di credito e corporate. Conformità DORA, zero-trust, penetration testing, SOC as a Service."
  structuredData={[breadcrumbLd]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Ingegneria di Rete & Cybersecurity"

    title="Fortezze digitali per chi non può permettersi una breccia."
    titleAccent="Fortezze digitali"
    subtitle="Architetture di rete enterprise per istituti bancari, multinazionali e corporate. Progettiamo infrastrutture end-to-end capaci di resistere agli attacchi reali, dal perimetro alla microsegmentazione."
    ctas={[
      {
        label: "Richiedi una valutazione",
        href: "/team/vip-accreditation",
        variant: "primary",
      },
      {
        label: "Vedi i Case Study",
        href: "/services/vault",
        variant: "outline",
      },
    ]}
    bgVariant="radial"
    canvas="services"
    topOffset="nav-full"
  />

  <!-- STATS -->
  <StatsRow
    stats={[
      {
        value: "127",
        suffix: "",
        label: "CVE risolte sulle infrastrutture clienti (2022–2025)",
      },
      {
        value: "0",
        suffix: "",
        label: "Violazioni perimetrali su infrastrutture WTC-managed",
      },
      {
        value: "34",
        suffix: "",
        label: "Sedi corporate migrate a zero-trust (2023–2025)",
      },
      {
        value: "4",
        suffix: "h",
        label: "RTO medio su infrastrutture HA progettate da WTC",
      },
    ]}
  />

  <!-- CAPABILITIES -->
  <section class="section-px section-py max-w-[1600px] mx-auto">
    <div class="flex flex-col gap-4 mb-16">
      <SectionLabel number="02" label="Capacità Tecniche" />
      <h2
        class="font-clash font-semibold text-display-lg text-white uppercase max-w-2xl js-reveal"
      >
        Sei aree.<br />
        <span class="text-wtc-orange">Un perimetro blindato.</span>
      </h2>
    </div>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 capabilities-grid"
    >
      {
        capabilities.map((cap) => (
          <article
            class:list={[
              "cap-card group rounded-bento bg-surface-01 border border-white/[0.06] p-6 flex flex-col gap-4 hover:border-wtc-orange/20 transition duration-300",
              cap.number === "01" && "lg:col-span-2",
            ]}
          >
            <div class="flex items-start justify-between">
              <span class="font-clash font-bold text-5xl leading-none text-wtc-orange/[0.12] group-hover:text-wtc-orange/[0.28] transition duration-300">
                {cap.number}
              </span>
            </div>
            <h3 class="font-clash font-semibold text-lg text-white uppercase">
              {cap.title}
            </h3>
            <p class="font-inter text-base text-ice-grey/60 leading-relaxed flex-1">
              {cap.desc}
            </p>
            <ul class="flex flex-wrap gap-2 mt-auto">
              {cap.tags.map((tag) => (
                <li class="px-2 py-0.5 rounded text-[10px] font-inter text-ice-grey/40 border border-white/[0.06]">
                  {tag}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <!-- SECTORS -->
  <section
    class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.06]"
  >
    <div class="flex flex-col gap-4 mb-12">
      <SectionLabel number="03" label="Settori Verticali" />
      <h2
        class="font-clash font-semibold text-display-md text-white uppercase max-w-2xl js-reveal"
      >
        Ogni settore<br />
        <span class="text-wtc-orange">ha le sue regole.</span>
      </h2>
      <p class="font-inter text-lg text-ice-grey/60 max-w-xl mt-2 js-reveal">
        La conformità normativa non è una checkbox: è un'architettura.
        Costruiamo sistemi che soddisfano i requisiti regolatori fin dalla
        progettazione — non con patch applicate dopo.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sectors-grid">
      {
        sectors.map((sec) => (
          <div class="sector-card rounded-bento bg-surface-01 border border-white/[0.06] p-6 flex flex-col gap-4 hover:border-wtc-orange/20 transition-colors duration-300">
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-clash font-semibold text-lg text-white uppercase">
                {sec.name}
              </h3>
              <div class="flex flex-wrap gap-1 flex-shrink-0">
                {sec.compliance.map((c) => (
                  <span class="px-2 py-0.5 rounded text-[10px] font-inter font-bold text-wtc-orange border border-wtc-orange/30">
                    {c}
                  </span>
                ))}
              </div>
            </div>
            <p class="font-inter text-base text-ice-grey/60 leading-relaxed">
              {sec.desc}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- DORA SPOTLIGHT -->
  <section
    class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.06]"
  >
    <div
      class="card-proactive-gradient rounded-bento border border-wtc-orange/25 p-8 md:p-12 grid grid-cols-1 lg:grid-cols-2 gap-10"
    >
      <div class="flex flex-col gap-6">
        <div class="flex items-center gap-3">
          <Badge variant="orange">In vigore dal 2025</Badge>
          <span
            class="font-inter text-xs text-ice-grey/40 uppercase tracking-widest"
            >Conformità obbligatoria</span
          >
        </div>
        <h2
          class="font-clash font-semibold text-display-md text-white uppercase js-reveal"
        >
          DORA: sei già<br />
          <span class="text-wtc-orange">in regola?</span>
        </h2>
        <p
          class="font-inter text-base text-ice-grey/60 leading-relaxed js-reveal"
        >
          Il Digital Operational Resilience Act è in vigore da gennaio 2025.
          Istituti finanziari, assicurazioni e i loro fornitori ICT devono
          dimostrare resilienza operativa, test TLPT e incident reporting.
        </p>
        <p
          class="font-inter text-base text-ice-grey/60 leading-relaxed js-reveal"
        >
          WTC esegue gap analysis DORA complete in 5 giorni lavorativi e produce
          il remediation plan con priorità e tempi di implementazione.
        </p>
        <Button href="/team/vip-accreditation" variant="primary">
          Richiedi Gap Analysis DORA →
        </Button>
      </div>

      <div class="flex flex-col gap-4">
        <p
          class="font-inter text-sm text-ice-grey/50 uppercase tracking-widest mb-2"
        >
          Requisiti DORA coperti
        </p>
        {
          [
            {
              art: "Art. 6",
              req: "Governance ICT e framework di gestione del rischio",
            },
            { art: "Art. 10", req: "Sistemi di rilevamento e anomalie" },
            { art: "Art. 11", req: "Politiche di backup e ripristino" },
            {
              art: "Art. 17",
              req: "Classificazione e reporting degli incidenti",
            },
            { art: "Art. 24", req: "Test di resilienza operativa (TLPT)" },
            { art: "Art. 28", req: "Gestione del rischio terze parti ICT" },
          ].map((d) => (
            <div class="flex items-start gap-4 pb-4 border-b border-white/[0.04] last:border-0">
              <span class="font-clash font-semibold text-xs text-wtc-orange flex-shrink-0 pt-0.5">
                {d.art}
              </span>
              <span class="font-inter text-base text-ice-grey/60">{d.req}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="La tua rete regge un attacco LockBit 3.0?"
    subtext="Non è una domanda retorica. Il 78% delle PMI italiane colpite nel 2024 non aveva una risposta. Valutiamo la tua infrastruttura in 48 ore."
    actions={[
      {
        label: "Valutazione gratuita",
        href: "/team/vip-accreditation",
        variant: "primary",
      },
      {
        label: "Vedi i Case Study",
        href: "/services/vault",
        variant: "outline",
      },
    ]}
  />
</ServicesLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    gsap.utils.toArray<Element>(".js-reveal").forEach((el) => {
      gsap.fromTo(
        el,
        {
          y: 36,
          opacity: 0,
          scale: 0.97,
        },
        {
          scrollTrigger: {
            trigger: el,
            start: "top 88%",
            toggleActions: "play none none none",
            once: true,
          },
          y: 0,
          opacity: 1,
          scale: 1,
          duration: 0.8,
          ease: "power3.out",
        },
      );
    });

    gsap.fromTo(
      ".cap-card",
      {
        y: 50,
        opacity: 0,
        scale: 0.97,
      },
      {
        scrollTrigger: { trigger: ".capabilities-grid", start: "top 88%", once: true },
        y: 0,
        opacity: 1,
        scale: 1,
        stagger: 0.08,
        duration: 0.75,
        ease: "power3.out",
      },
    );

    gsap.fromTo(
      ".sector-card",
      {
        y: 40,
        opacity: 0,
      },
      {
        scrollTrigger: { trigger: ".sectors-grid", start: "top 88%", once: true },
        y: 0,
        opacity: 1,
        stagger: 0.12,
        duration: 0.7,
        ease: "power3.out",
      },
    );
  });
</script>
