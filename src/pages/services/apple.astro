---
import BranchLayout from "../../layouts/BranchLayout.astro";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import CTASection from "../../components/sections/CTASection.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";

const services = [
  {
    n: "01",
    title: "Configurazione e Deployment",
    desc: "Configurazione iniziale dei dispositivi Apple, integrazione con i sistemi aziendali e applicazione delle policy di sicurezza, dispositivo dopo dispositivo.",
  },
  {
    n: "02",
    title: "Gestione e Sicurezza",
    desc: "Gestione centralizzata via MDM, protezione dei dati e conformità alle policy aziendali su tutta la flotta.",
  },
  {
    n: "03",
    title: "Supporto Tecnico",
    desc: "Assistenza specializzata su hardware e software Apple, con tempi di intervento definiti e supporto continuativo.",
  },
  {
    n: "04",
    title: "Integrazione Infrastrutturale",
    desc: "Integrazione dei dispositivi Apple con reti aziendali, autenticazione, servizi cloud e ambienti ibridi.",
  },
];

const marquee = [
  "Apple Technical Partner", "Configurazione Enterprise", "Mobile Device Management",
  "Apple Business Manager", "Supporto diretto", "Jamf Pro", "iCloud Business",
  "Apple School Manager", "Sicurezza e Compliance", "Integrazione Infrastrutturale",
];

const digital = ["Apple TV+", "iCloud", "Apple Business Manager", "Apple School Manager", "Apple Arcade", "Apple One"];

const activeServices = [
  { name: "iCloud Business", state: "Attivo" },
  { name: "Apple Business Manager", state: "Attivo" },
  { name: "MDM — Jamf Pro", state: "Attivo" },
];

const benefits = [
  "Approccio orientato alla continuità operativa",
  "Esperienza in ambienti enterprise e regolamentati",
  "Integrazione con le infrastrutture esistenti",
  "Supporto strutturato e scalabile",
];

const breadcrumb = breadcrumbLd(
  [
    { name: "WTC Services", path: "/services/" },
    { name: "Apple Technical Partner", path: Astro.url.pathname },
  ],
  Astro.site,
);
---

<BranchLayout
  branchId="services"
  title="Apple Technical Partner — WTC Services"
  description="WTC Services è Apple Technical Partner: configurazione, gestione, sicurezza e integrazione dell'ecosistema Apple in ambito business, dalla flotta di dispositivi all'infrastruttura enterprise."
  structuredData={[breadcrumb]}
>
  <!-- HERO -->
  <section class="hero-parallax relative overflow-hidden pt-nav-full">
    <div class="absolute inset-0 bg-telemetry opacity-20 pointer-events-none" aria-hidden="true"></div>
    <div class="hero-radial-bg absolute inset-0 pointer-events-none" aria-hidden="true"></div>

    <div class="hero-content relative section-px max-w-container mx-auto w-full py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-14 items-center">
        <!-- left -->
        <div class="flex flex-col gap-7">
          <div class="hero-anim-start inline-flex items-center gap-2.5 self-start rounded-full border border-hairline-strong px-3.5 py-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-wtc-orange animate-pulse-glow"></span>
            <span class="font-inter text-xs tracking-[0.2em] uppercase text-ice-grey/70">Apple Technical Partner</span>
          </div>

          <h1 class="hero-title hero-anim-start font-clash font-semibold text-display-lg md:text-display-xl text-white leading-[1.0] tracking-tight">
            <span class="text-ice-grey/60">Apple</span><br />
            technical<br />
            <span class="text-wtc-orange">partner</span>.
          </h1>

          <p class="hero-subtitle hero-anim-start prose-lead text-ice-grey/70 max-w-xl">
            Supporto e integrazione per l'ecosistema Apple in azienda, dalla configurazione
            dei dispositivi all'infrastruttura enterprise.
          </p>

          <div class="hero-ctas hero-anim-start flex flex-wrap gap-4">
            <Button href="#servizi" variant="primary" size="lg">Scopri i servizi</Button>
            <Button href="/services/contatti/" variant="outline" size="lg">Contattaci</Button>
          </div>
        </div>

        <!-- right: certification card (3D tilt) -->
        <div class="flex justify-center lg:justify-end">
          <div
            class="apple-cert-card group relative w-full max-w-sm rounded-bento border border-hairline bg-surface-01 p-8 flex flex-col gap-6 will-change-transform"
            style="transform-style: preserve-3d;"
          >
            <div class="absolute inset-0 rounded-bento bg-orange-glow opacity-25 pointer-events-none"></div>
            <span class="relative prose-caption tracking-[0.2em] uppercase text-text-muted">Certificazione ufficiale</span>
            <div class="relative rounded-xl bg-veil border border-hairline px-6 py-7 flex items-center justify-center">
              <img
                src="/images/apple-partner-logo.png"
                alt="Apple Technical Partner"
                width="1754"
                height="196"
                class="h-8 w-auto object-contain opacity-90"
                style="filter: brightness(0) invert(1);"
                loading="lazy"
              />
            </div>
            <div class="relative flex items-center gap-2">
              <Badge variant="green" dot>Partner certificato</Badge>
            </div>
            <p class="relative prose-caption text-text-muted">
              Apple e il logo Apple sono marchi registrati di Apple Inc.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- MARQUEE -->
  <div class="relative border-y border-hairline bg-surface-01/40 overflow-hidden py-4" aria-hidden="true">
    <div class="marquee-track flex whitespace-nowrap">
      {[0, 1].map(() => (
        <div class="marquee-content flex items-center shrink-0">
          {marquee.map((m) => (
            <span class="flex items-center gap-2.5 px-6 font-inter text-sm text-ice-grey/60">
              <span class="w-1 h-1 rounded-full bg-wtc-orange/60"></span>{m}
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>

  <!-- SERVIZI -->
  <section id="servizi" class="section-px section-py max-w-container mx-auto">
    <SectionHeader
      number="01"
      label="Servizi"
      heading="Servizi per l'ecosistema Apple."
      headingAccent="l'ecosistema Apple."
      lead="Gestione end-to-end dell'ecosistema Apple in azienda: dall'onboarding dei dispositivi alla sicurezza infrastrutturale."
      class="mb-14"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 apple-cards">
      {
        services.map((s) => (
          <div class="apple-card rounded-bento bg-surface-01 border border-hairline p-8 flex flex-col gap-3 hover:border-wtc-orange/25 transition-colors duration-300">
            <span class="font-clash font-semibold text-sm text-wtc-orange tracking-widest">{s.n}</span>
            <h3 class="font-clash font-semibold text-display-sm text-white">{s.title}</h3>
            <p class="prose-body-sm text-ice-grey/55">{s.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- SERVIZI DIGITALI -->
  <section class="section-px section-py max-w-container mx-auto border-t border-hairline">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
      <div class="flex flex-col gap-6">
        <SectionHeader
          number="02"
          label="Servizi Digitali Apple"
          heading="Servizi Apple per utenti e aziende."
          headingAccent="utenti e aziende."
          lead="Apple TV+, iCloud e gli altri servizi Apple si integrano in contesti aziendali e personali, con continuità tra dispositivi e piattaforme. Ci occupiamo di attivazione, configurazione e gestione, per un utilizzo efficace e sicuro."
         
        />
        <div class="flex flex-wrap gap-2.5">
          {digital.map((d) => (
            <span class="font-inter text-xs text-ice-grey/70 px-3.5 py-1.5 rounded-full border border-hairline bg-veil">{d}</span>
          ))}
        </div>
      </div>

      <div class="rounded-bento bg-surface-01 border border-hairline p-8 flex flex-col gap-5">
        <div class="flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-green-400"></span>
          <span class="font-inter text-xs text-text-muted uppercase tracking-widest">Servizi attivi e gestiti</span>
        </div>
        <div class="flex flex-col divide-y divide-hairline">
          {
            activeServices.map((a) => (
              <div class="flex items-center justify-between py-4">
                <span class="font-inter text-sm text-ice-grey/80">{a.name}</span>
                <span class="prose-caption text-green-400 px-2 py-0.5 rounded bg-green-500/10 border border-green-500/20">{a.state}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- PERCHÉ WTC + L1 -->
  <section class="section-px section-py max-w-container mx-auto border-t border-hairline">
    <SectionHeader
      number="03"
      label="Perché scegliere WTC"
      heading="Il nostro approccio."
      headingAccent="approccio."
      lead="Ogni progetto Apple si integra nell'infrastruttura esistente senza fermare il lavoro, con governance definita e supporto continuativo."
      class="mb-12"
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
      <ul class="flex flex-col gap-3">
        {
          benefits.map((b) => (
            <li class="flex items-start gap-3 rounded-bento bg-surface-01 border border-hairline p-5">
              <span class="mt-1.5 w-1.5 h-1.5 rounded-full bg-wtc-orange shrink-0"></span>
              <span class="font-inter text-base text-ice-grey/70 leading-relaxed">{b}</span>
            </li>
          ))
        }
      </ul>

      <div class="rounded-bento bg-surface-01 border border-hairline p-8 flex flex-col gap-4">
        <span class="prose-caption text-wtc-orange tracking-widest uppercase">Supporto diretto</span>
        <h3 class="font-clash font-semibold text-display-sm text-white">Assistenza diretta e strutturata</h3>
        <p class="font-inter text-sm text-ice-grey/55 leading-relaxed">
          Supporto di primo livello per configurazione, networking e sicurezza su tutti i dispositivi e servizi
          Apple. Interventi tracciati, tempi di intervento definiti, reperibilità garantita.
        </p>
        <div class="flex flex-wrap gap-2 mt-1">
          {["Telefono", "Email", "On-site"].map((c) => (
            <span class="font-inter text-xs text-ice-grey/60 px-3 py-1 rounded border border-hairline">{c}</span>
          ))}
        </div>
        <a href="/services/contatti/" class="link-arrow mt-2 font-inter text-sm text-wtc-orange hover:text-wtc-neon transition-colors">Richiedi supporto <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <p class="prose-caption text-text-muted mt-10">
      Apple, il logo Apple e i nomi dei prodotti e servizi Apple sono marchi di Apple Inc.
    </p>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Parliamo del tuo progetto Apple"
    subtext="Configurazione, gestione o integrazione della tua flotta Apple: raccontaci cosa ti serve e ti diciamo come possiamo aiutarti."
    actions={[
      { label: "Contattaci", href: "/services/contatti/", variant: "primary" },
      { label: "Tutti i servizi", href: "/services/", variant: "outline" },
    ]}
  />
</BranchLayout>

<style>
  @keyframes apple-marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  .marquee-track { animation: apple-marquee 34s linear infinite; }
  @media (prefers-reduced-motion: reduce) { .marquee-track { animation: none; } }
</style>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Hero intro (this page has a custom hero, so it reveals its own elements)
    gsap.fromTo(".hero-anim-start",
      { opacity: 0, y: 30, filter: "blur(6px)" },
      { opacity: 1, y: 0, filter: "blur(0px)", duration: 0.8, stagger: 0.1, ease: "power3.out", immediateRender: false },
    );

    // Reveal on scroll
    gsap.utils.toArray<Element>(".js-reveal").forEach((el) => {
      gsap.fromTo(el, { y: 30, opacity: 0 }, {
        scrollTrigger: { trigger: el, start: "top 90%", once: true },
        y: 0, opacity: 1, duration: 0.7, ease: "power3.out",
      });
    });
    gsap.fromTo(".apple-card", { y: 40, opacity: 0 }, {
      scrollTrigger: { trigger: ".apple-cards", start: "top 88%", once: true },
      y: 0, opacity: 1, stagger: 0.08, duration: 0.7, ease: "power3.out",
    });

    // 3D tilt on the certification card
    if (!reduce) {
      const card = document.querySelector<HTMLElement>(".apple-cert-card");
      if (card) {
        const MAX = 8;
        let raf = 0, rx = 0, ry = 0;
        const apply = () => {
          raf = 0;
          card.style.transform = rx === 0 && ry === 0
            ? ""
            : `perspective(900px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateZ(8px)`;
        };
        card.addEventListener("mousemove", (e) => {
          const r = card.getBoundingClientRect();
          rx = ((e.clientY - (r.top + r.height / 2)) / (r.height / 2)) * -MAX;
          ry = ((e.clientX - (r.left + r.width / 2)) / (r.width / 2)) * MAX;
          if (!raf) raf = requestAnimationFrame(apply);
        });
        card.addEventListener("mouseleave", () => { rx = 0; ry = 0; if (!raf) raf = requestAnimationFrame(apply); });
      }
    }
  });
</script>
