---
import BranchLayout from "../../layouts/BranchLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";

const scenarios = [
  {
    title: "Problema fuori scope del team interno",
    desc: "Il vostro team gestisce l'ordinario. WTC interviene sullo straordinario. Sono attività che il team non ha mai affrontato, su cui non ha precedenti, e su cui ogni tentativo interno costerebbe troppo.",
  },
  {
    title: "Progetto ad alto rischio",
    desc: "Migrazione critica, consolidamento infrastrutturale, cambio di vendor. Scenari dove un errore ha costi sproporzionati. Affianchiamo con esperienza diretta su casistiche analoghe già risolte.",
  },
  {
    title: "Deadline impossibile",
    desc: "Il tempo non basta per il trial-and-error. WTC arriva con la soluzione già strutturata: abbiamo visto lo stesso problema decine di volte, in settori diversi, e sappiamo già il percorso più breve.",
  },
  {
    title: "Vendor intransigente",
    desc: "Il fornitore non risponde, la documentazione è lacunosa, il contratto non prevede il supporto che vi serve. Sappiamo come muoverci, sul piano tecnico e su quello negoziale.",
  },
  {
    title: "Incident complesso",
    desc: "L'emergenza è passata ma i sintomi persistono. Root cause non chiara, sistema instabile, il team è esausto. Entriamo con un approccio metodico per stabilizzare e documentare.",
  },
  {
    title: "Seconda opinione tecnica",
    desc: "Una decisione architettuale importante, una proposta di un vendor da valutare, un'offerta da analizzare. Un punto di vista esterno, senza conflitti di interesse.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'WTC Services',
      item: new URL('/services', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Partner IT su Richiesta',
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};
---

<BranchLayout
  branchId="services"
  title="Partner IT su Richiesta — WTC Services"
  description="Il tuo team conosce i tuoi sistemi. WTC conosce il problema. Interveniamo quando la casistica supera l'esperienza del team interno."
  structuredData={[breadcrumbLd]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Partner IT"

    title="Il tuo team conosce i tuoi sistemi. Noi conosciamo il problema."
    titleAccent="conosciamo"
    subtitle="I tuoi colleghi gestiscono l'ordinario. WTC interviene sullo straordinario: problemi che il team non ha mai affrontato, ma che noi abbiamo già risolto molte volte, in settori e infrastrutture diverse."
    ctas={[
      {
        label: "Parla con un tecnico",
        href: "/services/contatti",
        variant: "primary",
      },
      {
        label: "Come lavoriamo",
        href: "/services/method",
        variant: "outline",
      },
    ]}
    bgVariant="radial"
    canvas="services"
    topOffset="nav-full"
  />

  <!-- CONCEPT SECTION -->
  <section class="section-px section-py max-w-container mx-auto js-reveal">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
      <!-- Left: concept -->
      <div class="flex flex-col gap-6">
        <SectionHeader number="02" label="Come funziona">
          Schemi già visti.<br />
          <span class="text-wtc-orange">Non improvvisazione.</span>
        </SectionHeader>
        <p class="prose-body text-ice-grey/65 js-reveal">
          Ogni azienda affronta un problema per la prima volta. WTC lo ha già
          affrontato molte volte, in settori e infrastrutture diversi. Questo
          significa una cosa sola: sappiamo già dove si trova la soluzione, e
          qual è il percorso più breve per arrivarci.
        </p>
        <p class="prose-body text-ice-grey/65 js-reveal">
          Portiamo un archivio di soluzioni costruito su anni di interventi, con la
          capacità di applicarla subito alla vostra infrastruttura specifica.
        </p>
      </div>

      <!-- Right: how it works steps -->
      <div class="flex flex-col gap-4 js-reveal">
        {
          [
            {
              n: "01",
              title: "Tu hai un problema",
              desc: "Tecnico o gestionale, urgente o pianificato. Ci chiami quando hai bisogno di qualcuno che sia già stato lì.",
            },
            {
              n: "02",
              title: "Entriamo già preparati",
              desc: "Prima di arrivare sui vostri sistemi, abbiamo già una mappa delle probabili cause e delle soluzioni. Nessun tempo perso a ricostruire l'ovvio.",
            },
            {
              n: "03",
              title: "Lavoriamo con il vostro team",
              desc: "Vi affianchiamo senza sostituirvi: il vostro team resta il referente, noi portiamo l'esperienza specifica che manca.",
            },
            {
              n: "04",
              title: "Lasciamo documentazione",
              desc: "Ogni intervento genera conoscenza che rimane all'azienda. La prossima volta, il team interno può gestire da solo.",
            },
          ].map((step) => (
            <div class="flex gap-5 p-5 rounded-bento bg-surface-01 border border-hairline hover:border-hairline-strong transition-colors duration-300">
              <span class="font-clash text-2xl font-semibold text-wtc-orange/40 flex-shrink-0 w-8">
                {step.n}
              </span>
              <div>
                <h3 class="font-clash font-semibold text-base text-white mb-1">
                  {step.title}
                </h3>
                <p class="prose-body text-ice-grey/55">
                  {step.desc}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- QUANDO CI CHIAMI -->
  <section
    class="section-px section-py max-w-container mx-auto border-t border-hairline"
  >
    <SectionHeader
      number="03"
      label="Quando ci chiami"
      lead="Non è necessario avere un'emergenza in corso per chiamarci. Lavoriamo anche su problemi pianificati. Quello che conta è che tu abbia bisogno di esperienza che il tuo team non ha ancora accumulato."
      class="mb-12"
    >
      Sei già stato qui.<br />
      <span class="text-wtc-orange">Noi ci siamo stati prima di te.</span>
    </SectionHeader>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 scenario-grid">
      {
        scenarios.map((s) => (
          <div class="scenario-card rounded-bento bg-surface-01 border border-hairline p-6 flex flex-col gap-3 hover:border-hairline-strong transition-colors duration-300">
            <h3 class="font-clash font-semibold text-base text-white leading-snug">
              {s.title}
            </h3>
            <p class="prose-body text-ice-grey/60">
              {s.desc}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- PRIVACY NOTE -->
  <section class="section-px pb-6 max-w-container mx-auto">
    <div class="rounded-bento border border-hairline p-6 flex items-start gap-4 bg-surface-01/50">
      <span class="text-wtc-orange/60 flex-shrink-0 mt-0.5">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M8 1L10.5 6H14.5L11.5 9.5L12.5 14L8 11.5L3.5 14L4.5 9.5L1.5 6H5.5L8 1Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
        </svg>
      </span>
      <p class="font-inter text-sm text-ice-grey/60 leading-relaxed">
        La riservatezza dei nostri clienti è non negoziabile. I casi su cui operiamo non vengono
        condivisi, nemmeno in forma anonima, senza esplicita autorizzazione scritta.
        Il fatto che non possiamo nominare chi aiutiamo è esattamente la garanzia che cercate.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Hai una situazione che il tuo team non ha mai gestito?"
    subtext="Descrivi il problema. Capiamo insieme se è una casistica che abbiamo già affrontato, e come la risolveremmo."
    actions={[
      {
        label: "Parla con un tecnico",
        href: "/services/contatti",
        variant: "primary",
      },
      {
        label: "Come lavoriamo",
        href: "/services/method",
        variant: "outline",
      },
    ]}
  />
</BranchLayout>

<script>
  import { gsap, revealOnScroll } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    revealOnScroll(".js-reveal");

    gsap.from(".scenario-card", {
      scrollTrigger: { trigger: ".scenario-grid", start: "top 88%", once: true },
      y: 40,
      opacity: 0,
      stagger: 0.08,
      duration: 0.7,
      ease: "power3.out",
    });
  });
</script>
