---
import BranchLayout from "../../layouts/BranchLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
import SectionTexture from "../../components/global/SectionTexture.astro";

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Come risponde WTC in caso di emergenza IT?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Server irraggiungibili, database offline, VPN bloccate o incident di sicurezza in corso vengono presi in carico rapidamente da un team già operativo, non con l'apertura di un ticket.",
      },
    },
    {
      "@type": "Question",
      name: "Quali aree copre WTC Services?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "L'intervento urgente, l'assistenza multi-livello continuativa, l'ingegneria di rete e cybersecurity, e il Metodo WTC per agire in parallelo alla burocrazia interna: tutto sotto la stessa garanzia di risposta e qualità.",
      },
    },
    {
      "@type": "Question",
      name: "Con quali tipi di aziende lavora WTC?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "WTC affianca aziende e istituti di credito nella gestione dell'infrastruttura IT, dall'intervento urgente all'assistenza continuativa.",
      },
    },
    {
      "@type": "Question",
      name: "Come si comincia a lavorare con WTC?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Basta parlare con un tecnico: valutiamo il tuo scenario IT e ti diciamo esattamente come possiamo aiutarti, sia per un'urgenza che per una ristrutturazione pianificata.",
      },
    },
  ],
};
---

<BranchLayout
  branchId="services"
  title="WTC Services — Supporto IT Enterprise"
  description="Infrastrutture IT per corporate e istituti di credito. Intervento rapido, assistenza continuativa, ingegneria di rete e cybersecurity."
  structuredData={[faqLd]}
>
  <!-- HERO -->
  <HeroSection

    title="Quando serve qualcuno su cui contare, siamo già operativi."
    titleAccent="già operativi"
    subtitle="WTC affianca corporate e istituti di credito nella gestione dell'infrastruttura IT. Interveniamo con precisione e discrezione, prima che un problema diventi una crisi."
    ctas={[
      {
        label: "Scopri come lavoriamo",
        href: "/services/come-lavoriamo/",
        variant: "primary",
      },
      {
        label: "Chi si fida di noi",
        href: "/services/partner-e-clienti/",
        variant: "outline",
      },
    ]}
    bgVariant="radial"
    canvas="services"
    topOffset="nav-full"
  />

  <!-- SERVICES GRID -->
  <section class="section-px section-py max-w-container mx-auto">
    <SectionHeader
      number="01"
      label="I Nostri Servizi"
      size="lg"
      lead="Che si tratti di un intervento urgente o di una ristrutturazione pianificata, abbiamo il metodo e il team."
      class="mb-16"
    >
      Pronto intervento, assistenza continua, rete e security.<br />
      <span class="text-wtc-orange">Sempre sotto la stessa garanzia.</span>
    </SectionHeader>

    {/* id univoco: .service-cards/.service-card esistono identiche anche in home,
        serve un aggancio che identifichi SOLO questa pagina per la guardia GSAP. */}
    {/* Sotto md le card si sciolgono in righe editoriali (riga hairline,
        niente scatola): gap-0 così le righe formano una lista continua,
        la spaziatura la fa il padding verticale delle righe. */}
    <div
      id="services-grid"
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-0 md:gap-5 service-cards"
    >
      <!-- Emergency IT — wide -->
      <article
        class="service-card lg:col-span-2 group relative overflow-hidden border-t border-hairline py-10 md:rounded-bento md:bg-surface-01 md:border md:p-12 flex flex-col gap-7 hover:border-hairline-strong active:border-hairline-strong transition-colors duration-500"
      >
        <div class="flex items-start justify-between">
          <Badge variant="red">Intervento urgente</Badge>
          <span class="md:hidden font-inter text-xs tracking-[0.2em] tabular-nums text-ice-grey/40" aria-hidden="true">01</span>
        </div>
        <div>
          <h3
            class="font-clash font-semibold text-display-sm text-white mb-4"
          >
            Pronto Intervento
          </h3>
          <p class="prose-body text-ice-grey/55">
            Server irraggiungibili, database offline, VPN bloccate, incident di
            sicurezza in corso. WTC risponde subito con un team già operativo,
            non con un ticket da aprire.
          </p>
          <p class="prose-body text-ice-grey/55 mt-3">
            Protocolli pre-autorizzati eliminano i colli di bottiglia
            burocratici: agiamo subito, mentre il tuo team interno gestisce la
            comunicazione verso la direzione.
          </p>
        </div>
        <ul class="flex flex-wrap gap-2">
          {
            [
              "Recupero dati",
              "Ripristino server",
              "Report post-intervento",
            ].map((tag) => (
              <li class="px-3 py-1 rounded-lg prose-caption text-ice-grey/60 border border-hairline">
                {tag}
              </li>
            ))
          }
        </ul>
        <div class="mt-auto">
          <Button href="/services/assistenza-urgente/" variant="outline" class="link-arrow">
            Scopri il servizio <span aria-hidden="true">→</span>
          </Button>
        </div>
      </article>

      <!-- Managed Support -->
      <article
        class="service-card group relative overflow-hidden border-t border-hairline py-10 md:rounded-bento md:bg-surface-01 md:border md:p-10 flex flex-col gap-7 hover:border-hairline-strong active:border-hairline-strong transition-colors duration-500"
      >
        <div class="flex items-start justify-between">
          {/* neutral, non green: "Continuativo" è una CATEGORIA di servizio,
              non uno stato. Il verde nel resto del sito significa "attivo/ok" e
              qui leggeva come stato di salute. Il rosso resta solo sull'urgenza,
              così il colore torna a significare qualcosa. */}
          <Badge variant="neutral">Continuativo</Badge>
          <span class="md:hidden font-inter text-xs tracking-[0.2em] tabular-nums text-ice-grey/40" aria-hidden="true">02</span>
        </div>
        <div>
          <h3
            class="font-clash font-semibold text-display-sm text-white mb-4"
          >
            Assistenza Multi-Livello
          </h3>
          <p class="prose-body text-ice-grey/55">
            Monitoraggio continuo, aggiornamenti programmati e risoluzione
            proattiva. Interveniamo sui problemi prima che diventino incidenti.
          </p>
        </div>
        <div class="mt-auto">
          <a
            href="/services/supporto-continuativo/"
            class="link-arrow font-inter text-sm text-ice-grey/60 hover:text-white transition-colors duration-200"
          >
            Scopri il supporto continuo <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <!-- Network & Security -->
      <article
        class="service-card group relative overflow-hidden border-t border-hairline py-10 md:rounded-bento md:bg-surface-01 md:border md:p-10 flex flex-col gap-7 hover:border-hairline-strong active:border-hairline-strong transition-colors duration-500"
      >
        <div class="flex items-start justify-between">
          <Badge variant="neutral">Enterprise</Badge>
          <span class="md:hidden font-inter text-xs tracking-[0.2em] tabular-nums text-ice-grey/40" aria-hidden="true">03</span>
        </div>
        <div>
          <h3
            class="font-clash font-semibold text-display-sm text-white mb-4"
          >
            Ingegneria di Rete &amp; Security
          </h3>
          <p class="prose-body text-ice-grey/55">
            Firewall, protezione degli endpoint, monitoraggio continuo e reti
            LAN, WAN e Wi-Fi progettate su misura. Infrastrutture che sostengono
            il lavoro di ogni giorno.
          </p>
        </div>
        <div class="mt-auto">
          <a
            href="/services/sicurezza-informatica/"
            class="link-arrow font-inter text-sm text-ice-grey/60 hover:text-white transition-colors duration-200"
          >
            Ingegneria di rete <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <!-- Il Metodo — wide card -->
      <article
        class="service-card card-accent-gradient lg:col-span-2 group relative overflow-hidden rounded-bento border border-hairline p-10 md:p-12 mt-6 md:mt-0 flex flex-col md:flex-row items-start md:items-center gap-10"
      >
        <div class="flex-1">
          <SectionLabel label="Il Metodo WTC" class="mb-5" />
          <h3
            class="font-clash font-semibold text-display-sm text-white mb-4"
          >
            Agiamo in parallelo alla burocrazia
          </h3>
          <p
            class="font-inter text-sm text-ice-grey/55 leading-relaxed max-w-lg"
          >
            I nostri protocolli pre-autorizzati ci permettono di intervenire al
            passo uno, mentre il processo interno prosegue regolarmente. Nessun
            bypass: lavoriamo in parallelo, documentando e concordando ogni
            passaggio.
          </p>
        </div>
        <div class="flex-shrink-0">
          <Button href="/services/come-lavoriamo/" variant="outline" class="link-arrow">
            Il Metodo <span aria-hidden="true">→</span>
          </Button>
        </div>
      </article>
    </div>
  </section>

  <!-- FAQ -->
  <section
    class="section-px section-py max-w-container mx-auto border-t border-hairline"
  >
    <SectionTexture />
    <SectionHeader
      number="02"
      label="Domande Frequenti"
      heading="Le domande che ci fanno più spesso."
      headingAccent="più spesso."
      class="mb-14"
    />

    {/* Come sopra: sotto md le FAQ sono righe editoriali, non scatole. */}
    <div class="grid grid-cols-1 md:grid-cols-2 gap-0 md:gap-5">
      {
        [
          {
            q: "Come risponde WTC in caso di emergenza IT?",
            a: "Server irraggiungibili, database offline, VPN bloccate o incident di sicurezza in corso vengono presi in carico rapidamente da un team già operativo, non con l'apertura di un ticket.",
          },
          {
            q: "Quali aree copre WTC Services?",
            a: "L'intervento urgente, l'assistenza multi-livello continuativa, l'ingegneria di rete e cybersecurity, e il Metodo WTC per agire in parallelo alla burocrazia interna: tutto sotto la stessa garanzia di risposta e qualità.",
          },
          {
            q: "Con quali tipi di aziende lavora WTC?",
            a: "WTC affianca aziende e istituti di credito nella gestione dell'infrastruttura IT, dall'intervento urgente all'assistenza continuativa.",
          },
          {
            q: "Come si comincia a lavorare con WTC?",
            a: "Basta parlare con un tecnico: valutiamo il tuo scenario IT e ti diciamo esattamente come possiamo aiutarti, sia per un'urgenza che per una ristrutturazione pianificata.",
          },
        ].map((faq) => (
          <div class="border-t border-hairline py-7 md:rounded-bento md:bg-surface-01 md:border md:p-7 flex flex-col gap-3">
            <h3 class="font-clash font-semibold text-lg text-white mb-2">
              {faq.q}
            </h3>
            <p class="prose-body text-ice-grey/55">
              {faq.a}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Hai una situazione IT da gestire?"
    subtext="Parla con un tecnico WTC. Valutiamo il tuo scenario e ti diciamo come possiamo aiutarti."
    actions={[
      {
        label: "Parla con il team",
        href: "/services/contatti/",
        variant: "primary",
      },
      {
        label: "Scopri il metodo",
        href: "/services/come-lavoriamo/",
        variant: "outline",
      },
    ]}
  />
</BranchLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Il listener sopravvive alle view transition e riparte a ogni navigazione:
    // senza questa guardia animerebbe le .service-card della home, che usa le
    // stesse classi con parametri diversi.
    if (!document.querySelector("#services-grid")) return;
    // Movimento ridotto: niente entrate GSAP. Le .service-card non partono
    // nascoste dalla CSS, quindi uscire qui le lascia semplicemente visibili.
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    gsap.fromTo(
      ".service-card",
      {
        y: 50,
        opacity: 0,
      },
      {
        scrollTrigger: { trigger: ".service-cards", start: "top 88%", once: true },
        y: 0,
        opacity: 1,
        stagger: 0.1,
        duration: 0.9,
        ease: "power3.out",
      },
    );
  });
</script>
