---
import RootLayout from '../layouts/RootLayout.astro';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'WTC Services S.r.l.s.',
  email: 'wtc@worldtradecontacts.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Leone XIII, 464',
    postalCode: '00165',
    addressLocality: 'Roma',
    addressCountry: 'IT',
  },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<RootLayout
  title="Parla con noi — WTC"
  description="Contatta WTC Group per WTC Services, WTC Team, Global Portal, Pitter Italy o WTC Food. Compila il form e ti risponderemo entro un giorno lavorativo."
  structuredData={[localBusinessLd]}
>
  <Navbar />

  <main id="main-content" class="pt-[72px]">

    <!-- Hero -->
    <section class="section-py section-px max-w-[1600px] mx-auto">
      <div class="max-w-2xl">
        <p class="font-inter text-xs text-wtc-orange tracking-widest uppercase mb-4">Contatti</p>
        <h1 class="font-clash font-semibold text-display-lg md:text-display-xl text-white mb-6 text-balance">
          Parla con noi
        </h1>
        <p class="font-inter text-lg text-text-muted leading-relaxed max-w-lg">
          Scrivi due righe su di te e su cosa ti serve. Niente filtri, niente bot. Risponde una persona reale entro un giorno lavorativo.
        </p>
      </div>
    </section>

    <!-- Divider -->
    <div class="section-px max-w-[1600px] mx-auto">
      <div class="h-px bg-white/[0.06]"></div>
    </div>

    <!-- Form + Sidebar -->
    <section class="section-py section-px max-w-[1600px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16 items-start">

        <!-- Email CTA (2/3) -->
        <div class="lg:col-span-2">
          <div class="flex flex-col gap-6 rounded-bento border border-white/[0.06] bg-surface-01 p-8 sm:p-10">
            <p class="font-inter text-[10px] text-wtc-orange tracking-widest uppercase">Scrivici</p>
            <h2 class="font-clash font-semibold text-display-sm text-white text-balance">
              Due righe via email.<br />Ti rispondiamo entro un giorno lavorativo.
            </h2>
            <p class="font-inter text-base text-text-muted leading-relaxed max-w-lg">
              Raccontaci chi sei, quale divisione WTC ti interessa e cosa ti serve. Risponde una persona reale — niente bot, niente filtri.
            </p>
            <a
              href="mailto:wtc@worldtradecontacts.com?subject=Richiesta%20di%20contatto%20WTC"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 font-inter text-xs font-medium tracking-wide uppercase bg-wtc-orange text-white rounded-lg hover:bg-wtc-neon transition-colors duration-200"
            >
              Scrivici una email →
            </a>
          </div>
        </div>

        <!-- Sidebar (1/3) -->
        <div class="lg:col-span-1 flex flex-col gap-6">

          <!-- Contatti diretti -->
          <div class="rounded-xl border border-white/[0.06] bg-surface-01/50 p-6 flex flex-col gap-5">
            <p class="font-inter text-[10px] text-wtc-orange tracking-widest uppercase">Contatti diretti</p>

            <div class="flex flex-col gap-1">
              <p class="font-inter text-xs text-text-muted">Email</p>
              <a
                href="mailto:wtc@worldtradecontacts.com"
                class="font-inter text-sm text-ice-grey hover:text-white transition-colors break-all"
              >
                wtc@worldtradecontacts.com
              </a>
            </div>

            <div class="flex flex-col gap-1">
              <p class="font-inter text-xs text-text-muted">Sede legale</p>
              <p class="font-inter text-sm text-ice-grey leading-relaxed">
                Via Leone XIII, 464<br />
                00165 Roma (RM)
              </p>
            </div>

            <div class="pt-4 border-t border-white/[0.06]">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400 flex-shrink-0"></span>
                <p class="font-inter text-xs text-text-muted">Rispondiamo entro 1 giorno lavorativo</p>
              </div>
            </div>
          </div>

          <!-- Box separazione WTC Team -->
          <div class="rounded-xl border border-white/[0.06] bg-surface-01/30 p-6 flex flex-col gap-3">
            <p class="font-inter text-[10px] text-ice-grey/40 tracking-widest uppercase">Eventi WTC Team</p>
            <p class="font-inter text-sm text-text-muted leading-relaxed">
              Vuoi partecipare a un evento WTC Team? Trovi tutti gli appuntamenti nel calendario dedicato.
            </p>
            <a
              href="/team#partecipa"
              class="inline-flex items-center gap-1.5 font-inter text-xs text-ice-grey/70 hover:text-ice-grey transition-colors duration-200 group"
            >
              Vai al calendario eventi
              <span class="group-hover:translate-x-0.5 transition-transform duration-200">→</span>
            </a>
          </div>

        </div>

      </div>
    </section>

  </main>

  <Footer />
</RootLayout>
