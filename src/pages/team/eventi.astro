---
import { Picture } from "astro:assets";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import BranchLayout from "../../layouts/BranchLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import teamCalcio from "../../assets/team/team-calcio.webp";
import teamMotorsport from "../../assets/team/team-motorsport.webp";
import teamCarrera from "../../assets/team/team-carrera.webp";
import teamTennis from "../../assets/team/team-tennis.webp";

const sports = [
  {
    img: teamCalcio,
    alt: "Tifosi della AS Roma allo Stadio Olimpico durante una coreografia in Serie A",
    tag: "Serie A",
    title: "Calcio",
    desc: "Con Roma, Lazio, Genoa, Sampdoria e Parma. Dentro allo stadio, non davanti alla TV.",
  },
  {
    img: teamMotorsport,
    alt: "Insegna MotoGP nel paddock del Gran Premio d'Italia al Mugello",
    tag: "Campionati Mondiali",
    title: "Formula 1 & MotoGP",
    desc: "Seguiamo ogni weekend di gara, dal box al traguardo.",
  },
  {
    img: teamCarrera,
    alt: "La Porsche 911 GT3 Cup di WTC Services in pista nella Porsche Carrera Cup",
    tag: "Sponsor Ufficiale",
    title: "Porsche Carrera Cup",
    desc: "Sponsor del team Enrico Fulgenzi Racing. Lo sport che profuma di benzina.",
  },
  {
    img: teamTennis,
    alt: "Tennista sul campo in terra rossa agli Internazionali d'Italia di Roma",
    tag: "Sport di Racchetta",
    title: "Tennis & Padel",
    desc: "Lo pratichiamo e lo sosteniamo. Un campo, una rete e avversari in carne e ossa.",
  },
];

const breadcrumb = breadcrumbLd(
  [
    { name: "WTC Team", path: "/team" },
    { name: "Eventi e inviti", path: Astro.url.pathname },
  ],
  Astro.site,
);
---

<BranchLayout
  branchId="team"
  title="Eventi e Inviti — WTC Team"
  description="Sei un cliente o un partner WTC? Vieni con noi agli eventi sportivi: dalla Serie A al paddock, dalla pista ai campi da tennis. Sfoglia il calendario e proponi la tua presenza."
  structuredData={[breadcrumb]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Eventi e inviti"
    title="Vieni con noi al prossimo evento."
    titleAccent="al prossimo evento"
    subtitle="Se sei un cliente o un partner WTC, lo sport è il modo migliore per vederci fuori da una sala riunioni. Ti invitiamo agli eventi che sponsorizziamo: scegli quello giusto e proponi la tua presenza."
    ctas={[
      { label: "Vai al calendario", href: "#partecipa", variant: "primary" },
      { label: "Parla con noi", href: "/team/contatti", variant: "outline" },
    ]}
    bgVariant="radial"
    canvas="team"
    topOffset="nav-full"
  />

  <!-- SPORT -->
  <section class="section-px section-py max-w-container mx-auto">
    <SectionHeader
      number="01"
      label="Dove ci trovi"
      heading="Gli sport che sponsorizziamo."
      headingAccent="sponsorizziamo."
      lead="Sono quelli che seguiamo davvero, ogni settimana: la cornice giusta per costruire e coltivare relazioni."
      class="mb-14"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sports-grid">
      {
        sports.map((s) => (
          <div class="sport-card rounded-bento bg-surface-01 border border-hairline overflow-hidden hover:border-hairline-strong transition-colors duration-300">
            <Picture
              src={s.img}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[480, 800, 1200]}
              sizes="(min-width: 1792px) 692px, (min-width: 768px) 50vw, 100vw"
              quality={60}
              alt={s.alt}
              loading="lazy"
              decoding="async"
              class="w-full aspect-video object-cover"
            />
            <div class="p-8 flex flex-col gap-3">
              <span class="prose-caption text-wtc-orange tracking-widest uppercase">{s.tag}</span>
              <h3 class="font-clash font-semibold text-display-sm text-white">{s.title}</h3>
              <p class="prose-body-sm text-ice-grey/55">{s.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CALENDARIO (app interattiva: candidatura direttamente qui) -->
  <section id="partecipa" class="section-px section-py max-w-container mx-auto border-t border-hairline scroll-mt-28">
    <SectionHeader
      number="02"
      label="Prossimi eventi"
      heading="Proponi la tua presenza."
      headingAccent="presenza."
      lead="Sfoglia gli eventi in programma e candidati direttamente qui: scegli l'evento che ti interessa e proponi la tua presenza in un clic."
      class="mb-10"
    />

    <iframe
      src="https://wtc-events-app.vercel.app/calendar"
      title="Calendario eventi WTC Team"
      loading="lazy"
      class="block w-full h-[900px] min-h-[600px] rounded-bento border border-hairline bg-surface-01"
    ></iframe>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Ci vediamo al prossimo evento"
    subtext="Raccontaci chi sei e cosa cerchi. Le migliori relazioni iniziano fuori da una sala riunioni."
    actions={[
      { label: "Parla con noi", href: "/team/contatti", variant: "primary" },
      { label: "Software & consulting", href: "/team/software-consulting", variant: "outline" },
    ]}
  />
</BranchLayout>

<script>
  import { gsap } from "@/lib/gsap";
  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.fromTo(
      ".sport-card",
      { y: 40, opacity: 0 },
      {
        scrollTrigger: { trigger: ".sports-grid", start: "top 88%", once: true },
        y: 0, opacity: 1, stagger: 0.12, duration: 0.8, ease: "power3.out",
      },
    );
  });
</script>
