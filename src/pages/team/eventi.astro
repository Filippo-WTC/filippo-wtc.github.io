---
import { Picture } from "astro:assets";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import BranchLayout from "../../layouts/BranchLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import teamCalcio from "../../assets/team/team-calcio.webp";
import teamMotorsport from "../../assets/team/team-motorsport.webp";
import teamCarrera from "../../assets/team/team-carrera.webp";
import teamTennis from "../../assets/team/team-tennis.webp";

const sports = [
  {
    img: teamCalcio,
    alt: "Tifosi della AS Roma allo Stadio Olimpico durante una coreografia in Serie A",
    tag: "Serie A",
    title: "Calcio",
    desc: "Con Roma, Lazio, Genoa, Sampdoria e Parma. Dentro allo stadio, non davanti alla TV.",
  },
  {
    img: teamMotorsport,
    alt: "Insegna MotoGP nel paddock del Gran Premio d'Italia al Mugello",
    tag: "Campionati Mondiali",
    title: "Formula 1 & MotoGP",
    desc: "Seguiamo ogni weekend di gara, dal box al traguardo.",
  },
  {
    img: teamCarrera,
    alt: "La Porsche 911 GT3 Cup di WTC Services in pista nella Porsche Carrera Cup",
    tag: "Sponsor Ufficiale",
    title: "Porsche Carrera Cup",
    desc: "Sponsor del team Enrico Fulgenzi Racing. Lo sport che profuma di benzina.",
  },
  {
    img: teamTennis,
    alt: "Tennista sul campo in terra rossa agli Internazionali d'Italia di Roma",
    tag: "Sport di Racchetta",
    title: "Tennis & Padel",
    desc: "Lo pratichiamo e lo sosteniamo. Un campo, una rete e avversari in carne e ossa.",
  },
];

const breadcrumb = breadcrumbLd(
  [
    { name: "WTC Team", path: "/team/" },
    { name: "Eventi e inviti", path: Astro.url.pathname },
  ],
  Astro.site,
);
---

<BranchLayout
  branchId="team"
  title="Eventi e Inviti — WTC Team"
  description="Sei cliente o partner WTC? Vieni con noi agli eventi sportivi, dalla Serie A al paddock. Sfoglia il calendario e proponi la tua presenza."
  structuredData={[breadcrumb]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Eventi e inviti"
    title="Vieni con noi al prossimo evento."
    titleAccent="prossimo evento"
    subtitle="Se sei un cliente o un partner WTC, lo sport è il modo migliore per vederci fuori da una sala riunioni. Ti invitiamo agli eventi che sponsorizziamo: scegli quello giusto e proponi la tua presenza."
    ctas={[
      { label: "Vai al calendario", href: "#partecipa", variant: "primary" },
      { label: "Parla con noi", href: "/team/contatti/", variant: "outline" },
    ]}
    bgVariant="radial"
    canvas="team"
    topOffset="nav-full"
  />

  <!-- SPORT -->
  <section class="section-px section-py max-w-container mx-auto">
    <SectionHeader
      number="01"
      label="Dove ci trovi"
      heading="Gli sport che sponsorizziamo."
      headingAccent="sponsorizziamo."
      lead="Sono quelli che seguiamo davvero, ogni settimana: la cornice giusta per costruire e coltivare relazioni."
      class="mb-14"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sports-grid">
      {
        sports.map((s) => (
          <div class="sport-card rounded-bento bg-surface-01 border border-hairline overflow-hidden hover:border-hairline-strong transition-colors duration-300">
            <Picture
              src={s.img}
              formats={["avif", "webp"]}
              fallbackFormat="webp"
              widths={[480, 800, 1200]}
              sizes="(min-width: 1792px) 692px, (min-width: 768px) 50vw, 100vw"
              quality={60}
              alt={s.alt}
              loading="lazy"
              decoding="async"
              class="img-fade w-full aspect-video object-cover"
            />
            <div class="p-8 flex flex-col gap-3">
              <span class="prose-caption text-wtc-orange tracking-widest uppercase">{s.tag}</span>
              <h3 class="font-clash font-semibold text-display-sm text-white">{s.title}</h3>
              <p class="prose-body-sm text-ice-grey/55">{s.desc}</p>
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CALENDARIO (app interattiva: candidatura direttamente qui) -->
  <section id="partecipa" class="section-px section-py max-w-container mx-auto border-t border-hairline">
    <SectionHeader
      number="02"
      label="Prossimi eventi"
      heading="Proponi la tua presenza."
      headingAccent="presenza."
      lead="Sfoglia gli eventi in programma e candidati direttamente qui: scegli l'evento che ti interessa e proponi la tua presenza in un clic."
      class="mb-10"
    />

    {/*
      Il calendario è servito da contacts.wtcteam.com (servizio del gruppo WTC).
      È incorporato inline e si carica in modo lazy quando la sezione entra nel
      viewport: fino a quel momento non viene contattato nessun servizio. Ha lo
      sfondo scuro come il sito e si auto-dimensiona (postMessage), così sembra
      parte della pagina invece di un riquadro incollato. La cookie policy
      dichiara questo caricamento. Entra in dissolvenza morbida quando è pronto.
    */}
    <div
      id="calendar-embed"
      class="relative w-full min-h-[600px] rounded-bento border border-hairline bg-surface-01 overflow-hidden"
    >
      <div
        id="calendar-loading"
        class="absolute inset-0 flex items-center justify-center pointer-events-none"
        aria-hidden="true"
      >
        <span class="prose-caption text-text-muted uppercase tracking-widest animate-pulse">
          Carico il calendario…
        </span>
      </div>
      <iframe
        id="calendar-frame"
        src="https://contacts.wtcteam.com/calendar"
        title="Calendario eventi WTC Team"
        referrerpolicy="no-referrer"
        sandbox="allow-scripts allow-forms allow-same-origin allow-popups"
        loading="lazy"
        class="relative block w-full border-0 opacity-0 transition-opacity duration-700 ease-out"
        style="height: 1000px;"
      ></iframe>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Ci vediamo al prossimo evento"
    subtext="Raccontaci chi sei e cosa cerchi. Le migliori relazioni iniziano fuori da una sala riunioni."
    actions={[
      { label: "Parla con noi", href: "/team/contatti/", variant: "primary" },
      { label: "Software & consulting", href: "/team/software-e-consulenza/", variant: "outline" },
    ]}
  />
</BranchLayout>

<script>
  // Calendario incorporato inline (l'iframe è già nel markup con loading="lazy":
  // si carica quando la sezione entra nel viewport). Qui gestiamo solo la
  // dissolvenza all'arrivo e l'auto-dimensionamento via postMessage. Blocco a sé
  // dallo script delle animazioni: quello esce subito con reduced-motion, il
  // calendario deve funzionare comunque.
  const CAL_ORIGIN = "https://contacts.wtcteam.com";

  document.addEventListener("astro:page-load", () => {
    const frame = document.getElementById("calendar-frame") as HTMLIFrameElement | null;
    const loading = document.getElementById("calendar-loading");
    if (!frame) return;

    // Dissolvenza morbida quando il calendario è pronto; via il placeholder.
    const reveal = () => {
      frame.classList.remove("opacity-0");
      if (loading) loading.style.display = "none";
    };
    frame.addEventListener("load", reveal, { once: true });
    // Rete di sicurezza: se il load non scatta (rete lenta/bloccata), mostralo
    // comunque dopo qualche secondo invece di lasciare il placeholder appeso.
    const revealFallback = window.setTimeout(reveal, 6000);

    // Altezza reale dal calendario → l'iframe si adatta, niente doppio scroll.
    // Verifica l'origine: si accetta solo dal dominio del calendario.
    const onHeight = (e: MessageEvent) => {
      if (e.origin !== CAL_ORIGIN) return;
      const d = e.data;
      if (d && d.type === "wtc-calendar-height" && typeof d.height === "number" && d.height > 0) {
        frame.style.height = Math.ceil(d.height) + "px";
      }
    };
    window.addEventListener("message", onHeight);

    // `window` sopravvive alle view transition: pulizia navigando via.
    document.addEventListener("astro:before-swap", () => {
      window.removeEventListener("message", onHeight);
      window.clearTimeout(revealFallback);
    }, { once: true });
  });
</script>

<script>
  import { gsap } from "@/lib/gsap";
  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.fromTo(
      ".sport-card",
      { y: 40, opacity: 0 },
      {
        scrollTrigger: { trigger: ".sports-grid", start: "top 88%", once: true },
        y: 0, opacity: 1, stagger: 0.12, duration: 0.8, ease: "power3.out",
      },
    );
  });
</script>
