---
import { Picture } from "astro:assets";
import BranchLayout from "../../layouts/BranchLayout.astro";
import teamCalcio from "../../assets/team/team-calcio.webp";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import Badge from "../../components/ui/Badge.astro";
import SectionTexture from "../../components/global/SectionTexture.astro";

const faqs = [
  {
    q: "Che cosa offre WTC Team?",
    a: "Due percorsi. Se sei un cliente o un partner WTC, ti invitiamo agli eventi sportivi che sponsorizziamo. Se sei un'azienda, ti mettiamo a disposizione il metodo: consulenza sulle sponsorizzazioni e un software per gestire ospitalità e inviti.",
  },
  {
    q: "A quali sport è legato WTC Team?",
    a: "Calcio con Roma, Lazio, Genoa, Sampdoria e Parma; Formula 1 e MotoGP; Porsche Carrera Cup con il team Enrico Fulgenzi Racing; tennis e padel.",
  },
  {
    q: "Come faccio a partecipare a un evento?",
    a: "Vai alla pagina Eventi e inviti, sfoglia il calendario e proponi la tua presenza. Se non sei ancora nel nostro sistema, scrivici e ti diamo l'accesso.",
  },
  {
    q: "Quanto tempo impiega WTC Team a rispondere a una richiesta?",
    a: "Rispondiamo entro un giorno lavorativo. Per partnership, sponsorizzazioni, ospitalità o collaborazioni basta scrivere ai contatti WTC Team.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BranchLayout
  branchId="team"
  title="WTC Team — Sport, Sponsorship & Hospitality"
  description="Due percorsi: vieni con noi agli eventi sportivi che sponsorizziamo, oppure porta nella tua azienda il metodo, la consulenza e il software con cui trasformiamo le relazioni in business."
  structuredData={[faqLd]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="WTC Team"
    title="Lo sport apre le relazioni. Il metodo le trasforma in business."
    titleAccent="business"
    subtitle="Da anni usiamo sponsorizzazioni, ospitalità ed eventi per far crescere le nostre aziende. Da qui partono due strade: vieni con noi agli eventi, oppure porta il nostro metodo dentro la tua azienda."
    ctas={[
      { label: "Vieni a un evento", href: "/team/eventi", variant: "primary" },
      { label: "Software & consulting", href: "/team/software-consulting", variant: "outline" },
    ]}
    bgVariant="radial"
    canvas="team"
    topOffset="nav-full"
  />

  <!-- BIVIO A / B -->
  <section class="section-px section-py max-w-container mx-auto">
    <SectionHeader
      number="01"
      label="Da dove vuoi partire"
      heading="Due strade, due obiettivi."
      headingAccent="due obiettivi."
      size="lg"
      lead="Scegli il percorso giusto per te: partecipare come nostro ospite, oppure adottare gli strumenti con cui gestiamo relazioni e sponsorizzazioni."
      class="mb-14"
    />

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 fork-cards">
      <!-- A -->
      <a
        href="/team/eventi"
        class="fork-card card-lift group relative overflow-hidden rounded-bento border border-hairline hover:border-hairline-strong min-h-[420px] flex flex-col justify-end"
      >
        <Picture
          src={teamCalcio}
          formats={["avif", "webp"]}
          fallbackFormat="webp"
          widths={[480, 800, 1200]}
          sizes="(min-width: 1792px) 692px, (min-width: 1024px) 50vw, 100vw"
          quality={60}
          alt="Tifosi allo stadio durante un evento sportivo"
          loading="lazy" decoding="async"
          class="absolute inset-0 w-full h-full object-cover opacity-45 group-hover:opacity-60 group-hover:scale-[1.03] transition-all duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-wtc-black via-wtc-black/70 to-transparent"></div>
        <div class="relative p-10 flex flex-col gap-4">
          <div><Badge variant="orange">Sei un cliente o un partner WTC</Badge></div>
          <h3 class="font-clash font-semibold text-display-md text-white">Vieni ai nostri eventi</h3>
          <p class="prose-body text-ice-grey/70 max-w-md">
            Ti invitiamo agli eventi sportivi che sponsorizziamo, dalla Serie A al paddock.
            Sfoglia il calendario e proponi la tua presenza.
          </p>
          <span class="link-arrow self-start font-inter text-sm text-wtc-orange mt-2">Eventi e inviti <span aria-hidden="true">→</span></span>
        </div>
      </a>

      <!-- B -->
      <a
        href="/team/software-consulting"
        class="fork-card card-lift group relative overflow-hidden rounded-bento bg-surface-01 border border-hairline hover:border-hairline-strong min-h-[420px] flex flex-col justify-end"
      >
        <div class="absolute inset-0 bg-orange-glow opacity-40 group-hover:opacity-60 transition-opacity duration-700"></div>
        <div class="absolute inset-0 bg-telemetry opacity-[0.35]"></div>
        <div class="relative p-10 flex flex-col gap-4">
          <div><Badge variant="neutral">Sei un'azienda</Badge></div>
          <h3 class="font-clash font-semibold text-display-md text-white">Software & consulting</h3>
          <p class="prose-body text-ice-grey/70 max-w-md">
            Porta nella tua azienda il metodo con cui trasformiamo lo sport in business: consulenza
            sulle sponsorizzazioni e un software per gestire ospitalità, inviti e relazioni.
          </p>
          <span class="link-arrow self-start font-inter text-sm text-wtc-orange mt-2">Scopri il metodo <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="relative section-px section-py max-w-container mx-auto border-t border-hairline">
    <SectionTexture />
    <SectionHeader
      number="02"
      label="Domande frequenti"
      heading="Domande su eventi e metodo."
      headingAccent="eventi e metodo."
      class="mb-10"
    />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        faqs.map((faq) => (
          <div class="rounded-bento bg-surface-01 border border-hairline p-6 flex flex-col gap-3">
            <h3 class="font-clash font-semibold text-lg text-white mb-2">{faq.q}</h3>
            <p class="prose-body-sm text-ice-grey/55">{faq.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Non sai da quale parte iniziare?"
    subtext="Scrivici due righe: capiamo insieme se ti conviene partire da un evento o dal metodo."
    actions={[
      { label: "Parla con noi", href: "/team/contatti", variant: "primary" },
    ]}
  />
</BranchLayout>

<style>
  /* The fork-card CTA span sits inside the relative content overlay, so it is
     not a direct child of the anchor — the global `a:hover > .link-arrow`
     group-hover selector can't reach it. Wire the card-level hover here. */
  .fork-card:hover .link-arrow > span[aria-hidden] {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .fork-card:hover .link-arrow > span[aria-hidden] {
      transform: none;
    }
  }
</style>

<script>
  import { gsap } from "@/lib/gsap";
  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.fromTo(
      ".fork-card",
      { y: 40, opacity: 0 },
      {
        scrollTrigger: { trigger: ".fork-cards", start: "top 88%", once: true },
        y: 0, opacity: 1, stagger: 0.12, duration: 0.8, ease: "power3.out",
        // Clear inline transform after the entrance so .card-lift:hover can translate.
        clearProps: "transform,opacity",
      },
    );
  });
</script>
