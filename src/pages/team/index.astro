---
import TeamLayout from "../../layouts/branch/TeamLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import Badge from "../../components/ui/Badge.astro";

const faqs = [
  {
    q: "Che cosa offre WTC Team?",
    a: "Due percorsi. Se sei un cliente o un partner WTC, ti invitiamo agli eventi sportivi che sponsorizziamo. Se sei un'azienda, ti mettiamo a disposizione il metodo: consulenza sulle sponsorizzazioni e un software per gestire hospitality e inviti.",
  },
  {
    q: "A quali sport è legato WTC Team?",
    a: "Calcio con Roma, Lazio, Genoa, Sampdoria e Parma; Formula 1 e MotoGP; Porsche Carrera Cup con il team Enrico Fulgenzi Racing; tennis e padel.",
  },
  {
    q: "Come faccio a partecipare a un evento?",
    a: "Vai alla pagina Eventi e inviti, sfoglia il calendario e proponi la tua presenza. Se non sei ancora nel nostro sistema, scrivici e ti diamo l'accesso.",
  },
  {
    q: "Quanto tempo impiega WTC Team a rispondere a una richiesta?",
    a: "Rispondiamo entro un giorno lavorativo. Per partnership, sponsorizzazioni, hospitality o collaborazioni basta scrivere ai contatti WTC Team.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<TeamLayout
  title="WTC Team — Sport, Sponsorship & Hospitality"
  description="Due percorsi: vieni con noi agli eventi sportivi che sponsorizziamo, oppure porta nella tua azienda il metodo, la consulenza e il software con cui trasformiamo le relazioni in business."
  structuredData={[faqLd]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="WTC Team"
    title="Lo sport apre le relazioni. Il metodo le trasforma in business."
    titleAccent="business"
    subtitle="Da anni usiamo sponsorizzazioni, hospitality ed eventi per far crescere le nostre aziende. Da qui partono due strade: vieni con noi agli eventi, oppure porta il nostro metodo dentro la tua azienda."
    ctas={[
      { label: "Vieni a un evento", href: "/team/eventi", variant: "primary" },
      { label: "Software & consulting", href: "/team/software-consulting", variant: "outline" },
    ]}
    bgVariant="radial"
    canvas="team"
    topOffset="nav-full"
  />

  <!-- BIVIO A / B -->
  <section class="section-px section-py max-w-[1600px] mx-auto">
    <div class="flex flex-col gap-4 mb-14 max-w-2xl">
      <SectionLabel number="01" label="Da dove vuoi partire" />
      <h2 class="font-clash font-semibold text-display-lg text-white">
        Due strade, <span class="text-wtc-orange">due obiettivi.</span>
      </h2>
      <p class="prose-lead text-ice-grey/55">
        Scegli il percorso giusto per te: partecipare come nostro ospite, oppure adottare gli
        strumenti con cui gestiamo relazioni e sponsorizzazioni.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 fork-cards">
      <!-- A -->
      <a
        href="/team/eventi"
        class="fork-card group relative overflow-hidden rounded-bento border border-white/[0.06] hover:border-white/[0.14] transition-all duration-500 min-h-[420px] flex flex-col justify-end"
      >
        <img
          src="/images/team/team-calcio.webp"
          alt="Tifosi allo stadio durante un evento sportivo"
          width="1600" height="900" loading="lazy" decoding="async"
          class="absolute inset-0 w-full h-full object-cover opacity-45 group-hover:opacity-60 group-hover:scale-[1.03] transition-all duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-wtc-black via-wtc-black/70 to-transparent"></div>
        <div class="relative p-10 flex flex-col gap-4">
          <div><Badge variant="orange">Sei un cliente o un partner WTC</Badge></div>
          <h3 class="font-clash font-semibold text-display-md text-white">Vieni ai nostri eventi</h3>
          <p class="prose-body text-ice-grey/70 max-w-md">
            Ti invitiamo agli eventi sportivi che sponsorizziamo, dalla Serie A al paddock.
            Sfoglia il calendario e proponi la tua presenza.
          </p>
          <span class="font-inter text-sm text-wtc-orange mt-2">Eventi e inviti →</span>
        </div>
      </a>

      <!-- B -->
      <a
        href="/team/software-consulting"
        class="fork-card group relative overflow-hidden rounded-bento bg-surface-01 border border-white/[0.06] hover:border-white/[0.14] transition-all duration-500 min-h-[420px] flex flex-col justify-end"
      >
        <div class="absolute inset-0 bg-orange-glow opacity-40 group-hover:opacity-60 transition-opacity duration-700"></div>
        <div class="absolute inset-0 telemetry-bg opacity-[0.35]"></div>
        <div class="relative p-10 flex flex-col gap-4">
          <div><Badge variant="neutral">Sei un'azienda</Badge></div>
          <h3 class="font-clash font-semibold text-display-md text-white">Software & consulting</h3>
          <p class="prose-body text-ice-grey/70 max-w-md">
            Porta nella tua azienda il metodo con cui trasformiamo lo sport in business: consulenza
            sulle sponsorizzazioni e un software per gestire hospitality, inviti e stakeholder.
          </p>
          <span class="font-inter text-sm text-wtc-orange mt-2">Scopri il metodo →</span>
        </div>
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.06]">
    <div class="flex flex-col gap-4 mb-10 max-w-2xl">
      <SectionLabel number="02" label="Domande frequenti" />
      <h2 class="font-clash font-semibold text-display-md text-white">
        Le domande <span class="text-wtc-orange">più comuni.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {
        faqs.map((faq) => (
          <div class="rounded-bento bg-surface-01 border border-white/[0.06] p-6 flex flex-col gap-3">
            <h3 class="font-clash font-semibold text-lg text-white mb-2">{faq.q}</h3>
            <p class="prose-body-sm text-ice-grey/55">{faq.a}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Non sai da quale parte iniziare?"
    subtext="Scrivici due righe: capiamo insieme se ti conviene partire da un evento o dal metodo."
    actions={[
      { label: "Parla con noi", href: "/team/contatti", variant: "primary" },
    ]}
  />
</TeamLayout>

<script>
  import { gsap } from "@/lib/gsap";
  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.fromTo(
      ".fork-card",
      { y: 40, opacity: 0 },
      {
        scrollTrigger: { trigger: ".fork-cards", start: "top 88%", once: true },
        y: 0, opacity: 1, stagger: 0.12, duration: 0.8, ease: "power3.out",
      },
    );
  });
</script>
