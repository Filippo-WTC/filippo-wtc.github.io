---
import TeamLayout from "../../layouts/branch/TeamLayout.astro";

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'WTC Team',
  legalName: 'WTC SERVICES S.r.l.s.',
  email: 'wtc@wtcteam.it',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Leone XIII, 464',
    postalCode: '00165',
    addressLocality: 'Roma',
    addressCountry: 'IT',
  },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<TeamLayout
  title="Contatti — WTC Team"
  description="Contatta WTC Team per partnership, sponsorizzazioni e hospitality: consulenza, software per la gestione degli inviti ed esperienze sul campo. Rispondiamo entro un giorno lavorativo."
  structuredData={[localBusinessLd]}
>
  <div class="pt-[72px] lg:pt-[124px]">

    <!-- Hero -->
    <section class="section-py section-px max-w-[1600px] mx-auto">
      <div class="max-w-2xl">
        <p class="font-inter text-xs text-wtc-orange tracking-widest uppercase mb-4">WTC Team — Contatti</p>
        <h1 class="font-clash font-semibold text-display-lg md:text-display-xl text-white mb-6 text-balance">
          Entra nel mondo WTC Team
        </h1>
        <p class="prose-lead text-text-muted max-w-lg">
          Sponsorizzazioni, hospitality, partnership o semplice curiosità: scrivici. Vuoi capire come trasformare eventi e relazioni in business, o partecipare a un evento? Da qui si parte: il calendario eventi lo trovi nella pagina principale.
        </p>
      </div>
    </section>

    <div class="section-px max-w-[1600px] mx-auto">
      <div class="h-px bg-white/[0.06]"></div>
    </div>

    <!-- Form + Sidebar -->
    <section class="section-py section-px max-w-[1600px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16 items-start">

        <!-- Email CTA (2/3) -->
        <div class="lg:col-span-2">
          <div class="flex flex-col gap-6 rounded-bento border border-white/[0.06] bg-surface-01 p-8 sm:p-10">
            <p class="prose-caption text-wtc-orange tracking-widest uppercase">Scrivici</p>
            <h2 class="font-clash font-semibold text-display-sm text-white text-balance">
              Scrivici due righe via email.<br />Ti rispondiamo entro un giorno lavorativo.
            </h2>
            <p class="prose-body text-text-muted max-w-lg">
              Consulenza sulle sponsorizzazioni, gestione dell'hospitality, licenza del software, partnership o semplice curiosità: raccontaci la tua idea o cosa vorresti sapere. Risponde una persona reale.
            </p>
            <a
              href="mailto:wtc@wtcteam.it?subject=Richiesta%20WTC%20Team"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 font-inter text-xs font-medium tracking-wide uppercase bg-wtc-orange text-white rounded-lg hover:bg-wtc-neon transition-colors duration-200"
            >
              Scrivici una email →
            </a>
          </div>
        </div>

        <!-- Sidebar (1/3) -->
        <div class="lg:col-span-1 flex flex-col gap-6">

          <div class="rounded-xl border border-white/[0.06] bg-surface-01/50 p-6 flex flex-col gap-5">
            <p class="prose-caption text-wtc-orange tracking-widest uppercase">Contatti diretti</p>

            <div class="flex flex-col gap-1">
              <p class="font-inter text-xs text-text-muted">Email</p>
              <a href="mailto:wtc@wtcteam.it" class="font-inter text-sm text-ice-grey hover:text-white transition-colors break-all">
                wtc@wtcteam.it
              </a>
            </div>

            <div class="pt-4 border-t border-white/[0.06]">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400 flex-shrink-0"></span>
                <p class="font-inter text-xs text-text-muted">Rispondiamo entro 1 giorno lavorativo</p>
              </div>
            </div>
          </div>

          <!-- Eventi -->
          <div class="rounded-xl border border-white/[0.06] bg-surface-01/30 p-6 flex flex-col gap-3">
            <p class="prose-caption text-ice-grey/60 tracking-widest uppercase">Eventi WTC Team</p>
            <p class="font-inter text-sm text-text-muted leading-relaxed">
              Per partecipare a un evento WTC Team trovi tutti gli appuntamenti nel calendario dedicato.
            </p>
            <a
              href="/team/eventi#partecipa"
              class="inline-flex items-center gap-1.5 font-inter text-xs text-ice-grey/70 hover:text-ice-grey transition-colors duration-200 group"
            >
              Vai al calendario eventi
              <span class="group-hover:translate-x-0.5 transition-transform duration-200">→</span>
            </a>
          </div>

        </div>

      </div>
    </section>

  </div>
</TeamLayout>
