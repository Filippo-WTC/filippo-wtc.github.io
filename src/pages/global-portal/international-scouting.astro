---
import GlobalPortalLayout from "../../layouts/branch/GlobalPortalLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import Timeline from "../../components/sections/Timeline.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import Button from "../../components/ui/Button.astro";

const timelineSteps = [
  {
    number: "01",
    title: "Capire cosa cerchi",
    description:
      "Partiamo dal prodotto e dai requisiti che ti servono davvero, per orientare i primi contatti con i produttori giusti.",
  },
  {
    number: "02",
    title: "Rompere il ghiaccio",
    description:
      "Importatori abituali e mediazione culturale aiutano ad avviare il dialogo con il produttore, superando lingua e distanze.",
  },
  {
    number: "03",
    title: "Accompagnare le prime fasi",
    description:
      "Ti affianchiamo nel primo tratto del rapporto, così la trattativa parte su basi chiare. Poi il business resta tuo.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Servizi partner',
      item: new URL('/global-portal/servizi-partner', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Ricerca e primo contatto',
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};
---

<GlobalPortalLayout
  title="Ricerca e primo contatto — WTC Global Portal"
  description="Supporto da importatori abituali, assistenza nelle prime fasi di contatto e mediazione culturale, come livello opzionale sopra il contatto a 1 €."
  structuredData={[breadcrumbLd]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Servizi partner — Primo contatto"
    title="Il primo contatto non lo affronti da solo."
    titleAccent="da solo"
    subtitle="Hai acquistato il contatto di un produttore sul portale, ma tra lingua, distanza e abitudini diverse la prima trattativa può essere delicata. Importatori abituali ti affiancano nelle prime fasi, con traduzione e mediazione culturale, per partire con il piede giusto."
    ctas={[
      {
        label: "Parlaci del tuo progetto",
        href: "/global-portal/contatti",
        variant: "primary",
      },
      {
        label: "Verifica della fabbrica",
        href: "/global-portal/factory-audit",
        variant: "outline",
      },
    ]}
    bgVariant="radial"
    topOffset="nav-full"
  />

  <section class="section-px section-py max-w-[1600px] mx-auto">
    <div class="max-w-3xl">
      <div class="flex flex-col gap-7">
        <SectionLabel number="02" label="Un supporto in più" />
        <h2
          class="font-clash font-semibold text-display-md text-white uppercase"
        >
          Un contatto in più<br />
          <span class="text-wtc-orange">tra te e il produttore.</span>
        </h2>
        <p class="prose-body text-ice-grey/55">
          Il portale ti dà il contatto diretto. Ma parlare con un produttore
          lontano, in una lingua diversa e con altre abitudini commerciali, non
          è sempre immediato.
        </p>
        <p class="prose-body text-ice-grey/55">
          Per questo una rete di importatori abituali può affiancarti nelle
          prime fasi del contatto: chi lavora già con quei mercati aiuta a
          leggere le risposte, a evitare fraintendimenti e a impostare la
          trattativa nel modo giusto.
        </p>
        <p class="prose-body text-ice-grey/55">
          La traduzione e la mediazione culturale fanno il resto, così le
          differenze di lingua e di stile non diventano un ostacolo. È un
          servizio opzionale: il portale funziona anche senza, ma quando serve
          hai qualcuno accanto.
        </p>
        <div>
          <Button href="/global-portal/factory-audit" variant="outline">
            Scopri come verifichiamo la fabbrica →
          </Button>
        </div>
      </div>
    </div>
  </section>

  <!-- TIMELINE -->
  <section
    class="section-px pt-10 pb-32 max-w-[1600px] mx-auto border-t border-white/[0.05]"
  >
    <div class="flex flex-col gap-4 mb-16">
      <SectionLabel number="03" label="Come ti affianchiamo" />
      <h2
        class="font-clash font-semibold text-display-md text-white uppercase max-w-2xl"
      >
        Dal contatto<br />
        <span class="text-wtc-orange">alla prima trattativa.</span>
      </h2>
      <p class="prose-body text-ice-grey/55 max-w-lg mt-2">
        Un accompagnamento leggero nelle prime fasi, per arrivare preparato al
        dialogo con il produttore.
      </p>
    </div>

    <Timeline steps={timelineSteps} />
  </section>

  <!-- CTA -->
  <CTASection
    headline="Hai il contatto ma non sai come muovere il primo passo?"
    subtext="Raccontaci con chi devi parlare e da dove arriva. Ti diciamo come possiamo affiancarti nelle prime fasi del contatto."
    actions={[
      {
        label: "Inizia il progetto",
        href: "/global-portal/contatti",
        variant: "primary",
      },
      {
        label: "Tutti i servizi partner",
        href: "/global-portal/servizi-partner",
        variant: "outline",
      },
    ]}
  />
</GlobalPortalLayout>
