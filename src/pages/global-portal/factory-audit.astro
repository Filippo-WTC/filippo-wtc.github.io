---
import BranchLayout from "../../layouts/BranchLayout.astro";
import { breadcrumbLd } from "../../lib/breadcrumbs";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionHeader from "../../components/ui/SectionHeader.astro";
import Badge from "../../components/ui/Badge.astro";

const auditChecklist = [
  {
    title: "Ispezione sul posto",
    desc: "Un partner va fisicamente in fabbrica e guarda con i suoi occhi, invece di fidarsi di foto e presentazioni inviate via email.",
  },
  {
    title: "Esistenza produttiva",
    desc: "Verifica che lo stabilimento esista davvero e produca ciò che dichiara, prima che tu versi un acconto.",
  },
  {
    title: "Capacità produttiva reale",
    desc: "Macchinari, linee attive e organizzazione: si controlla che la fabbrica possa reggere la commessa nei tempi, senza subappaltare a tua insaputa.",
  },
  {
    title: "Controlli sui lotti",
    desc: "Ispezioni sulla merce prodotta per confermare che corrisponda a quanto concordato, prima della spedizione.",
  },
  {
    title: "Controlli sui campioni",
    desc: "Verifica dei campioni e della rispondenza ai capitolati, così sai cosa aspettarti prima dell'ordine vero e proprio.",
  },
  {
    title: "Audit documentali",
    desc: "Visure, licenze ed eventuali certificazioni: si verifica che le carte corrispondano ai fatti.",
  },
];

const breadcrumb = breadcrumbLd(
  [
    { name: "WTC Global Portal", path: "/global-portal/" },
    { name: "Servizi partner", path: "/global-portal/servizi-partner/" },
    { name: "Audit Fabbriche", path: Astro.url.pathname },
  ],
  Astro.site,
);
---

<BranchLayout
  branchId="global-portal"
  title="Audit Fabbriche — WTC Global Portal"
  description="Verifica degli stabilimenti prima di ogni ordine. Ispezioni, controlli qualità e audit documentali sul posto, prima che tu versi un euro di acconto."
  structuredData={[breadcrumb]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Servizi partner — Audit"
    title="Non fidarti delle foto."
    titleAccent="foto"
    subtitle="Hai già il contatto di un produttore dal portale? Prima di ordinare, la rete di partner va a verificare lo stabilimento sul posto, prima che tu versi un euro di acconto."
    ctas={[
      { label: "Richiedi un audit", href: "/global-portal/contatti/", variant: "primary" },
      { label: "Scouting internazionale", href: "/global-portal/international-scouting/", variant: "outline" },
    ]}
    bgVariant="radial"
    topOffset="nav-full"
  />

  <!-- AUDIT GRID -->
  <section class="section-px section-py max-w-container mx-auto">
    <div class="flex flex-col gap-4 mb-14">
      <SectionHeader label="Cosa verifichiamo" size="lg">
        Prima l'ispezione.<br />
        <span class="text-wtc-orange">Poi l'ordine.</span>
      </SectionHeader>
      <p class="prose-lead text-ice-grey/55 max-w-xl mt-2">
        L'audit si appoggia a una rete di partner internazionali che va sul posto e controlla ciò che conta davvero, senza lasciare gli aspetti critici al caso.
      </p>
      <p class="prose-lead text-ice-grey/55 max-w-xl mt-2">
        Ogni verifica produce un riscontro documentale e fotografico da condividere con te prima di qualunque impegno economico. L'idea è semplice: non fermarsi alle carte, ma controllare che macchinari, produzione e documenti corrispondano davvero a quanto dichiarato.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 audit-grid">
      {
        auditChecklist.map((item) => (
          <div class="audit-card rounded-bento bg-surface-01 border border-hairline p-8 flex flex-col gap-3 hover:border-hairline-strong transition-colors duration-300">
            <h3 class="font-clash font-semibold text-base text-white">{item.title}</h3>
            <p class="prose-body-sm text-ice-grey/55">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Pronto a verificare il tuo fornitore?"
    subtext="Le foto e i certificati inviati via email non bastano a garantire uno stabilimento: una rete di partner internazionali verifica di persona la fabbrica, prima che tu ti impegni."
    actions={[
      { label: "Parlaci del tuo progetto", href: "/global-portal/contatti/", variant: "primary" },
      { label: "Importazione completa", href: "/global-portal/import-turnkey/", variant: "outline" },
    ]}
  />
</BranchLayout>

<script>
  import { gsap } from "@/lib/gsap";

  document.addEventListener("astro:page-load", () => {
    // Reduced motion: skip all GSAP entrances (elements stay/are forced visible by CSS).
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    gsap.fromTo(
      ".audit-card",
      { y: 40, opacity: 0 },
      {
        scrollTrigger: { trigger: ".audit-grid", start: "top 88%", once: true },
        y: 0, opacity: 1, stagger: 0.08, duration: 0.85, ease: "power3.out",
      },
    );
  });
</script>
