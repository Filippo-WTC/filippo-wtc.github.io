---
import GlobalPortalLayout from "../../layouts/branch/GlobalPortalLayout.astro";

const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'WTC Services S.r.l.s.',
  email: 'wtc@worldtradecontacts.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Via Leone XIII, 464',
    postalCode: '00165',
    addressLocality: 'Roma',
    addressCountry: 'IT',
  },
  url: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<GlobalPortalLayout
  title="Contatti — WTC Global Portal"
  description="Avvia una trattativa con WTC Global Portal. Scouting internazionale, audit fabbriche, importazione completa: raccontaci il tuo progetto."
  structuredData={[localBusinessLd]}
>
  <div class="pt-[72px] lg:pt-[124px]">

    <!-- Hero -->
    <section class="section-py section-px max-w-[1600px] mx-auto">
      <div class="max-w-2xl">
        <p class="font-inter text-xs text-wtc-orange tracking-widest uppercase mb-4">WTC Global Portal — Contatti</p>
        <h1 class="font-clash font-semibold text-display-lg md:text-display-xl text-white mb-6 text-balance">
          Avvia una trattativa
        </h1>
        <p class="font-inter text-lg text-text-muted leading-relaxed max-w-lg">
          Stai cercando fornitori esteri, hai bisogno di verificare una fabbrica o vuoi gestire un'importazione dalla A alla Z? Dimmi cosa ti serve e ti diciamo come possiamo aiutarti.
        </p>
      </div>
    </section>

    <div class="section-px max-w-[1600px] mx-auto">
      <div class="h-px bg-white/[0.06]"></div>
    </div>

    <!-- Form + Sidebar -->
    <section class="section-py section-px max-w-[1600px] mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-16 items-start">

        <!-- Email CTA (2/3) -->
        <div class="lg:col-span-2">
          <div class="flex flex-col gap-6 rounded-bento border border-white/[0.06] bg-surface-01 p-8 sm:p-10">
            <p class="font-inter text-[10px] text-wtc-orange tracking-widest uppercase">Scrivici</p>
            <h2 class="font-clash font-semibold text-display-sm text-white text-balance">
              Raccontaci il progetto via email.<br />Ti rispondiamo entro un giorno lavorativo.
            </h2>
            <p class="font-inter text-base text-text-muted leading-relaxed max-w-lg">
              Dicci da dove vuoi importare, quale prodotto o settore ti interessa e cosa ti serve — scouting, audit di fabbrica o importazione completa. Valutiamo la fattibilità e ti proponiamo un piano operativo.
            </p>
            <a
              href="mailto:wtc@wtcglobalportal.it?subject=Richiesta%20WTC%20Global%20Portal"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 font-inter text-xs font-medium tracking-wide uppercase bg-wtc-orange text-white rounded-lg hover:bg-wtc-neon transition-colors duration-200"
            >
              Scrivici una email →
            </a>
          </div>
        </div>

        <!-- Sidebar (1/3) -->
        <div class="lg:col-span-1 flex flex-col gap-6">

          <div class="rounded-xl border border-white/[0.06] bg-surface-01/50 p-6 flex flex-col gap-5">
            <p class="font-inter text-[10px] text-wtc-orange tracking-widest uppercase">Contatti diretti</p>

            <div class="flex flex-col gap-1">
              <p class="font-inter text-xs text-text-muted">Email</p>
              <a href="mailto:wtc@wtcglobalportal.it" class="font-inter text-sm text-ice-grey hover:text-white transition-colors break-all">
                wtc@wtcglobalportal.it
              </a>
            </div>

            <div class="flex flex-col gap-1">
              <p class="font-inter text-xs text-text-muted">Sede legale</p>
              <p class="font-inter text-sm text-ice-grey leading-relaxed">
                Via Leone XIII, 464<br />
                00165 Roma (RM)
              </p>
            </div>

            <div class="pt-4 border-t border-white/[0.06]">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400 flex-shrink-0"></span>
                <p class="font-inter text-xs text-text-muted">Rispondiamo entro 1 giorno lavorativo</p>
              </div>
            </div>
          </div>

          <!-- Info box -->
          <div class="rounded-xl border border-white/[0.06] bg-surface-01/30 p-6 flex flex-col gap-3">
            <p class="font-inter text-[10px] text-ice-grey/40 tracking-widest uppercase">Come funziona</p>
            <p class="font-inter text-sm text-text-muted leading-relaxed">
              Dopo la tua richiesta, valutiamo la fattibilità e ti proponiamo un piano operativo su misura. Nessun impegno prima di una chiamata conoscitiva.
            </p>
          </div>

        </div>

      </div>
    </section>

  </div>
</GlobalPortalLayout>
