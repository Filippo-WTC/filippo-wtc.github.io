---
import GlobalPortalLayout from "../../layouts/branch/GlobalPortalLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import CTASection from "../../components/sections/CTASection.astro";
import Timeline from "../../components/sections/Timeline.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";

const importTimeline = [
  {
    number: "01",
    title: "Controllo prima della spedizione",
    description: "Prima di partire, la merce viene controllata in fabbrica: se qualcosa non torna, non si imbarca.",
  },
  {
    number: "02",
    title: "Documenti e procedure di importazione",
    description: "Consulenza sulle procedure di importazione e sulle pratiche doganali, per muoversi senza sorprese tra dazi e adempimenti.",
  },
  {
    number: "03",
    title: "Spedizione e trasporto",
    description: "Spedizionieri internazionali affidabili organizzano il trasporto, via mare o via aerea, con un percorso seguito passo passo.",
  },
  {
    number: "04",
    title: "Sdoganamento",
    description: "I documenti vengono preparati in anticipo, così la merce non resta bloccata in dogana.",
  },
  {
    number: "05",
    title: "Consegna al magazzino",
    description: "Supporto logistico fino allo scarico e alla consegna programmata nel tuo magazzino, pronta per la vendita.",
  },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Servizi partner',
      item: new URL('/global-portal/servizi-partner', Astro.site).toString(),
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'Importazione Completa',
      item: new URL(Astro.url.pathname, Astro.site).toString(),
    },
  ],
};
---

<GlobalPortalLayout
  title="Importazione Completa — WTC Global Portal"
  description="Dalla fabbrica al magazzino. Consulenza sulle procedure di importazione, spedizionieri internazionali affidabili e supporto logistico, come livello opzionale sopra il contatto a 1 €."
  structuredData={[breadcrumbLd]}
>
  <!-- HERO -->
  <HeroSection
    eyebrow="Servizi partner — Importazione"
    title="Dalla fabbrica al magazzino."
    titleAccent="al magazzino"
    subtitle="Il servizio partner per chi, trovato il produttore sul portale, vuole delegare tutta l'importazione: consulenza sulle procedure doganali, spedizionieri affidabili e supporto logistico, fino alla consegna programmata nel tuo magazzino."
    ctas={[
      { label: "Richiedi un preventivo", href: "/global-portal/contatti", variant: "primary" },
      { label: "Audit fabbriche", href: "/global-portal/factory-audit", variant: "outline" },
    ]}
    bgVariant="radial"
    topOffset="nav-full"
  />

  <!-- TIMELINE -->
  <section class="section-px section-py max-w-[1600px] mx-auto">
    <div class="flex flex-col gap-4 mb-14">
      <SectionLabel label="Il processo" />
      <h2 class="font-clash font-semibold text-display-lg text-white max-w-2xl">
        Cinque fasi.<br />
        <span class="text-wtc-orange">Zero imprevisti.</span>
      </h2>
      <p class="prose-lead text-ice-grey/55 max-w-xl mt-2">
        Ogni spedizione segue un percorso ordinato, dal controllo prima della partenza alla consegna finale, così nulla resta lasciato al caso.
      </p>
      <p class="prose-lead text-ice-grey/55 max-w-xl mt-2">
        Una rete di spedizionieri affidabili segue il trasporto con un referente unico, così sai sempre chi contattare in caso di ritardo. La consulenza sulle procedure di importazione aiuta a preparare i documenti doganali in anticipo, per evitare fermi e giacenze impreviste.
      </p>
    </div>

    <Timeline steps={importTimeline} />
  </section>

  <!-- CTA -->
  <CTASection
    headline="Pronto a scalare la tua produzione?"
    subtext="Un container fermo in dogana o un trasporto saltato costa più di qualunque sconto ottenuto a monte: una rete di partner internazionali segue procedure di importazione, dazi e trasporto al posto tuo."
    actions={[
      { label: "Parlaci del tuo progetto", href: "/global-portal/contatti", variant: "primary" },
      { label: "Scouting internazionale", href: "/global-portal/international-scouting", variant: "outline" },
    ]}
  />
</GlobalPortalLayout>
