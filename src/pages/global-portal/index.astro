---
import GlobalPortalLayout from "../../layouts/branch/GlobalPortalLayout.astro";
import HeroSection from "../../components/sections/HeroSection.astro";
import StatsRow from "../../components/sections/StatsRow.astro";
import CTASection from "../../components/sections/CTASection.astro";
import SectionLabel from "../../components/ui/SectionLabel.astro";
import Button from "../../components/ui/Button.astro";
import Badge from "../../components/ui/Badge.astro";
---

<GlobalPortalLayout
  title="WTC Global Portal — Trova produttori nel mondo"
  description="Il database globale che collega aziende e produttori. I produttori si iscrivono gratis, le aziende cercano per prodotto e area e acquistano solo i contatti che servono, a 1 € ciascuno. Nessuna provvigione, nessuna intermediazione."
>
  <!-- HERO -->
  <HeroSection
    eyebrow="WTC Global Portal"
    title="Trova produttori nel mondo, senza intermediari."
    titleAccent="senza intermediari"
    subtitle="Un database globale di produttori e prodotti. Le aziende cercano per prodotto e area geografica, poi acquistano solo i contatti che servono a 1 € ciascuno. La trattativa resta diretta, tra chi compra e chi produce, senza provvigioni."
    ctas={[
      { label: "Per le aziende", href: "/global-portal/aziende", variant: "primary" },
      { label: "Per i produttori", href: "/global-portal/produttori", variant: "outline" },
    ]}
    bgVariant="radial"
    canvas="globe"
    topOffset="nav-full"
  />

  <!-- STATS -->
  <StatsRow
    stats={[
      { value: "1", suffix: " €", label: "Per contatto acquistato" },
      { value: "0", label: "Provvigioni sulle trattative" },
      { value: "0", label: "Costi per i produttori" },
    ]}
  />

  <!-- IL PROBLEMA -->
  <section class="section-px section-py max-w-[1600px] mx-auto">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
      <div class="flex flex-col gap-7">
        <SectionLabel number="01" label="Il problema che risolviamo" />
        <h2 class="font-clash font-semibold text-display-md text-white uppercase">
          Meno pubblicità inutile.<br />
          <span class="text-wtc-orange">Più richieste reali.</span>
        </h2>
        <p class="prose-body text-ice-grey/55">
          Nel commercio internazionale i produttori mandano listini, cataloghi e
          offerte ad aziende che in quel momento non hanno alcuna necessità. Si
          perde tempo, le comunicazioni cadono nel vuoto e chi riceve offerte non
          richieste spesso le vive come un disturbo.
        </p>
        <p class="prose-body text-ice-grey/55">
          Con WTC Global Portal il meccanismo si rovescia. Non è il produttore a
          inseguire il cliente: è l'azienda che, quando ha davvero bisogno, cerca
          il prodotto e acquista i contatti dei produttori che rispondono ai
          filtri scelti. Ogni contatto nasce da una richiesta attiva.
        </p>
      </div>

      <div class="rounded-bento bg-surface-01 border border-white/[0.06] p-10 flex flex-col gap-6">
        <Badge variant="orange">Come nasce un contatto</Badge>
        <ul class="flex flex-col gap-5">
          <li class="flex gap-4">
            <span class="font-clash font-semibold text-wtc-orange text-lg leading-none pt-0.5">1</span>
            <p class="font-inter text-sm text-ice-grey/60 leading-relaxed">
              Un produttore si iscrive gratis e inserisce i prodotti che realizza.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="font-clash font-semibold text-wtc-orange text-lg leading-none pt-0.5">2</span>
            <p class="font-inter text-sm text-ice-grey/60 leading-relaxed">
              Un'azienda cerca quel prodotto in una precisa area geografica.
            </p>
          </li>
          <li class="flex gap-4">
            <span class="font-clash font-semibold text-wtc-orange text-lg leading-none pt-0.5">3</span>
            <p class="font-inter text-sm text-ice-grey/60 leading-relaxed">
              L'azienda acquista il contatto e scrive direttamente al produttore.
            </p>
          </li>
        </ul>
        <p class="font-inter text-sm text-ice-grey/60 leading-relaxed border-t border-white/[0.06] pt-6">
          Nessuna offerta non richiesta. Solo aziende che stanno già cercando ciò
          che il produttore realizza.
        </p>
      </div>
    </div>
  </section>

  <!-- DUE PUBBLICI -->
  <section class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.05]">
    <div class="flex flex-col gap-4 mb-16">
      <SectionLabel number="02" label="Due modi di usare il portale" />
      <h2 class="font-clash font-semibold text-display-lg text-white max-w-2xl">
        Un solo database,<br />
        <span class="text-wtc-orange">due punti di vista.</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      <article class="group relative overflow-hidden rounded-bento bg-surface-01 border border-white/[0.06] p-10 flex flex-col gap-7 hover:border-white/[0.12] transition-all duration-500">
        <Badge variant="orange">Per le aziende</Badge>
        <div>
          <h3 class="font-clash font-semibold text-display-sm text-white mb-4">Cerca e acquista contatti</h3>
          <p class="font-inter text-sm text-ice-grey/55 leading-relaxed">
            Imposti i filtri — prodotto, paese, regione, città — e vedi quanti
            produttori rispondono. Scegli quanti contatti acquistare, da uno fino
            al totale dei risultati, a 1 € ciascuno. Poi tratti direttamente con
            loro, senza provvigioni.
          </p>
        </div>
        <div class="mt-auto pt-6">
          <Button href="/global-portal/aziende" variant="outline">Per le aziende →</Button>
        </div>
      </article>

      <article class="group relative overflow-hidden rounded-bento bg-surface-01 border border-white/[0.06] p-10 flex flex-col gap-7 hover:border-white/[0.12] transition-all duration-500">
        <Badge variant="outline">Per i produttori</Badge>
        <div>
          <h3 class="font-clash font-semibold text-display-sm text-white mb-4">Fatti trovare, gratis</h3>
          <p class="font-inter text-sm text-ice-grey/55 leading-relaxed">
            Ti iscrivi gratis e inserisci la tua azienda, le aree di produzione e
            l'elenco dei prodotti. Da lì entri in un database globale e vieni
            trovato solo quando un'azienda cerca proprio ciò che produci. Nessun
            abbonamento, nessuna commissione.
          </p>
        </div>
        <div class="mt-auto pt-6">
          <Button href="/global-portal/produttori" variant="outline">Per i produttori →</Button>
        </div>
      </article>
    </div>
  </section>

  <!-- COME FUNZIONA TEASER -->
  <section class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.05]">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <div class="flex flex-col gap-7">
        <SectionLabel number="03" label="Come funziona" />
        <h2 class="font-clash font-semibold text-display-md text-white uppercase">
          Cerca. Acquista il contatto.<br />
          <span class="text-wtc-orange">Tratta direttamente.</span>
        </h2>
        <p class="prose-body text-ice-grey/55">
          Il funzionamento è lineare. Un'azienda cerca un prodotto e il portale
          mostra quanti produttori rispondono ai criteri. Se ne trova 148
          compatibili, decide quanti contatti acquistare — 1, 10, 25, fino al
          totale. Quando più produttori rispondono agli stessi filtri, i contatti
          si estraggono in modo casuale: il portale non assegna punteggi e non
          vende posizioni privilegiate.
        </p>
        <div>
          <Button href="/global-portal/come-funziona" variant="outline">
            Vedi il funzionamento e le FAQ →
          </Button>
        </div>
      </div>

      <div class="rounded-bento bg-surface-01 border border-white/[0.06] p-10 flex flex-col gap-6">
        <div class="flex items-baseline gap-3">
          <span class="font-clash font-semibold text-display-md text-wtc-orange leading-none">148</span>
          <span class="font-inter text-sm text-ice-grey/60">produttori compatibili</span>
        </div>
        <div class="h-[1px] bg-white/[0.06]"></div>
        <div class="flex flex-col gap-4 font-inter text-sm text-ice-grey/60">
          <div class="flex justify-between gap-4">
            <span>10 contatti</span>
            <span class="text-white">10 €</span>
          </div>
          <div class="flex justify-between gap-4">
            <span>25 contatti</span>
            <span class="text-white">25 €</span>
          </div>
          <div class="flex justify-between gap-4">
            <span>Tutti i 148 contatti</span>
            <span class="text-white">148 €</span>
          </div>
        </div>
        <p class="font-inter text-sm text-ice-grey/60 leading-relaxed border-t border-white/[0.06] pt-6">
          Nessun abbonamento obbligatorio e nessuna commissione sulle trattative.
          Il prezzo del contatto è tutto quello che paghi.
        </p>
      </div>
    </div>
  </section>

  <!-- SERVIZI PARTNER TEASER -->
  <section class="section-px section-py max-w-[1600px] mx-auto border-t border-white/[0.05]">
    <div class="rounded-bento bg-surface-01 border border-white/[0.06] p-10 md:p-14 flex flex-col lg:flex-row gap-10 lg:items-center justify-between">
      <div class="flex flex-col gap-5 max-w-xl">
        <Badge variant="neutral">Servizi partner — opzionali</Badge>
        <h2 class="font-clash font-semibold text-display-sm text-white">
          Quando serve più sicurezza, c'è una rete di partner.
        </h2>
        <p class="font-inter text-sm text-ice-grey/55 leading-relaxed">
          Il cuore del portale resta la connessione diretta tra domanda e offerta.
          Ma per chi importa da lontano, una rete di partner internazionali può
          aggiungere ispezioni in fabbrica, controlli qualità, supporto import e
          logistica. Un layer in più, solo se ti serve.
        </p>
      </div>
      <div class="shrink-0">
        <Button href="/global-portal/servizi-partner" variant="outline">
          Scopri i servizi partner →
        </Button>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <CTASection
    headline="Gratis per i produttori. 1 € a contatto per le aziende."
    subtext="Per iniziare basta una email. I produttori si iscrivono gratis, le aziende pagano solo i contatti che scelgono di acquistare."
    actions={[
      { label: "Per le aziende", href: "/global-portal/aziende", variant: "primary" },
      { label: "Per i produttori", href: "/global-portal/produttori", variant: "outline" },
    ]}
  />
</GlobalPortalLayout>
