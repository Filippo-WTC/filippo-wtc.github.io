---
import "@/styles/global.css";
import MotionRuntime from "@/components/global/MotionRuntime.astro";
import { ViewTransitions } from "astro:transitions";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  structuredData?: object[];
  /** Set false on content-only pages (legal, 404) to skip Lenis/GSAP */
  motion?: boolean;
}

const {
  title = "WTC — Infrastrutture IT per il Business",
  description = "WTC: supporto IT enterprise, networking, import globale e agro-industria. Competenza e discrezione al servizio della tua azienda.",
  ogImage = "/images/og/default.png",
  structuredData = [],
  motion = true,
} = Astro.props;

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://wtctesting.it",
);

const ogImageURL = new URL(ogImage, Astro.site ?? "https://wtctesting.it");

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "WTC Services S.r.l.s.",
  url: "https://wtctesting.it",
  logo: "https://wtctesting.it/images/logos/wtc-logo.png",
  sameAs: [],
  contactPoint: {
    "@type": "ContactPoint",
    email: "wtc@wtcservices.it",
    contactType: "customer service",
    areaServed: "IT",
    availableLanguage: "Italian",
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: "Via Leone XIII, 464",
    postalCode: "00165",
    addressLocality: "Roma",
    addressCountry: "IT",
  },
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "WTC Group",
  url: "https://wtctesting.it",
  inLanguage: "it-IT",
};

const allStructuredData = [organizationLd, websiteLd, ...structuredData];
---

<!doctype html>
<html lang="it" class="scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="WTC Group" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicon — WTC brand mark (public/scripts/make-og.mjs generates the set) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0B0F" />

    <!-- Self-hosted fonts (declared via @font-face in global.css — no external
         CDN, so they always load and there's no Google Fonts GDPR exposure).
         Preload the two files needed for first paint. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ClashDisplay-Variable.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Inter-latin.woff2"
      crossorigin
    />

    <!-- JSON-LD structured data: Organization + WebSite (site-wide) plus any page-specific schema -->
    {allStructuredData.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    <!-- Safari gets simpler hero-entrance keyframes (no blur/scale — the
         animated filter is WebKit's historically fragile path). Inline and
         blocking so the class exists before first paint: no flash, and the
         CSS picks the right animation from frame zero. -->
    <script is:inline>
      if (/^((?!chrome|android|crios|fxios|edg).)*safari/i.test(navigator.userAgent)) {
        document.documentElement.classList.add("is-safari");
      }
    </script>

    <ViewTransitions />
  </head>

  <body
    class="bg-wtc-black text-wtc-white font-inter antialiased overflow-x-hidden"
  >
    <!-- Skip to content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-wtc-orange focus:text-white focus:rounded"
    >
      Vai al contenuto
    </a>

    <!-- Ambient background — subtle drifting glow + film grain that
         de-flattens the large dark surfaces (near-threshold: you only
         notice it when it's gone) -->
    <div
      class="fixed inset-0 pointer-events-none z-0 overflow-hidden"
      aria-hidden="true"
    >
      <div class="ambient-orb"></div>
      <div class="grain-overlay"></div>
    </div>

    <!-- Page transition overlay -->
    <div
      id="page-transition"
      aria-hidden="true"
      class="fixed inset-0 z-[9998] bg-wtc-black opacity-0 pointer-events-none flex items-center justify-center"
    >
      <img
        src="/images/logos/wtc-logo-white.png"
        alt=""
        width="800"
        height="212"
        class="h-16 w-auto object-contain opacity-0 page-transition-logo"
      />
    </div>

    <slot />

    {motion && <MotionRuntime />}
  </body>
</html>
