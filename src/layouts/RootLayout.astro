---
import "@/styles/global.css";
import MotionRuntime from "@/components/global/MotionRuntime.astro";
import { ogForPath } from "@/lib/og";
import { ViewTransitions } from "astro:transitions";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  structuredData?: object[];
  /** Set false on content-only pages (legal, 404) to skip Lenis/GSAP */
  motion?: boolean;
  /**
   * Forza noindex,nofollow indipendentemente da PUBLIC_INDEXABLE e SOPPRIME il
   * canonical. Per pagine che non devono mai essere indicizzate e il cui URL non
   * è una risorsa canonica reale (la 404: il suo canonical punterebbe a un URL
   * inesistente — un canonical sbagliato va rimosso, non accompagnato).
   */
  noindex?: boolean;
  /**
   * Directory (under /public) holding a per-business-unit favicon set
   * (favicon.svg, favicon-16/32, apple-touch-icon.png). Empty = the group
   * WTC mark at the site root. BranchLayout maps each branch to its set.
   */
  faviconDir?: string;
}

const {
  title = "WTC — Infrastrutture IT per il Business",
  description = "WTC: supporto IT enterprise, networking, import globale e agro-industria. Competenza e discrezione al servizio della tua azienda.",
  ogImage,
  structuredData = [],
  motion = true,
  faviconDir = "",
  noindex = false,
} = Astro.props;

// noindex esplicito (404) batte il gate di build; altrimenti PUBLIC_INDEXABLE.
const robotsContent =
  noindex || import.meta.env.PUBLIC_INDEXABLE !== "true"
    ? "noindex, nofollow"
    : "index, follow";

// Trailing-slash-safe base: "" -> group mark at root, "/favicons/team" -> BU set
const favBase = faviconDir.replace(/\/$/, "");

// Explicit prop (incl. BranchLayout's resolution) > per-page card > default
const resolvedOgImage =
  ogImage ?? ogForPath(Astro.url.pathname) ?? "/images/og/default.png";

const canonicalURL = new URL(
  Astro.url.pathname,
  Astro.site ?? "https://wtctesting.it",
);

const ogImageURL = new URL(
  resolvedOgImage,
  Astro.site ?? "https://wtctesting.it",
);

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "WTC SERVICES S.r.l.s.",
  url: "https://wtctesting.it",
  logo: "https://wtctesting.it/images/logos/wtc-logo.png",
  vatID: "IT14561821001",
  sameAs: [
    "https://www.linkedin.com/company/wtcservices/",
    "https://www.linkedin.com/showcase/world-trade-contacts/",
    "https://www.linkedin.com/showcase/pitter-italy/",
    "https://www.linkedin.com/showcase/wtc-food/",
    "https://www.linkedin.com/showcase/wtc-team/",
  ],
  contactPoint: {
    "@type": "ContactPoint",
    email: "wtc@wtcservices.it",
    contactType: "customer service",
    areaServed: "IT",
    availableLanguage: "Italian",
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: "Via Leone XIII, 464",
    postalCode: "00165",
    addressLocality: "Roma",
    addressCountry: "IT",
  },
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "WTC Group",
  url: "https://wtctesting.it",
  inLanguage: "it-IT",
};

const allStructuredData = [organizationLd, websiteLd, ...structuredData];
---

<!doctype html>
<html lang="it" class="scroll-auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Sicurezza. Sono le sole mitigazioni che funzionano via <meta> su GitHub
         Pages (che non permette header custom). CSP con 'unsafe-inline' su
         script/style perché il sito usa 33 style inline, un onerror inline e due
         script inline: una CSP con hash (che li coprirebbe in modo forte) li
         DISABILITEREBBE — con un hash presente il browser ignora 'unsafe-inline'
         — quindi romperebbe layout e fallback loghi finché quegli inline non
         vengono rifattorizzati. Resta comunque reale: default-src 'self',
         object-src 'none', base-uri 'self', frame-src ristretto all'app eventi,
         form-action limitata a Web3Forms.
         NB: niente upgrade-insecure-requests — non serve (nessun mixed content,
         su GitHub Pages è già tutto https) e romperebbe la preview locale in
         http (Safari upgrada anche localhost, lasciando la pagina senza stili).
         HSTS, X-Frame-Options e X-Content-Type-Options NON esistono come meta:
         vanno impostati come header veri su Cloudflare dopo il lancio. -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-src https://contacts.wtcteam.com; connect-src 'self' https://api.web3forms.com; form-action 'self' https://api.web3forms.com; base-uri 'self'; object-src 'none'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {/* Niente canonical sulle pagine noindex (404): punterebbe a un URL che non
        è una risorsa reale. Un canonical sbagliato va soppresso, non emesso. */}
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Indicizzazione gated sul build: di default noindex, così il dominio di
         test wtctesting.it non accumula canonicità sbagliata. Al lancio sul
         dominio definitivo si passa PUBLIC_INDEXABLE=true nell'env del workflow.
         Tenuto crawlabile (robots.txt Allow) apposta: serve che i motori leggano
         il noindex per de-indicizzare ciò che è già a indice. La 404 passa
         noindex esplicito, che resta anche dopo il lancio. -->
    <meta name="robots" content={robotsContent} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="WTC Group" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={title} />

    <!-- Favicon — group WTC mark by default; BranchLayout passes faviconDir so
         each business unit shows its own two-tone mark in the browser tab. -->
    <link rel="icon" type="image/svg+xml" href={`${favBase}/favicon.svg`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`${favBase}/favicon-32x32.png`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`${favBase}/favicon-16x16.png`} />
    <link rel="apple-touch-icon" href={`${favBase}/apple-touch-icon.png`} />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0B0F" />

    <!-- Self-hosted fonts (declared via @font-face in global.css — no external
         CDN, so they always load and there's no Google Fonts GDPR exposure).
         Preload the two files needed for first paint. -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ClashDisplay-Variable.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/Inter-latin.woff2"
      crossorigin
    />

    <!-- JSON-LD structured data: Organization + WebSite (site-wide) plus any page-specific schema -->
    {allStructuredData.map((entry) => (
      <script type="application/ld+json" set:html={JSON.stringify(entry)} />
    ))}

    <!-- Safari gets blur-free hero-entrance keyframes (the animated filter is
         WebKit's historically fragile path). Inline and blocking so the class
         exists before first paint: no flash, and the CSS picks the right
         animation from frame zero. The view-transition swap replaces <html>'s
         attributes with the incoming document's, wiping runtime classes — so
         re-add ours on astro:after-swap (fires before the new page paints). -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var isSafari = /^((?!chrome|android|crios|fxios|edg).)*safari/i.test(navigator.userAgent);
        // Il browser risolve la favicon una volta sola, al caricamento del
        // documento. Con le view transition il <head> viene sostituito e il
        // link punta già alla favicon giusta della business unit — ma i browser
        // NON ri-valutano l'icona quando il nodo viene rimpiazzato nel DOM:
        // la tab resta con quella di partenza finché non si forza un reload.
        // Ricreare i nodi da zero (elementi nuovi, non href modificato) è ciò
        // che li convince a rileggerla. Gli URL sono già distinti per business
        // unit, quindi non serve cache-buster e la cache resta valida.
        var refreshFavicons = function () {
          var links = document.querySelectorAll(
            'link[rel~="icon"], link[rel="apple-touch-icon"]',
          );
          for (var i = 0; i < links.length; i++) {
            var old = links[i];
            var next = document.createElement("link");
            for (var j = 0; j < old.attributes.length; j++) {
              next.setAttribute(old.attributes[j].name, old.attributes[j].value);
            }
            old.parentNode.removeChild(old);
            document.head.appendChild(next);
          }
        };

        var mark = function () {
          if (isSafari) root.classList.add("is-safari");
          refreshFavicons();
          // `js`: segnala che il JS gira. Le reveal (.js-reveal/.hero-anim-start)
          // partono da opacity:0 solo sotto html.js, così senza JS restano
          // visibili invece di sparire. Ri-aggiunta a ogni swap: la view
          // transition sostituisce le classi di <html>.
          root.classList.add("js");
          // Set from the first swap onwards, never on a cold load: lets CSS
          // tell "arrived fresh" from "navigated here", so entrance
          // animations that should play once don't replay on every page.
          root.setAttribute("data-navigated", "");
        };
        if (isSafari) root.classList.add("is-safari");
        // Anche a freddo, prima del paint: niente lampo di contenuto visibile
        // poi nascosto.
        root.classList.add("js");
        document.addEventListener("astro:after-swap", mark);
      })();
    </script>

    <ViewTransitions />
  </head>

  <!-- Horizontal clipping lives in global.css (`body`), not an
       `overflow-x-hidden` utility: `hidden` forces overflow-y to compute to
       `auto`, which turns <body> into a scroll container and breaks
       ScrollTrigger's fixed-position pinning (the horizontal gallery) in
       Safari. `clip` clips without creating a scroll container. -->
  <body class="bg-wtc-black text-wtc-white font-inter antialiased">
    <!-- Skip to content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[9999] focus:px-4 focus:py-2 focus:bg-wtc-orange focus:text-wtc-black focus:rounded"
    >
      Vai al contenuto
    </a>

    <!-- Ambient background — subtle drifting glow + film grain that
         de-flattens the large dark surfaces (near-threshold: you only
         notice it when it's gone) -->
    <div
      class="fixed inset-0 pointer-events-none z-0 overflow-hidden"
      aria-hidden="true"
    >
      <div class="ambient-orb"></div>
      <div class="grain-overlay"></div>
    </div>

    <!-- Page transition overlay.
         transition:persist tiene VIVO questo stesso nodo attraverso gli swap:
         MotionRuntime cattura `overlay` una sola volta (lo script non ri-esegue
         dopo la prima navigazione), quindi senza persist il riferimento puntava
         al nodo vecchio scartato e la transizione brandizzata era morta dalla
         seconda navigazione in poi. -->
    <div
      id="page-transition"
      transition:persist
      aria-hidden="true"
      class="fixed inset-0 z-[9998] bg-wtc-black opacity-0 pointer-events-none flex items-center justify-center"
    >
      <img
        src="/images/logos/wtc-logo-white.png"
        alt=""
        width="800"
        height="212"
        class="h-16 w-auto object-contain opacity-0 page-transition-logo"
      />
    </div>

    <slot />

    {motion && <MotionRuntime />}
  </body>
</html>
