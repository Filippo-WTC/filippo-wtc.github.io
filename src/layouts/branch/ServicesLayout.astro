---
import BranchLayout from '../BranchLayout.astro';
import LocalNav from '../../components/global/LocalNav.astro';
import { getBranch } from '../../data/navigation';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  structuredData?: object[];
}

const {
  title,
  description,
  // Social cards are typically light-background, so this uses the original
  // black+orange flagship (not wtc-logo-white.png, which is for the dark on-site UI).
  ogImage = '/images/logos/wtc-logo.png',
  structuredData,
} = Astro.props;
const branch = getBranch('services');
---

<BranchLayout {branch} {title} {description} {ogImage} {structuredData}>
  <LocalNav items={branch.localNav} currentPath={Astro.url.pathname} />
  <slot />
</BranchLayout>
